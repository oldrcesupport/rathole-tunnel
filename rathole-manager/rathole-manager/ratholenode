kv_set(){ # $1=file $2=key $3=val
  safe_kv_set "$1" "$2" "$3"
}

# entekhab port lvkal azad baraye kcp-client hai mkhtlf (main=29900, upstreamha az 29901)
pick_kcp_local(){
  local used p
  used="$(grep -hoE '^KCP_LOCAL=127\.0\.0\.1:[0-9]+' "$ENV_FILE" "$UP_DIR"/*.env 2>/dev/null | sed 's/.*://')"
  p=29901
  while echo "$used" | grep -qx "$p"; do p=$((p+1)); done
  echo "127.0.0.1:$p"
}

up_kcp_unit(){ is_valid_upstream_id "$1" || die "id namotabar baraye path ($1)"; echo "${SYSTEMD_SYSTEM_DIR:-/etc/systemd/system}/rathole-kcp-up-$1.service"; }

gen_up_kcp_unit(){ # $1=id $2=remote $3=local $4=key $5=ds $6=ps $7=mode $8=sw $9=rw
  local id="$1" remote="$2" local_ep="$3" key="$4" ds="$5" ps="$6" mode="$7" sw="$8" rw="$9"
  is_valid_upstream_id "$id" || die "id namotabar: $id"
  validate_endpoint "$remote" || die "remote endpoint namotabar: $remote"
  validate_endpoint "$local_ep" || die "local endpoint namotabar: $local_ep"
  validate_kcp_key "$key" || die "kcp key namotabar"
  local unit; unit="$(up_kcp_unit "$id")"
  local udir; udir="$(dirname "$unit")"
  mkdir -p "$udir"
  local tmp; tmp="$(mktemp "$udir/.up_kcp.XXXXXX" 2>/dev/null)" || { err "sakht-e temp file baraye unit shekast khord"; return 1; }
  chmod 644 "$tmp" 2>/dev/null || true
  cat > "$tmp" <<UNIT
[Unit]
Description=rathole kcp-client upstream ${id} (local TCP -> UDP+FEC)
After=network.target

[Service]
Type=simple
ExecStart=${KCP_CLI_BIN} -r "${remote}" -l "${local_ep}" -key "${key}" -crypt aes-128 -mode "${mode}" -mtu 1350 -sndwnd ${sw} -rcvwnd ${rw} -datashard ${ds} -parityshard ${ps} -dscp 46 -nocomp
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
UNIT
  mv -f "$tmp" "$unit" || { rm -f "$tmp"; err "jaye gozini-e unit shekast khord."; return 1; }
  chmod 644 "$unit" 2>/dev/null || true
  return 0
}

up_kcp_on(){ # $1=id $2=remote $3=key [profile]
  local id="$1" remote="$2" key="$3" profile="${4:-balanced}" params ds ps mode sw rw local_ep
  is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
  [ -n "$remote" ] && [ -n "$key" ] || die "estefade: ratholenode upstream kcp <id> on <iran_ip:udp_port> <key> [profile]"
  validate_endpoint "$remote" || die "adres bayad IP:PORT bashad: $remote"
  validate_kcp_key "$key" || die "kcp key namotabar ast."
  params="$(kcp_profile "$profile")" || die "profile namotabar: $profile (balanced|lossy|aggressive)"
  read -r ds ps mode sw rw <<<"$params"
  # port lvkal mojood ra ngh dar, vagarna iki azad begir
  local_ep="$(grep -oE '^KCP_LOCAL=127\.0\.0\.1:[0-9]+' "$(up_env "$id")" 2>/dev/null | cut -d= -f2)"
  [ -n "$local_ep" ] || local_ep="$(pick_kcp_local)"
  install_kcptun_client

  local env_f; env_f="$(up_env "$id")"
  local toml_f; toml_f="$(up_toml "$id")"
  local unit_f; unit_f="$(up_kcp_unit "$id")"
  local env_bak="" toml_bak="" unit_bak="" had_unit=0
  if [ -f "$env_f" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$env_f" "$env_bak" || return 1; fi
  if [ -f "$toml_f" ]; then toml_bak="$(rth_mktemp)" || return 1; cp -a "$toml_f" "$toml_bak" || return 1; fi
  if [ -f "$unit_f" ]; then unit_bak="$(rth_mktemp)" || return 1; cp -a "$unit_f" "$unit_bak" || return 1; had_unit=1; fi

  _up_kcp_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$env_f" 2>/dev/null || true
    [ -n "$toml_bak" ] && [ -f "$toml_bak" ] && cp -a "$toml_bak" "$toml_f" 2>/dev/null || true
    if [ "$had_unit" -eq 1 ] && [ -n "$unit_bak" ] && [ -f "$unit_bak" ]; then
      cp -a "$unit_bak" "$unit_f" 2>/dev/null || true
    else
      systemctl stop "rathole-kcp-up-${id}" 2>/dev/null || true
      systemctl disable "rathole-kcp-up-${id}" 2>/dev/null || true
      rm -f "$unit_f" 2>/dev/null || true
    fi
    systemctl daemon-reload 2>/dev/null || true
    rm -f "$env_bak" "$toml_bak" "$unit_bak" 2>/dev/null || true
    up_restart "$id" 2>/dev/null || true
  }

  if ! gen_up_kcp_unit "$id" "$remote" "$local_ep" "$key" "$ds" "$ps" "$mode" "$sw" "$rw"; then
    _up_kcp_rollback
    err "sakht-e unit-e kcp upstream shekast khord"
    return 1
  fi
  if ! systemctl daemon-reload; then
    _up_kcp_rollback
    err "daemon-reload shekast khord"
    return 1
  fi
  if ! systemctl enable "rathole-kcp-up-${id}" >/dev/null 2>&1; then
    _up_kcp_rollback
    err "enable-e rathole-kcp-up-${id} shekast khord"
    return 1
  fi
  if ! systemctl restart "rathole-kcp-up-${id}" 2>/dev/null || ! systemctl is-active --quiet "rathole-kcp-up-${id}"; then
    _up_kcp_rollback
    err "rathole-kcp-up-${id} bala niamd ya restart shekast khord; log: journalctl -u rathole-kcp-up-${id} -n 30"
    return 1
  fi
  log "kcp upstream '$id' faal shod: $local_ep → UDP $remote (profile: $profile)."

  kv_set "$env_f" TUNNEL kcp
  kv_set "$env_f" KCP_LOCAL "$local_ep"
  kv_set "$env_f" KCP_REMOTE "$remote"
  kv_set "$env_f" KCP_PROFILE "$profile"
  if ! up_restart "$id"; then
    _up_kcp_rollback
    err "up_restart baraye '$id' shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$toml_bak" "$unit_bak" 2>/dev/null || true
  log "upstream '$id' be masir kcp/UDP+FEC switch shod."
}

up_kcp_off(){ # $1=id
  local id="$1"
