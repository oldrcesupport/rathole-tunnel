  gen_up_client "$id"
  systemctl enable "rathole-client@${id}" >/dev/null 2>&1 || true
  if systemctl restart "rathole-client@${id}" 2>/dev/null && systemctl is-active --quiet "rathole-client@${id}"; then
    log "rathole-client@${id} restart shod."
  else
    err "restart rathole-client@${id} shekast khord; log: journalctl -u rathole-client@${id} -n 30 --no-pager"
    return 1
  fi
}

cmd_upstream(){
  need_root
  local sub="${1:-}"; shift || true
  mkdir -p "$UP_DIR"
  case "$sub" in
    add)
      local id="${1:-}" server="${2:-}" host="${3:-}"
      [ -n "$id" ] && [ -n "$server" ] || die "estefade: ratholenode upstream add <id> <server:port> [hostname]"
      is_valid_upstream_id "$id" || die "id namotabar."
      validate_endpoint "$server" || die "server namotabar (bayad host:port bashad)."
      if [ -n "$host" ]; then
        validate_hostname "$host" || die "hostname namotabar."
      else
        host="${server%%:*}"
      fi
      [ -f "$(up_env "$id")" ] && die "upstream '$id' ghablan vojood darad."
      local tmp; tmp="$(mktemp "$UP_DIR/.env.XXXXXX" 2>/dev/null || mktemp)"
      chmod 600 "$tmp" 2>/dev/null || true
      printf 'SERVER=%s\nHOST=%s\nTUNNEL=ws\n' "$server" "$host" > "$tmp"
      mv -f "$tmp" "$(up_env "$id")"
      touch "$(up_svc "$id")"; chmod 600 "$(up_env "$id")" "$(up_svc "$id")"
      log "upstream '$id' → $server ezafe shod. hala: ratholenode upstream add-svc $id <name> <token> <inbound>"
      ;;
    add-svc)
      local id="${1:-}" name="${2:-}" token="${3:-}" inbound="${4:-}"
      is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      [ -n "$name" ] && [ -n "$token" ] && [ -n "$inbound" ] || die "estefade: ratholenode upstream add-svc <id> <name> <token> <inbound>"
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist (aval: ratholenode upstream add $id <server>)."
      valid_svc_name "$name" || die "name namotabar (faghat harf/adad/khttirh)."
      valid_svc_token "$token" || die "token namotabar (faghat [A-Za-z0-9._=+/-] mjaz ast)."
      is_valid_port "$inbound" || die "port bayad adad bein 1 ta 65535 bashad: $inbound"
      check_port_conflict "$inbound" "upstream '$id' service '$name'" || die "tadakhol port — meghdar digari entekhab kon."
      safe_svc_del "$(up_svc "$id")" "$name"
      echo "${name}|${token}|${inbound}" >> "$(up_svc "$id")"
      log "service '$name' be upstream '$id' ezafe shod."
      up_apply "$id"
      ;;
    rm-svc)
      local id="${1:-}" name="${2:-}"
      is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      [ -n "$name" ] || die "estefade: ratholenode upstream rm-svc <id> <name>"
      valid_svc_name "$name" || die "name namotabar."
      safe_svc_del "$(up_svc "$id")" "$name"
      up_apply "$id"; log "service '$name' az upstream '$id' hazf shod."
      ;;
    rm)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      systemctl disable --now "rathole-client@${id}" 2>/dev/null || true
      systemctl disable --now "rathole-kcp-up-${id}" 2>/dev/null || true
      rm -f "$(up_kcp_unit "$id")"; systemctl daemon-reload 2>/dev/null || true
      rm -f "$(up_env "$id")" "$(up_svc "$id")" "$(up_toml "$id")"
      log "upstream '$id' hazf shod."
      ;;
    apply)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      up_apply "$id" ;;
    restart)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      up_restart "$id" ;;
    kcp)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      shift || true
      local act="${1:-status}"; shift || true
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist (aval: ratholenode upstream add $id <server>)."
      case "$act" in
        on)     up_kcp_on "$id" "${1:-}" "${2:-}" "${3:-}" ;;
        off)    up_kcp_off "$id" ;;
        status) up_kcp_status "$id" ;;
        *) die "estefade: ratholenode upstream kcp <id> <on <ip:port> <key> [profile]|off|status>" ;;
      esac ;;
    plain)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      shift || true
      local act="${1:-status}"; shift || true
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist (aval: ratholenode upstream add $id <server>)."
      case "$act" in
        on)     up_plain_on "$id" "${1:-}" ;;
        off)    up_ws_on "$id" ;;
        status) up_kcp_status "$id" ;;
        *) die "estefade: ratholenode upstream plain <id> <on <host:port>|off|status>" ;;
      esac ;;
    noise)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      shift || true
      local act="${1:-status}"; shift || true
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist (aval: ratholenode upstream add $id <server>)."
      case "$act" in
        on)     up_noise_on "$id" "${1:-}" "${2:-}" "${3:-}" ;;
        off)    up_ws_on "$id" ;;
        status) up_kcp_status "$id" ;;
        *) die "estefade: ratholenode upstream noise <id> <on <host:port> <pubkey> [pattern]|off|status>" ;;
      esac ;;
    ws)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist."
      up_ws_on "$id" ;;
    status)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist."
      up_kcp_status "$id" ;;
    logs)
      local id="${1:-}"; is_valid_upstream_id "$id" || die "id upstream namotabar ast: $id"
      [ -f "$(up_env "$id")" ] || die "upstream '$id' nist."
      up_logs "$id" "${2:-40}" ;;
    ls)
      local mt; mt="$(grep -oE '^TUNNEL=.*' "$ENV_FILE" 2>/dev/null | cut -d= -f2)"; mt="${mt:-ws}"
      echo "$(c_g 'tunnel asli (main):') $(grep -E '^SERVER=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)  [tunnel=$mt]"
      local e id t
      for e in "$UP_DIR"/*.env; do
        [ -f "$e" ] || continue
        id="$(basename "$e" .env)"
        t="$(grep -oE '^TUNNEL=.*' "$e" | cut -d= -f2)"; t="${t:-ws}"
        echo "$(c_g "upstream '$id':") $(grep -E '^SERVER=' "$e" | cut -d= -f2-)  [tunnel=$t]"
        [ -f "$(up_svc "$id")" ] && sed -E 's/\|[^|]*\|/|***|/' "$(up_svc "$id")" | sed 's/^/    /'
      done ;;
    *) die "estefade: ratholenode upstream <add|add-svc|rm-svc|rm|apply|restart|kcp|plain|noise|ws|status|logs|ls> ..." ;;
  esac
}

# ---------- watchdog: restart khodkar tunnel gir-karde/ghat-shode ----------
WD_SVC=/etc/systemd/system/rathole-watchdog.service
WD_TIMER=/etc/systemd/system/rathole-watchdog.timer
WD_ENV=/etc/rathole/watchdog.env

cmd_watchdog(){
  need_root
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)   wd_on "${1:-60}" ;;
    off)  wd_off ;;
    status) wd_status ;;
    run)  wd_run ;;
    *) die "estefade: ratholenode watchdog <on [interval_sec]|off|status>" ;;
  esac
}

wd_on(){
  local interval="${1:-60}"
  echo "$interval" | grep -qE '^[0-9]+$' || die "baze bayad adad (sanie) bashad."
  local edir; edir="$(dirname "$WD_ENV")"
  mkdir -p "$edir"
  local etmp; etmp="$(mktemp "$edir/.wd_env.XXXXXX" 2>/dev/null || mktemp)"
  chmod 600 "$etmp" 2>/dev/null || true
  printf 'INTERVAL=%s\nWD_WINDOW=%s\nWD_FAILS=%s\n' "$interval" "${WD_WINDOW:-75}" "${WD_FAILS:-8}" > "$etmp"
  mv -f "$etmp" "$WD_ENV" || { rm -f "$etmp"; die "zakhire-ye watchdog.env shekast khord."; }
  chmod 600 "$WD_ENV" 2>/dev/null || true

  local udir; udir="$(dirname "$WD_SVC")"
  mkdir -p "$udir"
  local stmp; stmp="$(mktemp "$udir/.wd_svc.XXXXXX" 2>/dev/null || mktemp)"
  chmod 644 "$stmp" 2>/dev/null || true
  cat > "$stmp" <<UNIT
[Unit]
Description=rathole watchdog (auto-restart stuck tunnels)
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-$WD_ENV
ExecStart=/usr/local/bin/ratholenode watchdog run
UNIT
  mv -f "$stmp" "$WD_SVC" || { rm -f "$stmp"; die "zakhire-ye watchdog.service shekast khord."; }
  chmod 644 "$WD_SVC" 2>/dev/null || true

  local ttmp; ttmp="$(mktemp "$udir/.wd_tmr.XXXXXX" 2>/dev/null || mktemp)"
  chmod 644 "$ttmp" 2>/dev/null || true
  cat > "$ttmp" <<UNIT
[Unit]
Description=rathole watchdog timer

[Timer]
OnBootSec=60
OnUnitActiveSec=${interval}
AccuracySec=5s

[Install]
WantedBy=timers.target
UNIT
  mv -f "$ttmp" "$WD_TIMER" || { rm -f "$ttmp"; die "zakhire-ye watchdog.timer shekast khord."; }
  chmod 644 "$WD_TIMER" 2>/dev/null || true

  systemctl daemon-reload || return 1
  if systemctl enable --now rathole-watchdog.timer 2>/dev/null && systemctl is-active --quiet rathole-watchdog.timer; then
    log "watchdog roshan shod (har ${interval}s check mikonad va tunnel gir-karde ra restart mikonad)."
  else
    err "enable/start rathole-watchdog.timer shekast khord; log: journalctl -u rathole-watchdog.timer -n 30 --no-pager"
    return 1
  fi
}

wd_off(){
  systemctl disable --now rathole-watchdog.timer 2>/dev/null || true
  rm -f "$WD_SVC" "$WD_TIMER"; systemctl daemon-reload 2>/dev/null || true
  log "watchdog khamoosh shod."
}

wd_status(){
  if systemctl is-active --quiet rathole-watchdog.timer; then
    echo "watchdog: $(c_g 'roshan')"
    systemctl list-timers rathole-watchdog.timer --no-pager 2>/dev/null | sed -n '1,3p' || true
  else echo "watchdog: $(c_y 'khamoosh')"; fi
}

# check yek tunnel: agar service/kcp paiin bashad ya (dar hale-e paiin-boodan) log akhir pr az retry/khata bashad → restart
wd_check_one(){ # $1=rathole-svc  $2=kcp-unit(ekhtiari)  $3=label
  local svc="$1" kcp="$2" label="$3" bad=0 fails svc_up=1
  systemctl is-active --quiet "$svc" || { bad=1; svc_up=0; }
  if [ -n "$kcp" ] && [ -f "/etc/systemd/system/${kcp}.service" ]; then
    systemctl is-active --quiet "$kcp" || bad=1
  fi
  # churn-e retry: agar service down bashad (bad=1) ya dar halat-e faal dar panjere-ye zamani
  # khata-ye retry-ye ziaad dashte va akharin log-ha hamchenan neshan-dahande-ye qati bashand -> bad=1
  if [ "$svc_up" -eq 1 ]; then
    fails="$(journalctl -u "$svc" --since "${WD_WINDOW:-75} seconds ago" 2>/dev/null | grep -icE 'retrying|connection (refused|reset)|broken pipe|timed out|handshake|failed to connect' || true)"
    if [ "${fails:-0}" -ge "${WD_FAILS:-8}" ]; then
      local last_err
      last_err="$(journalctl -u "$svc" -n 3 --no-pager 2>/dev/null | grep -icE 'retrying|connection (refused|reset)|broken pipe|timed out|handshake|failed to connect' || true)"
      [ "${last_err:-0}" -gt 0 ] && bad=1
    fi
  else
    fails="$(journalctl -u "$svc" --since "${WD_WINDOW:-75} seconds ago" 2>/dev/null | grep -icE 'retrying|connection (refused|reset)|broken pipe|timed out|handshake|failed to connect' || true)"
    bad=1
  fi
  if [ "$bad" -eq 1 ]; then
    logger -t rathole-watchdog "restart tunnel '$label' (svc=$svc up=$svc_up fails=$fails)" 2>/dev/null || true
    [ -n "$kcp" ] && [ -f "/etc/systemd/system/${kcp}.service" ] && systemctl restart "$kcp" 2>/dev/null || true
    systemctl restart "$svc" 2>/dev/null || true
    return 1
  fi
  return 0
}

# tashkhis-e vzait-e failover (FAGHAT hoshdar/log): agar main ghat va yek upstream faal bashad,
# in ra dar failover.state sabt va log mikonad. TAVAJOH: in tabe be tanhaii traffic ra jابeja
# NEMIKONAD — har upstream tunnel-e mostaghel be server-e digar ast; jابeja-yi-ye vaghei niaz be
# taghir-e DNS/routing-e samt-e karbar darad ke inja anjam nemishavad. faghat etela-resani ast.
wd_failover(){
  local main_active=0 upstream_id="" up_active=0
  systemctl is-active --quiet "$SVC" && main_active=1
  local e id
  for e in "$UP_DIR"/*.env; do
    [ -f "$e" ] || continue; id="$(basename "$e" .env)"
    if systemctl is-active --quiet "rathole-client@${id}"; then
      upstream_id="$id"; up_active=1; break
    fi
  done
  # vzait ghabli failover ra az file mvght bkhvan
  local failover_state="/etc/rathole/failover.state"
  local current_failover=""; [ -f "$failover_state" ] && current_failover="$(cat "$failover_state")"
  if [ "$main_active" -eq 0 ] && [ "$up_active" -eq 1 ] && [ "$current_failover" != "$upstream_id" ]; then
    logger -t rathole-watchdog "HOSHDAR: main ghat ast; upstream-e faal '$upstream_id' mojood ast (jAbeja-yi-ye traffic dasti/DNS lazem ast)" 2>/dev/null || true
    echo "$upstream_id" > "$failover_state"
  elif [ "$main_active" -eq 1 ] && [ -n "$current_failover" ]; then
    logger -t rathole-watchdog "ETELA: main dobare faal shod (ghablan upstream '$current_failover' faal bood)" 2>/dev/null || true
    rm -f "$failover_state"
  fi
}

wd_run(){
  local main_bad=0 mkcp=""
  [ -f "$KCP_CLI_UNIT" ] && mkcp="rathole-kcp-client"
  wd_check_one "$SVC" "$mkcp" "main" || main_bad=1
  # upstreamha
  local e id
  for e in "$UP_DIR"/*.env; do
    [ -f "$e" ] || continue; id="$(basename "$e" .env)"
    wd_check_one "rathole-client@${id}" "rathole-kcp-up-${id}" "$id"
  done
  # failover agar main ghat va upstream faal bashad
  wd_failover
}

# ---------- backup va restore (node) ----------
cmd_backup(){
  need_root
  local out="${1:-/root/rathole-node-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
  local items=()
  [ -f "$ENV_FILE" ] && items+=("${ENV_FILE#/}")
  [ -f "$SVC_FILE" ] && items+=("${SVC_FILE#/}")
  load_env
  [ -n "${TLS_TRUSTED_ROOT:-}" ] && [ -f "$TLS_TRUSTED_ROOT" ] && items+=("${TLS_TRUSTED_ROOT#/}")
  [ -d "$UP_DIR" ] && items+=("${UP_DIR#/}")
  [ "${#items[@]}" -gt 0 ] || die "chizi baraye backup nist."
  tar -czf "$out" -C / "${items[@]}" 2>/dev/null || die "sakht backup shekast khord."
  log "backup node sakhte shod: $out (node.env + services + upstreams)."
}

cmd_restore(){
  need_root
  local f="${1:-}"
  [ -n "$f" ] && [ -f "$f" ] || die "file backup peyda nashod: $f"
  # MOHEM: file-e restore dakhel-e tar be / bAZ MIKHORAD — file-e mozdar (masir-e motlagh,
  # ../, symlink) mitavanad har file-i rooye system benevisad (unit-e systemd = persistence).
  # haman ghvaye validate_tar_archive-e update.sh inja ham emal mishavad.
  local py=""
  if command -v python3 >/dev/null 2>&1; then py=python3; elif command -v python >/dev/null 2>&1; then py=python; fi
  local validated=0
  if [ -n "$py" ]; then
    if "$py" - "$f" <<'PYEOF'
import sys, tarfile
try:
    with tarfile.open(sys.argv[1], 'r:*') as tf:
        for m in tf.getmembers():
            name = m.name.replace('\\', '/')
            if name.startswith('/') or '..' in name.split('/'):
                sys.exit(1)
            if m.isdev() or m.ischr() or m.isblk() or m.isfifo():
                sys.exit(1)
            if m.issym() or m.islnk():
                t = m.linkname.replace('\\', '/')
                if t.startswith('/') or '..' in t.split('/'):
                    sys.exit(1)
except Exception:
    sys.exit(1)
sys.exit(0)
PYEOF
    then validated=1
    else die "file backup namotabar kharabe shode ya daraye masir/symlink-e khatarnak ast (fail-closed)."
    fi
  else
    # bedoon python: tar -tzf masir-ha ra list mikond; absolute ya .. → rad.
    if tar -tzf "$f" 2>/dev/null | grep -qE '(^/|(^|/)\.\.(/|$))'; then
      die "file backup daraye masir-e motlagh ya .. ast (fail-closed)."
    fi
    validated=1
  fi
  [ "$validated" -eq 1 ] || die "validate shekast khord."
  tar -xzf "$f" -C / 2>/dev/null || die "baz kardan backup shekast khord."
  log "restore shod. baztolid configha va rahandazi..."
  # restart (na hot-reload): backup mumken ast TUNNEL-e motafavet (kcp/plain/noise) dashte
  # bashad va rathole taghir-e transport ra ba hot-reload emal nemikonad — pas restart lazem ast.
  local rc=0
  if [ -f "$SVC_FILE" ]; then
    gen_client && restart_svc || { err "gen/restart-e $SVC baad az restore shekast khord."; rc=1; }
  fi
  # upstreamha
  if [ -d "$UP_DIR" ]; then
    local e id
    for e in "$UP_DIR"/*.env; do [ -f "$e" ] || continue; id="$(basename "$e" .env)"
      up_restart "$id" || { err "restart-e upstream '$id' shekast khord."; rc=1; }
    done
  fi
  if [ "$rc" -eq 0 ]; then
    log "restore node kamel shod."
  else
    err "restore anjam shod vali bazi restart-ha shekast khordand; journalctl -u rathole-client ra bebin."
    return 1
  fi
}

# namayesh naghshe-ye mohajerat hame-ye tunnelha (main + upstreamha) be kcp/FEC
cmd_migrate(){
  load_env
  echo "$(c_g '==== naghshe-ye mohajerat tunnelha be kcp/FEC (estetar UDP/443) ====')"
  local mt; mt="$(grep -oE '^TUNNEL=.*' "$ENV_FILE" 2>/dev/null | cut -d= -f2)"; mt="${mt:-ws}"
  echo
  echo "$(c_y 'tunnel asli (main)') → ${SERVER:-?}   [aknoon: $mt]"
  if [ "$mt" = "kcp" ]; then
    echo "  ✓ az ghabl rooye kcp ast."
  else
    echo "  1) rooye server airane main:  ratholectl kcp on 443 balanced   (KEY ra bardar)"
    echo "  2) hminja rooye node:        ratholenode kcp on ${SERVER%%:*}:443 <KEY> balanced"
  fi
  local e id srv t
  for e in "$UP_DIR"/*.env; do
    [ -f "$e" ] || continue
    id="$(basename "$e" .env)"; srv="$(grep -E '^SERVER=' "$e" | cut -d= -f2-)"
    t="$(grep -oE '^TUNNEL=.*' "$e" | cut -d= -f2)"; t="${t:-ws}"
    echo
    echo "$(c_y "upstream '$id'") → $srv   [aknoon: $t]"
    if [ "$t" = "kcp" ]; then
      echo "  ✓ az ghabl rooye kcp ast."
    else
      echo "  1) rooye server airane '$id':  ratholectl kcp on 443 balanced   (KEY ra bardar)"
      echo "  2) hminja rooye node:        ratholenode upstream kcp $id on ${srv%%:*}:443 <KEY> balanced"
    fi
  done
  echo
  echo "harkodam mostaghel va bargasht-pazir ast:  kcp off   |   upstream kcp <id> off"
  echo "firewall har server Iran:  ufw allow 443/udp"
}

# beroozresani-e kamel az GitHub (akharin Release): install.sh ra migirad va --update mizanad.
# install.sh khodesh naghsh (panel/node/hub) ra tashkhis mide va snapshot + health-check + rollback-e khodkar ra ejra mikonad.
cmd_update(){
  need_root
  command -v curl >/dev/null 2>&1 || die "curl lazem ast (apt install -y curl)."
  local gh="${RATHOLE_GH:-oldrcesupport/rathole-tunnel}" rel="${RATHOLE_RELEASE:-latest}"
  # 'ratholenode update beta' → kanal-e pre-release (releases/latest/download an ra nadide migirad).
  case "${1:-}" in
    beta)
      log "peyda kardan-e akharin noskhe-ye beta..."
      rel="$(resolve_beta_tag "$gh")" || die "hich noskhe-ye beta-i montasher nashode (ya dastresi be GitHub nist)."
      warn "kanal-e BETA: $rel — in noskhe azmayeshi ast va momken ast paydar nabashad."
      ;;
    stable|latest|'') ;;
    v[0-9]*|[0-9]*) rel="$1" ;;   # pin-e sarih: ratholenode update v1.8.0
    *) die "estefade: ratholenode update [beta|stable|vX.Y.Z]" ;;
  esac
  # tag dar URL miayad — etebar-sanji kon (jelogiri az path-traversal/tazrigh dar masir).
  [ "$rel" = "latest" ] || printf '%s' "$rel" | grep -qE '^[0-9A-Za-z._-]+$' \
    || die "tag-e noskhe namotabar: '$rel'."
  local path; if [ "$rel" = "latest" ]; then path="releases/latest/download/install.sh"; else path="releases/download/${rel}/install.sh"; fi
  local mirrors=("" "https://ghproxy.net/" "https://gh-proxy.com/" "https://mirror.ghproxy.com/")
  local tmp m ok=0; tmp="$(mktemp)"
  log "download install.sh az GitHub Release: $gh ($rel)..."
  for m in "${mirrors[@]}"; do
    if curl -fSL --retry 2 --connect-timeout 20 "${m}https://github.com/${gh}/${path}" -o "$tmp" 2>/dev/null; then ok=1; break; fi
    [ -n "$m" ] && warn "in mirror javab nadad, badi..."
  done
  [ "$ok" -eq 1 ] || { rm -f "$tmp"; die "download install.sh az hameye mirror-ha shekast khord (filtering/slug/release ra barresi kon)."; }
  # etebarsanji-e install.sh bar asas-e SHA256SUMS-e hamin release (fail-closed agar manifest
  # dastresi bood va match nakard). mirror-ha cache-e kohne/ghalat midahand; in hadd-e kamel-e
  # sanji ast (emza-e PGP hanooz nist — hamsan-e install.sh).
  local sums_tmp sums_ok=0 expected actual m2
  sums_tmp="$(mktemp)"
  local sums_path; if [ "$rel" = "latest" ]; then sums_path="releases/latest/download/SHA256SUMS"; else sums_path="releases/download/${rel}/SHA256SUMS"; fi
  for m2 in "${mirrors[@]}"; do
    if curl -fsSL --retry 2 --connect-timeout 20 "${m2}https://github.com/${gh}/${sums_path}" -o "$sums_tmp" 2>/dev/null && [ -s "$sums_tmp" ]; then sums_ok=1; break; fi
  done
  if [ "$sums_ok" -eq 1 ]; then
    expected="$(grep -E "[[:space:]](\./)?install\.sh$" "$sums_tmp" 2>/dev/null | awk '{print $1}' | head -n1)"
    if [ -n "$expected" ]; then
      actual="$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')"
      if [ "$actual" != "$expected" ]; then
        rm -f "$tmp" "$sums_tmp"
        die "checksum-e install.sh motabeghat nadarad! Entezar: $expected , mohasebe-shode: $actual (mirror-e kharab/mozdar?)."
      fi
      log "checksum-e install.sh taeed shod."
    else
      warn "install.sh dar SHA256SUMS peyda nashod; bedoon-e checksum edame midaham."
    fi
  else
    warn "daryaft-e SHA256SUMS shekast khord; install.sh bedoon-e etebarsanji ejra mishavad."
  fi
  rm -f "$sums_tmp"
  log "ejra-ye update-e kamel (snapshot + health-check + rollback-e khodkar)..."
  RATHOLE_GH="$gh" RATHOLE_RELEASE="$rel" bash "$tmp" --update
  local rc=$?
  rm -f "$tmp"
  return "$rc"
}

