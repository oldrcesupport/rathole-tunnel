  is_valid_upstream_id "$id" || die "id namotabar: $id"
  [ -f "$(up_env "$id")" ] || die "upstream '$id' vojood nadarad."
  local SERVER="" HOST="" TUNNEL="" KCP_LOCAL="" KCP_REMOTE="" KCP_PROFILE="" PLAIN_REMOTE="" NOISE_REMOTE="" NOISE_PUBKEY="" NOISE_PATTERN="" HEARTBEAT_TIMEOUT="" KCP_HEARTBEAT_TIMEOUT="" toml
  while IFS='=' read -r k v || [ -n "$k" ]; do
    k="$(echo "$k" | tr -d '\r\n ')"
    case "$k" in
      SERVER) SERVER="$v" ;;
      HOST) HOST="$v" ;;
      TUNNEL) TUNNEL="$v" ;;
      KCP_LOCAL) KCP_LOCAL="$v" ;;
      KCP_REMOTE) KCP_REMOTE="$v" ;;
      KCP_PROFILE) KCP_PROFILE="$v" ;;
      PLAIN_REMOTE) PLAIN_REMOTE="$v" ;;
      NOISE_REMOTE) NOISE_REMOTE="$v" ;;
      NOISE_PUBKEY) NOISE_PUBKEY="$v" ;;
      NOISE_PATTERN) NOISE_PATTERN="$v" ;;
      HEARTBEAT_TIMEOUT) HEARTBEAT_TIMEOUT="$v" ;;
      KCP_HEARTBEAT_TIMEOUT) KCP_HEARTBEAT_TIMEOUT="$v" ;;
    esac
  done < "$(up_env "$id")"
  HOST="${HOST:-${SERVER%%:*}}"
  toml="$(up_toml "$id")"
  local mode="${TUNNEL:-ws}" remote tls
  if [ "$mode" = "kcp" ]; then
    remote="${KCP_LOCAL:-127.0.0.1:29901}"; tls="false"
  elif [ "$mode" = "plain" ]; then
    remote="${PLAIN_REMOTE:-$SERVER}"; tls="false"
  elif [ "$mode" = "noise" ]; then
    remote="${NOISE_REMOTE:-$SERVER}"; tls="false"
  else
    remote="${SERVER}"; tls="true"
  fi

  {
    local hbt="${HEARTBEAT_TIMEOUT:-40}"; [ "$mode" = "kcp" ] && hbt="${KCP_HEARTBEAT_TIMEOUT:-90}"
    echo "# tvlid khodkar tvst ratholenode (upstream $id , tunnel=${mode})"
    echo "[client]"
    echo "remote_addr = \"${remote}\""
    echo "retry_interval = 1"
    echo "heartbeat_timeout = ${hbt}"
    echo
    echo "[client.transport]"
    if [ "$mode" = "noise" ]; then
      echo "type = \"noise\""
      echo "[client.transport.noise]"
      echo "pattern = \"${NOISE_PATTERN:-Noise_NK_25519_ChaChaPoly_BLAKE2s}\""
      echo "remote_public_key = \"${NOISE_PUBKEY}\""
    else
      echo "type = \"websocket\""
      echo "[client.transport.websocket]"
      echo "tls = ${tls}"
      if [ "$tls" = "true" ]; then
        echo "[client.transport.tls]"
        echo "hostname = \"${HOST}\""
      fi
    fi
    local emitted_services=0
    if [ -f "$(up_svc "$id")" ]; then
      while IFS='|' read -r name token inbound; do
        [ -n "$name" ] || continue; case "$name" in \#*) continue ;; esac
        token="${token%$'\r'}"; inbound="${inbound%$'\r'}"
        if [ -z "$token" ] || ! echo "$inbound" | grep -qE '^[0-9]+$'; then
          warn "khatt-e namotabar dar up-svc '$id' rad shod (name=$name)."
          continue
        fi
        emitted_services=$((emitted_services + 1))
        echo
        echo "[client.services.${name}]"
        echo "token = \"${token}\""
        echo "local_addr = \"127.0.0.1:${inbound}\""
        echo "type = \"tcp\""
      done < "$(up_svc "$id")"
    fi
    if [ "$emitted_services" -eq 0 ]; then
      echo
      echo "[client.services]"
    fi
  } > "$toml.tmp"
  rth_commit_config "$toml.tmp" "$toml"
}

