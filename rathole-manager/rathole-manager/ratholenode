# masir-e state baraye adaptive
ADAPTIVE_STATE="${ADAPTIVE_STATE:-/etc/rathole/adaptive-state.json}"
ADAPTIVE_ENV="${ADAPTIVE_ENV:-/etc/rathole/adaptive.env}"

# probe TCP (hata agar TLS/WS fail shavad, port-e TCP ra check kon)
# $1=host $2=port  → khoruji: healthy|tcp_timeout|tcp_refused|tcp_failed
adaptive_probe_tcp(){
  local host="$1" port="$2"
  local t0 t1 ms
  t0="$(date +%s%3N 2>/dev/null || echo 0)"
  if timeout 5 bash -c "exec 3<>/dev/tcp/${host}/${port}" 2>/dev/null; then
    # `exec 3>&- 2>/dev/null` (bedoon-e command) HAR DO redirect ra DAEMI mikonad — yaani
    # stderr-e kol-e process ta akhar khafe mishod. group lazem ast: fd 3 baste mishavad
    # vali 2>/dev/null faghat hamin ja eemal mishavad.
    { exec 3>&-; } 2>/dev/null || true
    t1="$(date +%s%3N 2>/dev/null || echo "$t0")"
    ms=$(( t1 - t0 ))
    echo "healthy:${ms}"
    return 0
  fi
  local rc=$?
  t1="$(date +%s%3N 2>/dev/null || echo "$t0")"
  ms=$(( t1 - t0 ))
  if [ "$rc" -eq 124 ]; then echo "tcp_timeout:${ms}"; else echo "tcp_refused:${ms}"; fi
  return 1
}

# probe WebSocket TLS (RFC 6455 handshake)
# $1=dial_host $2=port $3=path [$4=BAYAD khali bashad — az inja estefade nakonid] $5=tls_hostname $6=trusted_root
# → healthy|ws_rejected|ws_timeout|tls_failed
# header-e ezafi (mesl Authorization-e backhaul) az motghayer-e mohiti-e RTH_PROBEHDR mikhanad
# NA az argv: token-e backhaul dar /proc/*/cmdline be hame karbaran-e lokali mikhond (argv) —
# /proc/*/environ faghat baraye saheb-e process (root) khandoni ast.
adaptive_probe_ws_tls(){
  local host="$1" port="${2:-443}" path="${3:-/}" xhdr="${RTH_PROBEHDR:-}"
  local tls_host="${5:-$host}" trust="${6:-}"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "
import sys, os, socket, ssl, time
host = sys.argv[1]
port = int(sys.argv[2])
path = sys.argv[3]
xhdr = os.environ.get('RTH_PROBEHDR', '')
tls_host = sys.argv[5] if len(sys.argv) > 5 and sys.argv[5] else host
cafile = sys.argv[6] if len(sys.argv) > 6 and sys.argv[6] else None

t0 = time.time()
try:
    ctx = ssl.create_default_context(cafile=cafile)
    ctx.check_hostname = True
    s = socket.create_connection((host, port), timeout=6)
    ss = ctx.wrap_socket(s, server_hostname=tls_host)
    req = f'GET {path} HTTP/1.1\r\nHost: {tls_host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n{xhdr}\r\n'
    ss.sendall(req.encode('utf-8'))
    buf = b''
    ss.settimeout(4)
    while b'\r\n\r\n' not in buf and len(buf) < 16384:
        chunk = ss.recv(2048)
        if not chunk:
            break
        buf += chunk
    ms = int((time.time() - t0) * 1000)
    head = buf.split(b'\r\n\r\n')[0].decode('latin1', errors='replace')
    if 'HTTP/1.1 101' in head or 'HTTP/1.0 101' in head:
        print(f'healthy:{ms}')
        sys.exit(0)
    else:
        print(f'ws_rejected:{ms}')
        sys.exit(1)
except ssl.SSLError:
    ms = int((time.time() - t0) * 1000)
    print(f'tls_failed:{ms}')
    sys.exit(1)
except (socket.timeout, TimeoutError):
    ms = int((time.time() - t0) * 1000)
    print(f'ws_timeout:{ms}')
    sys.exit(1)
except Exception:
    ms = int((time.time() - t0) * 1000)
    print(f'tls_failed:{ms}')
    sys.exit(1)
" "$host" "$port" "$path" "" "$tls_host" "$trust"
    return $?
  fi

  local ssl_args=(-connect "${host}:${port}" -servername "$tls_host" -verify_hostname "$tls_host" -verify_return_error -quiet)
  [ -z "$trust" ] || { [ -f "$trust" ] || { echo "tls_failed:0"; return 1; }; ssl_args+=(-CAfile "$trust"); }
  local t0 t1 ms out
  t0="$(date +%s%3N 2>/dev/null || echo 0)"
  out="$(printf 'GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n%s\r\n' \
    "$path" "$tls_host" "${RTH_PROBEHDR:-}" | timeout 8 openssl s_client "${ssl_args[@]}" 2>/dev/null)" || true
  t1="$(date +%s%3N 2>/dev/null || echo "$t0")"; ms=$(( t1 - t0 ))
  if echo "$out" | grep -q 'HTTP/1.1 101'; then echo "healthy:${ms}"; return 0
  elif [ -n "$out" ]; then echo "ws_rejected:${ms}"; return 1
  else echo "tls_failed:${ms}"; return 1; fi
}

# probe WebSocket plain (bedoon TLS, baraye halat plain)
# header-e ezafi az RTH_PROBEHDR (mohiti) — na argv (token dar /proc cmdline nemiayad).
adaptive_probe_ws_plain(){
  local host="$1" port="${2:-8880}" path="${3:-/}"
  local t0 t1 ms out
  t0="$(date +%s%3N 2>/dev/null || echo 0)"
  out="$(printf 'GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n%s\r\n' \
    "$path" "$host" "${RTH_PROBEHDR:-}" | timeout 5 bash -c "
      exec 3<>/dev/tcp/${host}/${port}
      cat >&3
      timeout 3 cat <&3
      exec 3>&-
    " 2>/dev/null)" || {
    t1="$(date +%s%3N 2>/dev/null || echo "$t0")"; ms=$(( t1 - t0 ))
    echo "ws_timeout:${ms}"; return 1
  }
  t1="$(date +%s%3N 2>/dev/null || echo "$t0")"; ms=$(( t1 - t0 ))
  if echo "$out" | grep -q 'HTTP/1.1 101'; then echo "healthy:${ms}"; return 0
  else echo "ws_rejected:${ms}"; return 1; fi
}

# probe KCP (UDP: faqat TCP-level check rooye KCP_LOCAL port)
adaptive_probe_kcp(){
  local kcp_local="${KCP_LOCAL:-127.0.0.1:29900}"
  local h="${kcp_local%%:*}" p="${kcp_local##*:}"
  adaptive_probe_tcp "$h" "$p"
}

# ejra-ye probe-ha va naveshtan state (baraye sandoz bast: mock-pezir)
adaptive_run_probe(){
  load_env
  # TAVAHH: control channel-e rathole hamishe '/' ast va nginx ham WS-upgrade ra rooye '/' route
  # mikonad. pas probe HATMAN bayad be '/' beravad; taen path-e digar (masalan WS_PATH-e ghadimi)
  # fakeweb ra mibinad (na '101') va adaptive ESBHTBAHAN failover mikonad.
  local host="${SERVER%%:*}" port="${SERVER##*:}" mode="${TUNNEL:-ws}"
  local tls_host="${TLS_HOSTNAME:-$host}" tls_trust="${TLS_TRUSTED_ROOT:-}"
  local cls ms result
  local failures=0 recoveries=0 last_switch=0 cooldown_until=0

  if [ -f "$ADAPTIVE_STATE" ]; then
    eval "$(python3 -c "
import json
try:
    d = json.load(open('$ADAPTIVE_STATE'))
    print(f'failures={int(d.get(\"consecutive_failures\", 0))}')
    print(f'recoveries={int(d.get(\"consecutive_recoveries\", 0))}')
    print(f'last_switch={int(d.get(\"last_switch_epoch\", 0))}')
    print(f'cooldown_until={int(d.get(\"cooldown_until_epoch\", 0))}')
except Exception:
    print('failures=0; recoveries=0; last_switch=0; cooldown_until=0')
" 2>/dev/null || echo 'failures=0; recoveries=0; last_switch=0; cooldown_until=0')"
  fi

  case "$mode" in
    ws)   result="$(adaptive_probe_ws_tls "$host" "$port" "/" "" "$tls_host" "$tls_trust" 2>/dev/null)" ;;
    plain)
      # MOHEM: dar halat plain, dial be PLAIN_REMOTE ast (host + port) na SERVER. ghablan
      # host-e SERVER ba port-e PLAIN_REMOTE probe mishod → host-e ghalat → probe hamishe
      # fail → adaptive-e slem be ws barmigasht va tunnel-e slem mishkast.
      local pr="${PLAIN_REMOTE:-$SERVER}"
      result="$(adaptive_probe_ws_plain "${pr%%:*}" "${pr##*:}" "/" 2>/dev/null)" ;;
    kcp)  result="$(adaptive_probe_kcp 2>/dev/null)" ;;
    # backhaul: control channel-e client rooye '/channel' hardcode ast (na '/') va nginx haman
    # masir ra be backhaul-server proxy mikonad — pas probe bayad be '/channel' beravad.
    # token HATMAN lazem ast vagarna backhaul ba 401 rad mikonad. TLS/direct az transport miayad.
    # token az RTH_PROBEHDR (mohiti, faqat baraye farzandan) mipasrad — na argv (ps/proc).
    backhaul)
      local bhr="${BH_REMOTE_ADDR:-${BH_REMOTE:-$host}:443}"
      local bhh="${bhr%%:*}" bhp="${bhr##*:}"
      # CRLF-e entehai ELZAMI ast: printf sartasar %s ba yek \r\n miband va HTTP niaz be
      # \r\n\r\n dar enteha-e header-ha darad.
      RTH_PROBEHDR="Authorization: Bearer ${BH_TOKEN:-}"$'\r\n'
      export RTH_PROBEHDR
      case "${BH_TRANSPORT:-wssmux}" in
        ws|wsmux) result="$(adaptive_probe_ws_plain "$bhh" "$bhp" "/channel" 2>/dev/null)" ;;
        *) result="$(adaptive_probe_ws_tls "$bhh" "$bhp" "/channel" "" 2>/dev/null)" ;;
      esac
      unset RTH_PROBEHDR ;;
    *)    result="healthy:0" ;;
  esac

  cls="${result%%:*}"; ms="${result##*:}"
  local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '')"
  if [ "$cls" = "healthy" ]; then
    failures=0
    recoveries=$(( recoveries + 1 ))
  else
    failures=$(( failures + 1 ))
    recoveries=0
  fi

  # neveshtan state (bedoon secret-ha) ba 0600 mode
  local tmp; tmp="$(rth_mktemp)"
  printf '{"time":"%s","current":"%s","classification":"%s","latency_ms":%s,"consecutive_failures":%d,"consecutive_recoveries":%d,"last_switch_epoch":%d,"cooldown_until_epoch":%d}\n' \
    "$now" "$mode" "$cls" "$ms" "$failures" "$recoveries" "$last_switch" "$cooldown_until" > "$tmp"
  chmod 600 "$tmp"
  mkdir -p "$(dirname "$ADAPTIVE_STATE")"
  mv "$tmp" "$ADAPTIVE_STATE"
  echo "$cls"
}

# agar baraye test source shode, alias darkhast mikonim
adaptive_run_probe_test(){ adaptive_run_probe "$@"; }

# ============ adaptive: controller logic (Task 6) ============

# barre barresi aya switch lazem ast
# $1=current_failures $2=threshold $3=current_recoveries $4=recovery_threshold $5=cooldown_remaining
# → yes|recover|no
adaptive_should_switch(){
  local failures="${1:-0}" threshold="${2:-3}" recoveries="${3:-0}" recovery_threshold="${4:-5}" cooldown_rem="${5:-0}"
  if [ "$cooldown_rem" -gt 0 ]; then echo "no"; return; fi
  if [ "$failures" -ge "$threshold" ]; then echo "yes"; return; fi
  if [ "$recoveries" -ge "$recovery_threshold" ] && [ "$recovery_threshold" -gt 0 ] && [ "$failures" -eq 0 ]; then echo "recover"; return; fi
  echo "no"
}

# plain mojaz ast faqat ba ALLOW_INSECURE=1
adaptive_plain_allowed(){
  local allow="${ALLOW_INSECURE:-0}"
  [ "$allow" = "1" ] && echo "yes" || echo "no"
}

# load tanzimat adaptive
adaptive_load_env(){
  [ -f "$ADAPTIVE_ENV" ] && { set -a; . "$ADAPTIVE_ENV"; set +a; } || true
  ADAPTIVE_ENABLED="${ADAPTIVE_ENABLED:-0}"
  ADAPTIVE_INTERVAL="${ADAPTIVE_INTERVAL:-30}"
  ADAPTIVE_FAILURES="${ADAPTIVE_FAILURES:-3}"
  ADAPTIVE_RECOVERIES="${ADAPTIVE_RECOVERIES:-5}"
  ADAPTIVE_COOLDOWN="${ADAPTIVE_COOLDOWN:-300}"
  ALLOW_INSECURE="${ALLOW_INSECURE:-0}"
}

# dastoor adaptive
cmd_adaptive(){
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)
      need_root
      local interval="${ADAPTIVE_INTERVAL:-30}" failures="${ADAPTIVE_FAILURES:-3}" recoveries="${ADAPTIVE_RECOVERIES:-5}"
      while [ $# -gt 0 ]; do case "$1" in
        --interval)  interval="$2"; shift 2;;
        --failures)  failures="$2"; shift 2;;
        --recoveries) recoveries="$2"; shift 2;;
        *) shift;;
      esac; done
      [[ "$interval" =~ ^[0-9]+$ ]] || die "interval bayad adad bashad."
      [[ "$failures" =~ ^[0-9]+$ ]] || die "failures bayad adad bashad."
      [[ "$recoveries" =~ ^[0-9]+$ ]] || die "recoveries bayad adad bashad."
      local edir; edir="$(dirname "$ADAPTIVE_ENV")"
      mkdir -p "$edir"
      local etmp; etmp="$(mktemp "$edir/.adaptive_env.XXXXXX" 2>/dev/null || mktemp)"
      chmod 600 "$etmp" 2>/dev/null || true
      printf 'ADAPTIVE_ENABLED=1\nADAPTIVE_INTERVAL=%s\nADAPTIVE_FAILURES=%s\nADAPTIVE_RECOVERIES=%s\nADAPTIVE_COOLDOWN=300\nALLOW_INSECURE=0\n' \
        "$interval" "$failures" "$recoveries" > "$etmp"
      mv -f "$etmp" "$ADAPTIVE_ENV" || { rm -f "$etmp"; die "zakhire-ye adaptive.env shekast khord."; }
      chmod 600 "$ADAPTIVE_ENV" 2>/dev/null || true

      # systemd timer (agar mojood bashad)
      if command -v systemctl >/dev/null 2>&1; then
        local udir="/etc/systemd/system"
        mkdir -p "$udir"
        local stmp; stmp="$(mktemp "$udir/.adaptive_svc.XXXXXX" 2>/dev/null || mktemp)"
        chmod 644 "$stmp" 2>/dev/null || true
        cat > "$stmp" <<UNIT
[Unit]
Description=rathole adaptive carrier probe
[Service]
Type=oneshot
ExecStart=/usr/local/bin/ratholenode adaptive run
UNIT
        mv -f "$stmp" "$udir/rathole-adaptive.service" || { rm -f "$stmp"; die "zakhire-ye adaptive.service shekast khord."; }
        chmod 644 "$udir/rathole-adaptive.service" 2>/dev/null || true

        local ttmp; ttmp="$(mktemp "$udir/.adaptive_tmr.XXXXXX" 2>/dev/null || mktemp)"
        chmod 644 "$ttmp" 2>/dev/null || true
        cat > "$ttmp" <<TIMER
[Unit]
Description=rathole adaptive probe timer
[Timer]
OnBootSec=45s
OnUnitActiveSec=${interval}s
RandomizedDelaySec=5s
[Install]
WantedBy=timers.target
TIMER
        mv -f "$ttmp" "$udir/rathole-adaptive.timer" || { rm -f "$ttmp"; die "zakhire-ye adaptive.timer shekast khord."; }
        chmod 644 "$udir/rathole-adaptive.timer" 2>/dev/null || true

        systemctl daemon-reload || return 1
        if ! (systemctl enable --now rathole-adaptive.timer 2>/dev/null && systemctl is-active --quiet rathole-adaptive.timer); then
          err "enable/start rathole-adaptive.timer shekast khord; log: journalctl -u rathole-adaptive.timer -n 30 --no-pager"
          return 1
        fi
      fi
      log "adaptive on shod (interval=${interval}s, failures=${failures}, recoveries=${recoveries})."
      ;;
    off)
      need_root
      if command -v systemctl >/dev/null 2>&1; then
        systemctl disable --now rathole-adaptive.timer 2>/dev/null || true
      fi
      if [ -f "$ADAPTIVE_ENV" ]; then
        safe_kv_set "$ADAPTIVE_ENV" ADAPTIVE_ENABLED 0
      fi
      log "adaptive off shod (mode-e feli hefz shod)."
      ;;
    status)
      adaptive_load_env
      if [ "$ADAPTIVE_ENABLED" = "1" ]; then
        log "adaptive: ROSHAN (interval=${ADAPTIVE_INTERVAL}s, failures=${ADAPTIVE_FAILURES}, recoveries=${ADAPTIVE_RECOVERIES})"
      else
        log "adaptive: KHAMOOSH"
      fi
      if [ -f "$ADAPTIVE_STATE" ]; then
        local cls ms fails recov
        cls="$(python3 -c "import json; d=json.load(open('$ADAPTIVE_STATE')); print(d.get('classification','?'))" 2>/dev/null || echo '?')"
        fails="$(python3 -c "import json; d=json.load(open('$ADAPTIVE_STATE')); print(d.get('consecutive_failures',0))" 2>/dev/null || echo '?')"
        recov="$(python3 -c "import json; d=json.load(open('$ADAPTIVE_STATE')); print(d.get('consecutive_recoveries',0))" 2>/dev/null || echo '?')"
        ms="$(python3 -c "import json; d=json.load(open('$ADAPTIVE_STATE')); print(d.get('latency_ms','?'))" 2>/dev/null || echo '?')"
        log "akharin probe: $cls (latency=${ms}ms, failures=$fails, recoveries=$recov)"
      fi
      ;;
    test)
      local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
      load_env
      adaptive_run_probe 2>/dev/null || true
      if [ "$as_json" -eq 1 ] && [ -f "$ADAPTIVE_STATE" ]; then
        cat "$ADAPTIVE_STATE"
      else
        [ -f "$ADAPTIVE_STATE" ] && python3 -c "
import json
d = json.load(open('$ADAPTIVE_STATE'))
print('classification:', d.get('classification','?'))
print('latency_ms:', d.get('latency_ms','?'))
print('consecutive_failures:', d.get('consecutive_failures','?'))
print('consecutive_recoveries:', d.get('consecutive_recoveries','?'))
" 2>/dev/null || true
      fi
      ;;
    run)
      # ejra-ye controller: switch-e carrier agar lazem bashad
      need_root; adaptive_load_env; load_env
      [ "$ADAPTIVE_ENABLED" = "1" ] || { warn "adaptive khamoosh ast."; exit 0; }
      # flock: faghat yek instance hamzaman
      (
        flock -n 9 || { warn "yek controller-e digar dar hal ejrast."; exit 0; }
        cls="$(adaptive_run_probe 2>/dev/null || echo 'probe_failed')"
        local now_ep
        now_ep="$(date +%s 2>/dev/null || echo 0)"
        local failures=0 recoveries=0 cd_until=0
        eval "$(python3 -c "
import json
try:
    d = json.load(open('$ADAPTIVE_STATE'))
    print(f'failures={int(d.get(\"consecutive_failures\", 0))}')
    print(f'recoveries={int(d.get(\"consecutive_recoveries\", 0))}')
    print(f'cd_until={int(d.get(\"cooldown_until_epoch\", 0))}')
except Exception:
    print('failures=0; recoveries=0; cd_until=0')
" 2>/dev/null || echo 'failures=0; recoveries=0; cd_until=0')"

        local cd_rem=0
        if [ "$cd_until" -gt "$now_ep" ]; then
          cd_rem=$(( cd_until - now_ep ))
        fi

        switch="$(adaptive_should_switch "$failures" "$ADAPTIVE_FAILURES" "$recoveries" "$ADAPTIVE_RECOVERIES" "$cd_rem")"
        if [ "$switch" = "yes" ] || [ "$switch" = "recover" ]; then
          local cur="${TUNNEL:-ws}" next reason
          if [ "$cur" = "backhaul" ]; then
            # MOHEM: backhaul jaygozin-e kamele tunnel ast (na yek carrier-e ws/kcp).
            # switch be ws tunnel-e dovom-e movazi misazad va backhaul-e slem ra migaland.
            warn "adaptive: TUNNEL=backhaul faal ast; adaptive switch be ws/kcp anjam nemishavad (faghat probe/state record mishavad)."
          elif [ "$switch" = "yes" ]; then
            case "$cur" in ws) next=kcp ;; kcp) next=ws ;; *) next=ws ;; esac
            reason="failover (failures=$failures)"
          else
            next=ws
            reason="recovery (recoveries=$recoveries)"
          fi
          if [ "${cur:-ws}" = "backhaul" ]; then
            :  # hich switchi anjam nemishavad
          elif [ "$next" = "kcp" ] && [ -z "${KCP_REMOTE:-}" ]; then
            warn "adaptive: switch be kcp anjam nemishavad chon KCP_REMOTE tanzim nashode ast."
          elif [ "$next" != "$cur" ]; then
            warn "adaptive: switch az '$cur' be '$next' ($reason)"
            env_set TUNNEL "$next"
            if [ "$next" = "kcp" ]; then
              systemctl restart rathole-kcp-client 2>/dev/null || true
            else
              systemctl stop rathole-kcp-client 2>/dev/null || true
            fi
            gen_client
            restart_svc
            local new_cd=$(( now_ep + ADAPTIVE_COOLDOWN ))
            python3 -c "
import json
try:
    d = json.load(open('$ADAPTIVE_STATE'))
    d['last_switch_epoch'] = $now_ep
    d['cooldown_until_epoch'] = $new_cd
    d['last_reason'] = '$reason'
    d['consecutive_failures'] = 0
    d['consecutive_recoveries'] = 0
    with open('$ADAPTIVE_STATE', 'w') as f:
        json.dump(d, f)
except Exception:
    pass
" 2>/dev/null || true
          fi
        fi
      ) 9>/run/rathole-adaptive.lock || true
      ;;
    *) die "estefade: ratholenode adaptive on|off|status|test|run" ;;
  esac
}

main(){
  case "${1:-show}" in
    apply)   cmd_apply ;;
    add-svc) shift; cmd_add_svc "${1:-}" "${2:-}" "${3:-}" ;;
    rm-svc)  shift; cmd_rm_svc "${1:-}" ;;
    ls)      cmd_ls ;;
    set)     shift; cmd_set "${1:-}" "${2:-}" ;;
    set-main) shift; cmd_set_main "${1:-}" "${2:-}" "${3:-}" ;;
    check)   cmd_check ;;
    tune)    cmd_tune ;;
    kcp)     shift; cmd_kcp "$@" ;;
    plain)   shift; cmd_plain "$@" ;;
    noise)   shift; cmd_noise "$@" ;;
    backhaul) shift; cmd_backhaul "$@" ;;
    restart) need_root; restart_svc ;;

    watchdog) shift; cmd_watchdog "$@" ;;
    migrate) cmd_migrate ;;
    fakeweb) shift; cmd_fakeweb "${1:-}" "${2:-}" ;;
    upstream) shift; cmd_upstream "$@" ;;
    backup)  shift; cmd_backup "${1:-}" ;;
    restore) shift; cmd_restore "${1:-}" ;;
    show)    cmd_show ;;
    status)  cmd_status ;;
    update)  shift; cmd_update "${1:-}" ;;
    adaptive) shift; cmd_adaptive "$@" ;;
    logs)    shift
             if [ "${1:-}" = all ]; then shift; cmd_logs_all "$@"; else cmd_logs "${1:-50}"; fi ;;
    version|--version|-V) print_version node ;;
    -h|--help|help) usage ;;
    *) err "dstvr nashenakhte: $1"; usage; exit 1 ;;
  esac
}

# ---------- ghofl-e state (hamsan-e ratholectl) ----------
_rth_init_lock_path() {
  local default_lock="$1"
  if [ "${RATHOLE_TEST_MODE:-0}" = "1" ]; then
    if [ -z "${RTH_TEST_DIR:-}" ]; then
      err "RATHOLE_TEST_MODE=1 ast vali RTH_TEST_DIR tanzim nashodeh ast."
      return 1
    fi
    if [ -n "${RTH_LOCK:-}" ]; then
      case "$RTH_LOCK" in
        "${RTH_TEST_DIR}"* )
          if [[ "$RTH_LOCK" == *".."* ]]; then
            err "RTH_LOCK nabayad shamel .. bashad: $RTH_LOCK"
            return 1
          fi
          ;;
        * )
          err "RTH_LOCK dar test mode bayad zir-e RTH_TEST_DIR ($RTH_TEST_DIR) bashad: $RTH_LOCK"
          return 1
          ;;
      esac
    else
      RTH_LOCK="${RTH_TEST_DIR}/$(basename "$default_lock")"
    fi
  else
    if [ -n "${RTH_LOCK:-}" ]; then
      err "RTH_LOCK az mohit dar halat-e production ghabool nist (fail-closed): $RTH_LOCK"
      return 1
    fi
    RTH_LOCK="$default_lock"
  fi
  return 0
}

rth_with_lock(){
  if ! _rth_init_lock_path "/run/ratholenode.lock"; then
    return 1
  fi

  local lockdir; lockdir="$(dirname "$RTH_LOCK")"
  if [ -L "$lockdir" ]; then
    err "directory-e ghofl yek symlink ast: $lockdir (fail-closed)."
    return 1
  fi
  if [ -L "$RTH_LOCK" ]; then
    err "file-e ghofl yek symlink ast: $RTH_LOCK (fail-closed)."
    return 1
  fi
  if [ -d "$RTH_LOCK" ]; then
    err "file-e ghofl yek directory ast: $RTH_LOCK (fail-closed)."
    return 1
  fi
  if [ -e "$RTH_LOCK" ] && [ ! -f "$RTH_LOCK" ]; then
    err "file-e ghofl yek file-e adi nist: $RTH_LOCK (fail-closed)."
    return 1
  fi

  if ! mkdir -p "$lockdir" 2>/dev/null && [ ! -d "$lockdir" ]; then
    local uid; uid="$(id -u 2>/dev/null || echo 0)"
    local udir="${TMPDIR:-/tmp}/rth-run-${uid}"
    if [ -L "$udir" ]; then
      err "directory-e ghofl-e fallback yek symlink ast: $udir (fail-closed)."
      return 1
    fi
    mkdir -p "$udir" 2>/dev/null && chmod 700 "$udir" 2>/dev/null || true
    if [ -d "$udir" ] && [ -O "$udir" ] && [ ! -L "$udir" ]; then
      RTH_LOCK="${udir}/ratholenode.lock"
      lockdir="$udir"
    else
      err "nemitoonam directory-e ghofl ra besazam: $lockdir (fail-closed)."
      return 1
    fi
  fi

  local timeout_sec="${RTH_LOCK_TIMEOUT:-30}"
  case "$timeout_sec" in
    ''|*[!0-9]*) timeout_sec=30 ;;
    *) [ "$timeout_sec" -gt 0 ] 2>/dev/null || timeout_sec=30 ;;
  esac

  if command -v flock >/dev/null 2>&1; then
    # BEHRANI: baz kardan fd 9 ba >> (append) baraye jelogiri az truncate shodan-e file.
    # agar baz kardan fd 9 shekast bokhorad, bayad FAIL-CLOSED konad.
    if ! { exec 9>>"$RTH_LOCK"; } 2>/dev/null; then
      err "baz kardan-e file-e ghofl shekast khord: $RTH_LOCK; amaliat baraye jelogiri az race condition motavaghef shod."
      return 1
    fi
    if [ -L "$RTH_LOCK" ]; then
      err "file-e ghofl pas az baz kardan symlink tashkhis dadeh shod: $RTH_LOCK (fail-closed)."
      exec 9>&-
      return 1
    fi
    if ! flock -w "$timeout_sec" 9; then
      err "ghofl-e state azad nashod (flock timeout ${timeout_sec}s); amaliat baraye jelogiri az race condition motavaghef shod."
      exec 9>&-
      return 1
    fi
    RTH_LOCK_HELD=1
    local rc=0
    "$@" || rc=$?
    RTH_LOCK_HELD=0
    exec 9>&-
    return $rc
  fi

  local d="${RTH_LOCK}.d" i=0 held=0
  local max_tries=$((timeout_sec * 10))
  [ "$max_tries" -ge 1 ] 2>/dev/null || max_tries=1
  while [ "$i" -lt "$max_tries" ]; do
    if mkdir "$d" 2>/dev/null; then held=1; break; fi
    i=$((i+1)); sleep 0.1 2>/dev/null || sleep 1
  done
  if [ "$held" -ne 1 ]; then
    err "ghofl-e state azad nashod (mkdir timeout ${timeout_sec}s); amaliat baraye jelogiri az race condition motavaghef shod."
    return 1
  fi
  RTH_LOCK_HELD=1
  local rc=0
  "$@" || rc=$?
  RTH_LOCK_HELD=0
  rmdir "$d" 2>/dev/null
  return $rc
}

if [ "${RATHOLENODE_LIB_ONLY:-0}" != 1 ]; then rth_with_lock main "$@"; fi
