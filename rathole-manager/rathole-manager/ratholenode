#!/usr/bin/env bash
# ratholenode — mdirit klaint rathole rooye node kharej (chnd service rooye yek tunnel)
# tanzimat paih: /etc/rathole/node.env   (SERVER, RATHOLE_VERSION)
# list serviceha: /etc/rathole/services.conf  (har kht: name|token|inbound_port)
# hame-ye serviceha zir yek [client] gharar migirand → yek channel kontroli (yek tunnel).
# nokte: amdan az `set -e` estefade nmiknim (dalil moshabeh ratholectl).
set -uo pipefail
umask 077

# common.sh agar knar file bashd, tavabe eshteraki ra lvd kon
# baad az nasb: script dar /usr/local/bin vali common.sh dar /usr/local/share/rathole ast
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || echo "$PWD")"
if [ "$SCRIPT_DIR" != "/usr/local/bin" ] && [ -f "$SCRIPT_DIR/common.sh" ]; then
  source "$SCRIPT_DIR/common.sh"
elif [ -f /usr/local/share/rathole/common.sh ]; then
  source /usr/local/share/rathole/common.sh
elif [ -f "$SCRIPT_DIR/common.sh" ]; then
  source "$SCRIPT_DIR/common.sh"
fi

# Temp-ha ba permission amniate (0600 file va 0700 dir)
rth_mktemp(){
  local f
  f="$(mktemp "$@")" || return 1
  chmod 0600 "$f" 2>/dev/null || true
  printf '%s\n' "$f"
}
rth_mktempd(){
  local d
  d="$(mktemp -d "$@")" || return 1
  chmod 0700 "$d" 2>/dev/null || true
  printf '%s\n' "$d"
}

# Etebarsanji-ye motahed baraye upstream ID, endpoint, hostname va kcp key
is_valid_upstream_id(){
  local id="${1:-}"
  [ -n "$id" ] || return 1
  [ "$id" = "." ] && return 1
  [ "$id" = ".." ] && return 1
  [ "$id" = "main" ] && return 1
  case "$id" in
    *[!A-Za-z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

validate_endpoint(){
  local ep="${1:-}"
  [ -n "$ep" ] || return 1
  case "$ep" in
    *$'\n'*|*$'\r'*|*[[:space:]]*|*[\;\|\&\`\$\<\>\(\)\'\"\\]*) return 1 ;;
  esac
  local ep_re='^([a-zA-Z0-9.-]+):([0-9]{1,5})$'
  if [[ "$ep" =~ $ep_re ]]; then
    local h="${BASH_REMATCH[1]}"
    local p="${BASH_REMATCH[2]}"
    is_valid_port "$p" || return 1
    local re_start='^[a-zA-Z0-9]'
    local re_end='[a-zA-Z0-9]$'
    [[ "$h" =~ $re_start ]] && [[ "$h" =~ $re_end ]] || return 1
    return 0
  fi
  return 1
}

validate_hostname(){
  local h="${1:-}"
  [ -n "$h" ] || return 1
  case "$h" in
    *$'\n'*|*$'\r'*|*[[:space:]]*|*[\;\|\&\`\$\<\>\(\)\'\"\\]*) return 1 ;;
  esac
  local re='^[a-zA-Z0-9.-]+$'
  [[ "$h" =~ $re ]] || return 1
  local re_start='^[a-zA-Z0-9]'
  local re_end='[a-zA-Z0-9]$'
  [[ "$h" =~ $re_start ]] && [[ "$h" =~ $re_end ]] || return 1
  return 0
}

validate_kcp_key(){
  local k="${1:-}"
  [ -n "$k" ] || return 1
  # footgun-e shayea: argoman-e profile be jay-e key (kcp on IP:PORT balanced). kcptun har
  # string-i ra mipazirad → key-e "balanced" rooye node ba KEY-e hex-e Iran MATCH nemishavad
  # va tunnel BI-SEDA mishkanad. in khatay-e mashhor rad mishavad; key-e gheyr-hex ham hoshdar midahad.
  case "$k" in
    balanced|lossy|aggressive) err "kcp key namotabar: '$k' profile ast na key. tartib: kcp on <ip:port> <KEY> [profile]" ; return 1 ;;
  esac
  case "$k" in
    *$'\n'*|*$'\r'*|*[\;\|\&\`\$\<\>\(\)\'\"\\]*) return 1 ;;
  esac
  local re='^[-A-Za-z0-9._=+/ ]+$'
  [[ "$k" =~ $re ]] || return 1
  return 0
}

# Tavabe amn baraye taghir va hazf dar file-haye env va conf
safe_kv_set(){
  local file="$1" key="$2" val="$3"
  [ -n "$file" ] && [ -n "$key" ] || return 1
  if ! echo "$key" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'; then
    err "safe_kv_set: kelid namotabar ast: $key"
    return 1
  fi
  case "$val" in
    *$'\n'*|*$'\r'*)
      err "safe_kv_set: meghdar nabayad shamel-e khat-e jadid bashad"
      return 1
      ;;
  esac
  local dir; dir="$(dirname "$file")"
  mkdir -p "$dir" 2>/dev/null || true
  local tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || return 1
  chmod 0600 "$tmp" 2>/dev/null || true

  if [ -f "$file" ]; then
    SAFE_KEY="$key" SAFE_VAL="$val" awk '
      BEGIN {
        k = ENVIRON["SAFE_KEY"]
        v = ENVIRON["SAFE_VAL"]
        found = 0
      }
      {
        if (index($0, k "=") == 1) {
          if (!found) {
            print k "=" v
            found = 1
          }
        } else {
          print $0
        }
      }
      END {
        if (!found) {
          print k "=" v
        }
      }
    ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  else
    printf '%s=%s\n' "$key" "$val" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi

  local written
  written="$(grep -E "^${key}=" "$tmp" 2>/dev/null | head -n1)"
  if [ "$written" != "${key}=${val}" ]; then
    rm -f "$tmp"
    err "safe_kv_set: etebarsanji pas az neveshtan shekast khord"
    return 1
  fi

  mv "$tmp" "$file" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$file" 2>/dev/null || true
  return 0
}

safe_kv_del(){
  local file="$1"; shift
  [ -f "$file" ] || return 0
  [ $# -gt 0 ] || return 0
  local k
  for k in "$@"; do
    if ! echo "$k" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'; then
      err "safe_kv_del: kelid namotabar ast: $k"
      return 1
    fi
  done

  local tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || return 1
  chmod 0600 "$tmp" 2>/dev/null || true

  local del_keys="$*"
  DEL_KEYS="$del_keys" awk '
    BEGIN {
      split(ENVIRON["DEL_KEYS"], arr, " ")
      for (i in arr) {
        del[arr[i]] = 1
      }
    }
    {
      eq = index($0, "=")
      if (eq > 1) {
        k = substr($0, 1, eq - 1)
        if (k in del) next
      }
      print $0
    }
  ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }

  mv "$tmp" "$file" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$file" 2>/dev/null || true
  return 0
}

safe_svc_del(){
  local file="$1" name="$2"
  [ -f "$file" ] || return 0
  [ -n "$name" ] || return 1
  case "$name" in
    *$'\n'*|*$'\r'*|*'|'*)
      err "safe_svc_del: name-e service namotabar ast"
      return 1
      ;;
  esac

  local tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX" 2>/dev/null)" || return 1
  chmod 0600 "$tmp" 2>/dev/null || true

  TARGET_NAME="$name" awk -F'|' '
    BEGIN { target = ENVIRON["TARGET_NAME"] }
    {
      if ($1 == target) next;
      print $0;
    }
  ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }

  mv "$tmp" "$file" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$file" 2>/dev/null || true
  return 0
}

if [ "${RATHOLE_TEST_MODE:-0}" = "1" ] && [ -n "${RTH_TEST_DIR:-}" ]; then
  ENV_FILE="${ENV_FILE:-$RTH_TEST_DIR/etc/rathole/node.env}"
  SVC_FILE="${SVC_FILE:-$RTH_TEST_DIR/etc/rathole/services.conf}"
  CLIENT_TOML="${CLIENT_TOML:-$RTH_TEST_DIR/etc/rathole/client.toml}"
  KCP_CLI_UNIT="${KCP_CLI_UNIT:-$RTH_TEST_DIR/etc/systemd/system/rathole-kcp-client.service}"
  SYSTEMD_SYSTEM_DIR="${SYSTEMD_SYSTEM_DIR:-$RTH_TEST_DIR/etc/systemd/system}"
  UP_DIR="${UP_DIR:-$RTH_TEST_DIR/etc/rathole/upstreams}"
  UP_TOML_DIR="${UP_TOML_DIR:-$RTH_TEST_DIR/etc/rathole}"
else
  ENV_FILE="${ENV_FILE:-/etc/rathole/node.env}"
  SVC_FILE="${SVC_FILE:-/etc/rathole/services.conf}"
  CLIENT_TOML="${CLIENT_TOML:-/etc/rathole/client.toml}"
  KCP_CLI_UNIT="${KCP_CLI_UNIT:-/etc/systemd/system/rathole-kcp-client.service}"
  SYSTEMD_SYSTEM_DIR="${SYSTEMD_SYSTEM_DIR:-/etc/systemd/system}"
  UP_DIR="${UP_DIR:-/etc/rathole/upstreams}"
  UP_TOML_DIR="${UP_TOML_DIR:-/etc/rathole}"
fi
SVC="rathole-client"

# TAVAJOH: c_g/c_r/c_y/log/warn/err/die/need_root/kcp_profile inja DOBARE tarif NEMISHAVAND —
# tanha manba-eshan common.sh ast (bala source shod). ghablan har se file copy dashtand va chon
# source ghabl az tarif bood، copy-e CLI barande mishod: virayesh-e common.sh BI-ASAR bood.
# baraye kcp_profile in fajee ast — profile bayad DO taraf (Iran va node) yeksan bashad.
# common.sh EJBARI ast (rth_commit_config / install_backhaul / backhaul_mux_profile faghat anja
# hastand)، pas agar load nashode bashad hamin ja ba payam-e roshan mimirim.
if ! declare -F rth_commit_config >/dev/null 2>&1; then
  printf '[!] common.sh load nashod (/usr/local/share/rathole/common.sh). nasb ra tekrar kon.\n' >&2
  exit 1
fi

load_env(){ [ -f "$ENV_FILE" ] || die "node.env peyda nshd; aval install-node.sh ra ejra kon."; set -a; . "$ENV_FILE"; set +a; }

# barresi tadakhol port inbound ba nginx node + sair servicehaye tunnel
check_inbound(){
  local port="$1" label="$2" owner
  if [ "$port" = "80" ] || [ "$port" = "443" ]; then
    warn "$label rooye port $port ast ke maamoolan motaaleq be nginx node ast — ehtemal tadakhol."
  fi
  if command -v ss >/dev/null 2>&1; then
    owner="$(ss -ltnpH "sport = :$port" 2>/dev/null | grep -oE 'users:\(\("[^"]+' | sed 's/.*"//' | head -1)"
    if [ -n "$owner" ] && echo "$owner" | grep -qiE 'nginx'; then
      err "$label (port $port) motaaleq be nginx ast. port digari entekhab kon."
      return 1
    fi
  fi
  return 0
}

# barresi tadakhol port inbound
# nokte-ye mohem: dar samt-e node, `local_addr` yek MAGHSAD ast (rathole traffic ra be an
# tahvil midahad), na yek port-e listen. bnbrin yek inbound-e vahed (masalan 127.0.0.1:2087)
# mitavanad hamzaman az chand server-e Iran (main + chand upstream) traffic begirad (fan-in).
# pas eshterak-e port bein-e tunnelha MOJAZ ast va nabayad block shavad.
# tanha tadakhol-e vaghei ba nginx-e node (80/443) ast ke check_inbound an ra migirad.
# argument sevom (self) faghat baraye sazgari-ye emza negah dashte shode.
check_port_conflict(){
  local port="$1" label="$2" self="${3:-}"
  check_inbound "$port" "$label" || return 1
  return 0
}



# tvlid client.toml az node.env + services.conf (hame zir yek [client])
gen_client(){
  load_env
  [ -f "$SVC_FILE" ] || die "hich srvisi tarif nashode ($SVC_FILE). ba 'ratholenode add-svc' ezafe kon."
  # SERVER endpoint-e dial ast; TLS_HOSTNAME (ekhtiari) SNI/cert hostname ra joda negah midarad.
  # config-haye ghadimi SERVER-only sazgar mimanand; baraye IP+self-signed, TLS_TRUSTED_ROOT
  # faghat public cert/CA ast (hich kelid-e khosusi rooye node nemiayad).
  local host="${TLS_HOSTNAME:-${SERVER%%:*}}"
  local trust="${TLS_TRUSTED_ROOT:-}"
  local mode="${TUNNEL:-ws}" remote tls hostline emitted_services=0
  if [ "$mode" = "kcp" ]; then
    # masir az trigh kcptun lvkal mirvd; TLS lazem nist (kcp khodesh ramz/FEC darad)
    remote="${KCP_LOCAL:-127.0.0.1:29900}"
    tls="false"; hostline=""
  elif [ "$mode" = "plain" ]; then
    # tunnel-e websocket bedoon-e TLS: mostaghim be port-e HTTP-e sade rooye server Iran
    remote="${PLAIN_REMOTE:-$SERVER}"; tls="false"; hostline=""
  elif [ "$mode" = "noise" ]; then
    # tunnel-e ramznegari-shode ba Noise: mostaghim be port-e omomi-ye rathole-noise rooye Iran (bedoon TLS/cert)
    remote="${NOISE_REMOTE:-$SERVER}"; tls="false"; hostline=""
  else
    remote="${SERVER}"; tls="true"; hostline="hostname = \"${host}\""
  fi

  {
    echo "# tvlid khodkar tvst ratholenode — dasti virayesh nakon (tunnel=${mode})"
    local hbt="${HEARTBEAT_TIMEOUT:-40}"; [ "$mode" = "kcp" ] && hbt="${KCP_HEARTBEAT_TIMEOUT:-90}"
    echo "[client]"
    echo "remote_addr = \"${remote}\""
    echo "retry_interval = 1"
    echo "heartbeat_timeout = ${hbt}"
    echo
    echo "[client.transport]"
    if [ "$mode" = "noise" ]; then
      echo "type = \"noise\""
      echo "[client.transport.noise]"
      echo "pattern = \"${NOISE_PATTERN:-Noise_NK_25519_ChaChaPoly_BLAKE2s}\""
      echo "remote_public_key = \"${NOISE_PUBKEY}\""
    else
      echo "type = \"websocket\""
      echo "[client.transport.websocket]"
      echo "tls = ${tls}"
      # TAVAHH: rathole-e v0.5.0 dar [client.transport.websocket] FAGHAT `tls` ra mipazirad;
      # field-e `path` nadarad va config ra KAMLAN rad mikonad (client crash-loop). control
      # WebSocket-e rathole hamishe '/' ast va gabel-e taghir nist — routing-e path tvst nginx
      # (map $uri) anjam mishavad, na rathole. pas WS_PATH ra inja TZRIGH nakon.
      if [ "$tls" = "true" ]; then
        echo "[client.transport.tls]"
        echo "$hostline"
        if [ -n "$trust" ]; then
          [ -f "$trust" ] || die "TLS trusted root peyda nashod: $trust"
          echo "trusted_root = \"${trust}\""
        fi
      fi
    fi
    while IFS='|' read -r name token inbound; do
      [ -n "$name" ] || continue
      case "$name" in \#*) continue ;; esac
      # CR-e entehai ra pak kon (agar services.conf ba CRLF zakhire shode bashad) va
      # khatt-e naghes (token/inbound-e khali) ra rad kon — vagarna TOML-e namotabar tolid
      # mishavad va rathole KOLL-e config ra rad mikonad (hame-ye service-ha down).
      token="${token%$'\r'}"; inbound="${inbound%$'\r'}"
      if [ -z "$token" ] || ! echo "$inbound" | grep -qE '^[0-9]+$'; then
        warn "khatt-e namotabar dar services.conf rad shod (name=$name)."
        continue
      fi
      emitted_services=$((emitted_services + 1))
      echo
      echo "[client.services.${name}]"
      echo "token = \"${token}\""
      echo "local_addr = \"127.0.0.1:${inbound}\""
      echo "type = \"tcp\""
    done < "$SVC_FILE"
    if [ "$emitted_services" -eq 0 ]; then
      echo
      echo "[client.services]"
    fi
  } > "$CLIENT_TOML.tmp"
  # neveshtan in-place lock-shode (hefz inode) ta rathole ba config_watcher hot-reload konad
  rth_commit_config "$CLIENT_TOML.tmp" "$CLIENT_TOML"
}

# restart kamel (fght baraye taghir trnspvrt mesl kcp on/off lazem ast)
restart_svc(){
  if ! command -v systemctl >/dev/null 2>&1; then
    err "systemctl peyda nashod؛ $SVC restart nashod."
    return 1
  fi
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable "$SVC" >/dev/null 2>&1 || true
  if systemctl restart "$SVC" 2>/dev/null && systemctl is-active --quiet "$SVC"; then
    log "$SVC restart shod."
    return 0
  else
    err "restart $SVC shekast khord; log: journalctl -u $SVC -n 30 --no-pager"
    return 1
  fi
}

# hot-reload: fght agar service khamoosh bood start miknd; dar ghir ainsvrt rathole khodesh config ra mikhanad (bedoon ghati)
reload_svc(){
  # MOHEM (halat-e backhaul): 'backhaul on' rathole-client ra KHAMOOSH mikond (jaygozin-e kamel-e
  # tunnel ast). agar injja enable/start mishod, do tunnel-e movazi faal mishod (rathole + backhaul)
  # va update.sh health-check ham rathole-client «nagensht» mipandid → rollback-haye ghalat.
  if [ "${TUNNEL:-ws}" = "backhaul" ]; then
    log "TUNNEL=backhaul faal ast; client.toml regen shod vali $SVC khamoosh mimanad (backhaul-client tunnel ra edare mikonad)."
    return 0
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    err "systemctl peyda nashod؛ $SVC reload nashod."
    return 1
  fi
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable "$SVC" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "$SVC"; then
    log "client.toml berooz shd; rathole hot-reload mikonad (tunnelhaye faal mesl game ghat nmishvnd)."
    return 0
  else
    if systemctl start "$SVC" 2>/dev/null && systemctl is-active --quiet "$SVC"; then
      log "$SVC start shod."
      return 0
    else
      err "start $SVC shekast khord; log: journalctl -u $SVC -n 30 --no-pager"
      return 1
    fi
  fi
}

cmd_apply(){
  need_root; load_env
  # check tadakhol port baraye har service
  if [ -f "$SVC_FILE" ]; then
    while IFS='|' read -r name token inbound; do
      [ -n "$name" ] || continue; case "$name" in \#*) continue ;; esac
      check_port_conflict "$inbound" "inbound $name" "$name" || warn "ba vojood tadakhol adamh midhim."
    done < "$SVC_FILE"

  fi
  gen_client
  # MOHEM: khorooji-e reload_svc ghablan NADIDE migereft va akharin log hamishe rc=0 midad —
  # 'apply'/'add-svc'/'set' movafaghiat-e ghalat report mikardand (tunnel down, exit 0) va
  # guard-e `|| warn` dar update.sh ham hamishe dead-code bood.
  if reload_svc; then
    log "client.toml ba $(grep -cvE '^\s*(#|$)' "$SVC_FILE" 2>/dev/null || echo 0) service rooye yek tunnel sakhte shod."
    return 0
  else
    err "apply shekast khord: tunnel bala niamad (khorooji-e bala ra bebin)."
    return 1
  fi
}

svc_exists(){ grep -qE "^$1\|" "$SVC_FILE" 2>/dev/null; }

# aatbarsnji-ye moshtarak baraye name/token-e service (jelogiri az tzrigh be TOML/services.conf)
valid_svc_name(){ echo "$1" | grep -qE '^[a-zA-Z0-9_-]+$'; }
# token bayad az '|' (jodakonande-ye services.conf) va newline/space va metachar-e TOML khali bashad.
valid_svc_token(){ echo "$1" | grep -qE '^[A-Za-z0-9._=+/-]+$'; }

cmd_add_svc(){
  need_root
  local name="${1:-}" token="${2:-}" inbound="${3:-}"
  [ -n "$name" ] && [ -n "$token" ] && [ -n "$inbound" ] || die "estefade: ratholenode add-svc <name> <token> <inbound_port>"
  valid_svc_name "$name" || die "name namotabar."
  valid_svc_token "$token" || die "token namotabar (faghat [A-Za-z0-9._=+/-] mjaz ast)."
  is_valid_port "$inbound" || die "inbound port namotabar ($inbound). bayad adadi bein-e 1 ta 65535 bashad."
  check_port_conflict "$inbound" "service '$name'" || die "tadakhol port — meghdar digari entekhab kon."
  touch "$SVC_FILE"; chmod 600 "$SVC_FILE"
  if svc_exists "$name"; then
    warn "service '$name' vojood dard; beroozresani mishavad."
    safe_svc_del "$SVC_FILE" "$name"
  fi
  echo "${name}|${token}|${inbound}" >> "$SVC_FILE" || die "neveshtan-e $SVC_FILE shekast khord (faza-e disk/mojaveziat?)."
  log "service '$name' → 127.0.0.1:$inbound ezafe shod (haman tunnel)."
  cmd_apply
}

cmd_rm_svc(){
  need_root
  local name="${1:-}"
  [ -n "$name" ] || die "estefade: ratholenode rm-svc <name>"
  valid_svc_name "$name" || die "name namotabar."
  svc_exists "$name" || die "service '$name' peyda nashod."
  safe_svc_del "$SVC_FILE" "$name"
  log "service '$name' hazf shod."
  cmd_apply
}

cmd_ls(){
  [ -f "$SVC_FILE" ] || { warn "hich srvisi nist."; return; }
  load_env
  echo "tunnel be: $(c_y "${SERVER:-?}")  (hame serviceha rooye yek channel kontroli)"
  printf '%-16s %-10s %s\n' "SERVICE" "INBOUND" "TOKEN"
  printf '%s\n' "-------------------------------------------"
  while IFS='|' read -r name token inbound; do
    [ -n "$name" ] || continue; case "$name" in \#*) continue ;; esac
    printf '%-16s %-10s %s\n' "$name" "$inbound" "${token:0:8}…"
  done < "$SVC_FILE"
}

cmd_set(){
  need_root
  local key="${1:-}" val="${2:-}"
  [ -n "$key" ] && [ -n "$val" ] || die "estefade: ratholenode set <SERVER|TLS_HOSTNAME|TLS_TRUSTED_ROOT|RATHOLE_VERSION> <value>"
  case "$key" in SERVER|TLS_HOSTNAME|TLS_TRUSTED_ROOT|RATHOLE_VERSION) ;; *) die "kelid nashenakhte: $key (baraye serviceha az add-svc/rm-svc estefade kon)";; esac
  # val ra etebar-sanji kon: hich metachar-e sed (# & \ / newline) nabayad dashte bashad,
  # vagarna sed-e paiin ('s#...#...#') mishkanad ya jایgozini-ye eshtebah mikonad.
  case "$key" in
    SERVER)
      local s_host s_port
      if [[ "$val" == *:* ]]; then
        s_host="${val%:*}"
        s_port="${val##*:}"
      else
        s_host="$val"
        s_port="443"
        val="${s_host}:${s_port}"
      fi
      echo "$s_host" | grep -qE '^[A-Za-z0-9_.-]+$' || die "SERVER host namotabar."
      is_valid_port "$s_port" || die "SERVER port namotabar ($s_port). bayad adadi bein-e 1 ta 65535 bashad."
      ;;
    TLS_HOSTNAME)     echo "$val" | grep -qE '^[A-Za-z0-9_.-]+$' || die "TLS_HOSTNAME namotabar (domain/IP)." ;;
    TLS_TRUSTED_ROOT) echo "$val" | grep -qE '^/[A-Za-z0-9_./-]{1,255}$' || die "TLS_TRUSTED_ROOT bayad masir-e motlagh-e amn bashad." ;;
    RATHOLE_VERSION)  echo "$val" | grep -qE '^[A-Za-z0-9_.-]+$' || die "RATHOLE_VERSION namotabar." ;;
  esac
  # node.env agar hanoz nist (node-e taze az hub provision-shode, ghabl az install-node/curl)
  # ra bساز — 'set SERVER' khodesh bootstrap-e tunnel-e asli ast, pas nabayad ba «node.env
  # peyda nashod» die konad. az env_set (ke touch mikonad) estefade mikonim.
  env_set "$key" "$val" || die "neveshtan-e $ENV_FILE shekast khord (faza-e disk/mojaveziat?)."
  log "tanzim shod: $key = $val"
  # faghat vaghti hadaghal yek service tarif shode apply kon; vagarna SERVER zakhire mishavad
  # va baad az afzoodan-e avalin service (add-svc / sim-keshi az hub) tunnel sakhte mishavad.
  if [ -f "$SVC_FILE" ] && grep -qvE '^\s*(#|$)' "$SVC_FILE" 2>/dev/null; then
    cmd_apply
  else
    warn "hanoz service-i nist; $key zakhire shod. baad az 'add-svc' tunnel sakhte mishavad."
  fi
}

cmd_set_main(){
  need_root
  local server="${1:-}" hostname="${2:-}" trust="${3:-}"
  [ -n "$server" ] || die "estefade: ratholenode set-main <host:port> [tls_hostname] [trusted_root]"
  local s_host s_port
  if [[ "$server" == *:* ]]; then
    s_host="${server%:*}"
    s_port="${server##*:}"
  else
    s_host="$server"
    s_port="443"
    server="${s_host}:${s_port}"
  fi
  echo "$s_host" | grep -qE '^[A-Za-z0-9_.-]+$' || die "SERVER host namotabar."
  is_valid_port "$s_port" || die "SERVER port namotabar ($s_port). bayad adadi bein-e 1 ta 65535 bashad."
  [ -z "$hostname" ] || echo "$hostname" | grep -qE '^[A-Za-z0-9_.-]+$' || die "TLS hostname namotabar."
  if [ -n "$trust" ]; then
    echo "$trust" | grep -qE '^/[A-Za-z0-9_./-]{1,255}$' || die "trusted_root bayad masir-e motlagh-e amn bashad."
    [ -n "$hostname" ] || die "trusted_root bedoon tls_hostname mojaz nist."
    [ -f "$trust" ] || die "trusted_root peyda nashod: $trust"
  fi
  env_set SERVER "$server"
  if [ -n "$hostname" ]; then env_set TLS_HOSTNAME "$hostname"; else safe_kv_del "$ENV_FILE" TLS_HOSTNAME; fi
  if [ -n "$trust" ]; then env_set TLS_TRUSTED_ROOT "$trust"; else safe_kv_del "$ENV_FILE" TLS_TRUSTED_ROOT; fi
  log "tunnel asli set shod: dial=$server${hostname:+ tls_hostname=$hostname}${trust:+ trusted_root=$trust}"
  if [ -f "$SVC_FILE" ] && grep -qvE '^\s*(#|$)' "$SVC_FILE" 2>/dev/null; then cmd_apply; else warn "hanoz service-i nist; tanzimat zakhire shod."; fi
}

cmd_show(){
  load_env
  echo "$(c_g '== node.env ==')"; cat "$ENV_FILE"
  echo; echo "$(c_g '== services ==')"; cmd_ls
}
_unit_active(){ systemctl is-active --quiet "$1" 2>/dev/null && echo yes || echo no; }
_unit_enabled(){ systemctl is-enabled --quiet "$1" 2>/dev/null && echo yes || echo no; }
cmd_status(){
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
  load_env
  local mode="${TUNNEL:-ws}" remote="${SERVER:-}" tls_host="${TLS_HOSTNAME:-${SERVER%%:*}}"
  local tls=yes encrypted=yes unit="$SVC" bh_remote="${BH_REMOTE_ADDR:-}" trusted_root="${TLS_TRUSTED_ROOT:-}"
  case "$mode" in
    plain) remote="${PLAIN_REMOTE:-$remote}"; tls=no; encrypted=no ;;
    noise) remote="${NOISE_REMOTE:-$remote}"; tls=no; encrypted=yes ;;
    kcp) remote="${KCP_REMOTE:-$remote}"; tls=no; encrypted=yes ;;
    backhaul)
      unit="$BH_CLI_SVC"
      remote="${BH_REMOTE_ADDR:-${BH_REMOTE:+${BH_REMOTE}:443}}"
      case "${BH_TRANSPORT:-wssmux}" in ws|wsmux) tls=no; encrypted=no ;; *) tls=yes; encrypted=yes ;; esac
      ;;
  esac
  local wd_enabled adaptive_enabled adaptive_class
  wd_enabled="$(_unit_enabled rathole-watchdog.timer)"
  adaptive_load_env; adaptive_enabled="${ADAPTIVE_ENABLED:-0}"
  adaptive_class="$(python3 -c "import json; print(json.load(open('$ADAPTIVE_STATE')).get('classification','unknown'))" 2>/dev/null || echo unknown)"
  if [ "$as_json" -eq 1 ]; then
    command -v python3 >/dev/null 2>&1 || { printf '{"error":"python3 missing"}\n'; return; }
    NODE_MODE="$mode" NODE_REMOTE="$remote" NODE_TLS_HOST="$tls_host" NODE_TRUSTED_ROOT="$trusted_root" NODE_TLS="$tls" NODE_ENCRYPTED="$encrypted" \
    NODE_UNIT="$unit" NODE_ACTIVE="$(_unit_active "$unit")" NODE_ENABLED="$(_unit_enabled "$unit")" \
    NODE_WD="$wd_enabled" NODE_ADAPTIVE="$adaptive_enabled" NODE_ADAPTIVE_CLASS="$adaptive_class" \
    python3 -c 'import json,os; b=lambda n:os.environ.get(n)=="yes"; print(json.dumps({"main":{"transport":os.environ["NODE_MODE"],"dial_endpoint":os.environ["NODE_REMOTE"],"tls_hostname":os.environ["NODE_TLS_HOST"],"tls_trusted_root":os.environ["NODE_TRUSTED_ROOT"],"tls":b("NODE_TLS"),"encrypted":b("NODE_ENCRYPTED"),"service":{"name":os.environ["NODE_UNIT"],"enabled":b("NODE_ENABLED"),"active":b("NODE_ACTIVE")},"live":"unknown"},"watchdog":{"enabled":b("NODE_WD")},"adaptive":{"enabled":os.environ["NODE_ADAPTIVE"]=="1","last_probe":os.environ["NODE_ADAPTIVE_CLASS"]}}))'
    return
  fi
  printf 'tunnel: %s  dial: %s  tls-hostname: %s  trusted-root: %s\n' "$mode" "$remote" "$tls_host" "${trusted_root:--}"
  printf '  %s: %s\n' "$unit" "$(_unit_active "$unit")"
}
cmd_logs(){ journalctl -u "$SVC" -n "${1:-50}" --no-pager || true; }

# ---------- logs all: jam-avari-ye HAME chiz baraye eshkal-zodai ----------
# estefade: ratholenode logs all [tedad-khat] [--bundle]
# token-ha/kelid-ha ba rth_redact (common.sh) hazf mishavand — khorooji ghabel-e eshterak ast.
_logs_all_body(){
  local n="$1" u id
  rth_sec "kolli"
  printf 'tarikh      : %s\n' "$(date -Is 2>/dev/null)"
  printf 'hostname    : %s\n' "$(hostname 2>/dev/null)"
  printf 'naghsh      : node (kharej)\n'
  printf 'kernel      : %s\n' "$(uname -sr 2>/dev/null)"
  printf 'os          : %s\n' "$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")"
  printf 'ratholenode : %s\n' "$(print_version node 2>/dev/null | head -1)"
  printf 'rathole     : %s\n' "$(/usr/local/bin/rathole --version 2>/dev/null || echo 'nist')"
  printf 'uptime      : %s\n' "$(uptime -p 2>/dev/null)"

  rth_sec "tanzimat (show)"
  cmd_show 2>&1 | rth_redact || true

  # ---- service-ha: asli + backhaul/kcp/fakeweb/watchdog + hameye upstream-ha ----
  for u in "$SVC" rathole-backhaul-client rathole-kcp-client rathole-fakeweb rathole-watchdog; do
    rth_unit_log "$u" "$n"
  done
  # instans-haye multi-Iran (rathole-client@<id> + kcp-up-<id>)
  for f in /etc/systemd/system/rathole-client@*.service /etc/systemd/system/rathole-kcp-up-*.service; do
    [ -f "$f" ] || continue
    u="$(basename "$f" .service)"
    rth_sec "unit: $u  (halat: $(systemctl is-active "$u" 2>/dev/null || echo unknown))"
    journalctl -u "$u" -n "$n" --no-pager 2>/dev/null | rth_redact || true
  done

  rth_sec "atsal-haye khorooji (ss -tnp state established)"
  ss -tnp state established 2>/dev/null | head -n 40 | rth_redact || true
  rth_sec "port-haye baz (ss -ltnp)"
  ss -ltnp 2>/dev/null | rth_redact || true

  rth_file_dump "node.env"             "$ENV_FILE"      120
  # MOHEM: services.conf format «name|token|inbound» darad — rth_redact faghat JSON/TOML/env
  # ra mishnasad va in format az dir-e an migozarad. bundle baraye paste kardan dar chat/issue
  # ast; bedoon-e in redact, tamame token-ha cleartext kharej mishod.
  rth_sec "services.conf ($SVC_FILE)"
  if [ -f "$SVC_FILE" ]; then
    head -n 120 "$SVC_FILE" 2>/dev/null \
      | sed -E 's/^([^#|]+)\|[^|]*\|([^|]*)$/\1|***REDACTED***|\2/' \
      | rth_redact || true
  else
    echo "NIST"
  fi
  rth_file_dump "client.toml"          "$CLIENT_TOML"   300
  rth_file_dump "backhaul-client.toml" "/etc/rathole/backhaul-client.toml" 120

  rth_sec "payan"
}

cmd_logs_all(){
  local n=80 bundle=0 a
  for a in "$@"; do
    case "$a" in
      --bundle) bundle=1 ;;
      ''|*[!0-9]*) : ;;
      *) n="$a" ;;
    esac
  done
  if [ "$bundle" -eq 1 ]; then
    local out; out="/tmp/rathole-logs-$(hostname -s 2>/dev/null || echo node)-$(date +%Y%m%d-%H%M%S).txt.gz"
    _logs_all_body "$n" 2>&1 | gzip -c > "$out" || die "sakht-e bundle shekast khord."
    chmod 600 "$out"
    log "bundle-e log sakhte shod: $out  ($(du -h "$out" 2>/dev/null | cut -f1))"
    echo "  bardashtan az system-e khodet:  scp root@<ip-node>:$out ."
  else
    _logs_all_body "$n"
  fi
}

# ---------- kcp/FEC tunnel samt node (switch masir tunnel az 443 be UDP+FEC) ----------
KCP_CLI_BIN=/usr/local/bin/kcptun-client
KCP_CLI_UNIT=/etc/systemd/system/rathole-kcp-client.service
KCPTUN_VER_DEF="v20260129"
KCPTUN_BASE_DEF="https://github.com/ossfork/kcptun/releases/download"
KCP_LOCAL_DEF="127.0.0.1:29900"

# ---------- backhaul core (SMUX) samt node: client ke be nginx/443 (domain) vasl mishavad ----------
BH_CLI_SVC=rathole-backhaul-client
BH_CLI_UNIT="/etc/systemd/system/${BH_CLI_SVC}.service"
BH_TOML=/etc/rathole/backhaul-client.toml

env_set(){ # $1=key $2=value (dar node.env)
  safe_kv_set "$ENV_FILE" "$1" "$2"
}

install_kcptun_client(){
  local bin="$KCP_CLI_BIN" ver="${KCPTUN_VER:-$KCPTUN_VER_DEF}" base="${KCPTUN_BASE:-$KCPTUN_BASE_DEF}" arch tmp url ok=0 m
  [ -x "$bin" ] && return 0
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; armv7l) arch=armv7 ;; *) die "memari poshtibani nemishavad." ;; esac
  command -v curl >/dev/null 2>&1 || die "curl lazem ast."
  log "download kcptun ${ver}..."
  tmp="$(rth_mktempd)"
  url="${base}/${ver}/kcptun_linux_${arch}.tar.gz"
  for m in "" "https://ghproxy.net/" "https://gh-proxy.com/" "https://mirror.ghproxy.com/"; do
    if curl -fsSL --connect-timeout 20 --speed-limit 1024 --speed-time 30 --retry 2 \
         "${m}${url}" -o "$tmp/k.tgz" 2>/dev/null; then
      ok=1; break
    fi
  done
  [ "$ok" -eq 1 ] || { rm -rf "$tmp"; die "download kcptun shekast khord."; }
  tar -xzf "$tmp/k.tgz" -C "$tmp" || { rm -rf "$tmp"; die "baz kardan arshiv shekast khord."; }
  install -m755 "$tmp/client_linux_${arch}" "$bin" || { rm -rf "$tmp"; die "nasb bainri shekast khord."; }
  rm -rf "$tmp"; log "kcptun-client nasb shod."
}

gen_kcp_client_unit(){ # $1=remote $2=local $3=key $4=ds $5=ps $6=mode $7=sw $8=rw
  local remote="$1" local_ep="$2" key="$3" ds="$4" ps="$5" mode="$6" sw="$7" rw="$8"
  validate_endpoint "$remote" || die "remote endpoint namotabar: $remote"
  validate_endpoint "$local_ep" || die "local endpoint namotabar: $local_ep"
  validate_kcp_key "$key" || die "kcp key namotabar"
  local udir; udir="$(dirname "$KCP_CLI_UNIT")"
  mkdir -p "$udir"
  local tmp; tmp="$(mktemp "$udir/.kcp_unit.XXXXXX" 2>/dev/null)" || { err "sakht-e file-e movaghat baraye unit shekast khord"; return 1; }
  chmod 644 "$tmp" 2>/dev/null || true
  cat > "$tmp" <<UNIT
[Unit]
Description=rathole kcp-client (local TCP -> UDP+FEC to Iran)
After=network.target

[Service]
Type=simple
ExecStart=${KCP_CLI_BIN} -r "${remote}" -l "${local_ep}" -key "${key}" -crypt aes-128 -mode "${mode}" -mtu 1350 -sndwnd ${sw} -rcvwnd ${rw} -datashard ${ds} -parityshard ${ps} -dscp 46 -nocomp
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
UNIT
  mv -f "$tmp" "$KCP_CLI_UNIT" || { rm -f "$tmp"; err "jaye gozini-e unit shekast khord."; return 1; }
  chmod 644 "$KCP_CLI_UNIT" 2>/dev/null || true
  return 0
}

# profile FEC ("datashard parityshard mode sndwnd rcvwnd") dar common.sh:kcp_profile ast —
# amdan inja copy NEMISHAVAD: parametr-haye FEC bayad ba server-e Iran daghighan yeksan bashand.

cmd_kcp(){
  need_root
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)   cmd_kcp_on "$@" ;;
    off)  cmd_kcp_off ;;
    status) cmd_kcp_status ;;
    *) die "estefade: ratholenode kcp <on <iran_ip:udp_port> <key> [profile]|off|status>" ;;
  esac
}

cmd_kcp_on(){
  local remote="${1:-}" key="${2:-}" profile="${3:-balanced}" local_ep="${KCP_LOCAL:-$KCP_LOCAL_DEF}" params ds ps mode sw rw
  [ -n "$remote" ] && [ -n "$key" ] || die "estefade: ratholenode kcp on <iran_ip:udp_port> <key> [profile]"
  validate_endpoint "$remote" || die "adres bayad be shkl IP:PORT bashad: $remote"
  validate_kcp_key "$key" || die "kcp key namotabar ast."
  params="$(kcp_profile "$profile")" || die "profile namotabar: $profile (balanced|lossy|aggressive)"
  read -r ds ps mode sw rw <<<"$params"
  install_kcptun_client

  # Snapshot current state before mutations
  local env_bak="" cli_bak="" unit_bak="" had_unit=0
  if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
  if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi
  if [ -f "$KCP_CLI_UNIT" ]; then unit_bak="$(rth_mktemp)" || return 1; cp -a "$KCP_CLI_UNIT" "$unit_bak" || return 1; had_unit=1; fi

  _kcp_on_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
    [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
    if [ "$had_unit" -eq 1 ] && [ -n "$unit_bak" ] && [ -f "$unit_bak" ]; then
      cp -a "$unit_bak" "$KCP_CLI_UNIT" 2>/dev/null || true
    else
      systemctl stop rathole-kcp-client 2>/dev/null || true
      systemctl disable rathole-kcp-client 2>/dev/null || true
      rm -f "$KCP_CLI_UNIT" 2>/dev/null || true
    fi
    systemctl daemon-reload 2>/dev/null || true
    rm -f "$env_bak" "$cli_bak" "$unit_bak" 2>/dev/null || true
    restart_svc 2>/dev/null || true
  }

  if ! gen_kcp_client_unit "$remote" "$local_ep" "$key" "$ds" "$ps" "$mode" "$sw" "$rw"; then
    _kcp_on_rollback
    err "sakht-e unit-e kcp-client shekast khord"
    return 1
  fi
  if ! systemctl daemon-reload; then
    _kcp_on_rollback
    err "daemon-reload shekast khord"
    return 1
  fi
  if ! systemctl enable rathole-kcp-client >/dev/null 2>&1; then
    _kcp_on_rollback
    err "enable-e rathole-kcp-client shekast khord"
    return 1
  fi
  if ! systemctl restart rathole-kcp-client 2>/dev/null || ! systemctl is-active --quiet rathole-kcp-client; then
    _kcp_on_rollback
    err "rathole-kcp-client bala niamd ya restart shekast khord; log: journalctl -u rathole-kcp-client -n 30"
    return 1
  fi
  log "kcp-client faal shod: $local_ep → UDP $remote (profile: $profile)."

  # switch tunnel be kcp va baztolid client.toml. env_set-ha CHECK mishavand: agar neveshtan-e
  # env shekast bokhorad va bi-seda edame midad, gen_client env-e GHADIMI ra mikhad → tunnel-e
  # WS faal mishod vali log migoft «kcp switch shod» (mosir-e asli-ye kcp/block-shode bod).
  env_set TUNNEL kcp || { _kcp_on_rollback; err "env_set TUNNEL shekast khord"; return 1; }
  env_set KCP_LOCAL "$local_ep" || { _kcp_on_rollback; err "env_set KCP_LOCAL shekast khord"; return 1; }
  env_set KCP_REMOTE "$remote" || { _kcp_on_rollback; err "env_set KCP_REMOTE shekast khord"; return 1; }
  env_set KCP_PROFILE "$profile" || { _kcp_on_rollback; err "env_set KCP_PROFILE shekast khord"; return 1; }
  if ! gen_client || ! restart_svc; then
    _kcp_on_rollback
    err "baztolid-e client ya restart-e $SVC shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$cli_bak" "$unit_bak" 2>/dev/null || true
  log "tunnel be masir kcp/UDP+FEC switch shod. serviceha/tokenha/path karbaran taghir nakard."
  warn "agar serviceha vsl nshdnd, rooye Iran motmaen shv 'ratholectl kcp on' ba haman profile zade shode va UDP baz ast."
}

cmd_kcp_off(){
  # Snapshot current state before mutations
  local env_bak="" cli_bak="" unit_bak="" had_unit=0
  if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
  if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi
  if [ -f "$KCP_CLI_UNIT" ]; then unit_bak="$(rth_mktemp)" || return 1; cp -a "$KCP_CLI_UNIT" "$unit_bak" || return 1; had_unit=1; fi

  _kcp_off_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
    [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
    if [ "$had_unit" -eq 1 ] && [ -n "$unit_bak" ] && [ -f "$unit_bak" ]; then
      cp -a "$unit_bak" "$KCP_CLI_UNIT" 2>/dev/null || true
      systemctl daemon-reload 2>/dev/null || true
      systemctl enable rathole-kcp-client 2>/dev/null || true
      systemctl restart rathole-kcp-client 2>/dev/null || true
    fi
    rm -f "$env_bak" "$cli_bak" "$unit_bak" 2>/dev/null || true
    restart_svc 2>/dev/null || true
  }

  systemctl stop rathole-kcp-client 2>/dev/null || true
  systemctl disable rathole-kcp-client 2>/dev/null || true
  rm -f "$KCP_CLI_UNIT"
  if ! systemctl daemon-reload; then
    _kcp_off_rollback
    err "daemon-reload shekast khord"
    return 1
  fi
  env_set TUNNEL ws
  if ! gen_client || ! restart_svc; then
    _kcp_off_rollback
    err "bargasht be websocket shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$cli_bak" "$unit_bak" 2>/dev/null || true
  log "tunnel be halat websocket/443 bargasht."
}

cmd_kcp_status(){
  load_env
  local mode="${TUNNEL:-ws}"
  echo "halat tunnel: $(c_y "$mode")"
  if [ "$mode" = "kcp" ]; then
    echo "  local: ${KCP_LOCAL:-?}   remote(UDP): ${KCP_REMOTE:-?}   profile: ${KCP_PROFILE:-balanced}"
    case "${KCP_REMOTE:-}" in *:443) echo "  estetar: UDP/443 ~ QUIC/HTTP3" ;; esac
    systemctl is-active --quiet rathole-kcp-client && echo "  kcp-client: $(c_g 'active')" || echo "  kcp-client: $(c_r 'inactive')"
  fi
  systemctl is-active --quiet "$SVC" && echo "  $SVC: $(c_g 'active')" || echo "  $SVC: $(c_r 'inactive')"
}

# ---------- plain: tunnel-e websocket bedoon-e TLS (mostaghim be port HTTP-e sade rooye Iran) ----------
cmd_plain(){
  need_root
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)   cmd_plain_on "$@" ;;
    off)  cmd_plain_off ;;
    status) cmd_plain_status ;;
    *) die "estefade: ratholenode plain <on <iran_ip:port>|off|status>" ;;
  esac
}

cmd_plain_on(){
  local remote="${1:-}"
  [ -n "$remote" ] || die "estefade: ratholenode plain on <iran_ip:port>  (port-e HTTP-e sade rooye Iran, masalan 8880)"
  echo "$remote" | grep -qE '^[^:]+:[0-9]+$' || die "adres bayad be shkl IP:PORT bashad (masalan 1.2.3.4:8880)."
  is_valid_port "${remote##*:}" || die "port-e remote namotabar (${remote##*:}). bayad adadi bein-e 1 ta 65535 bashad."

  local env_bak="" cli_bak=""
  if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
  if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi

  _plain_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
    [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
    rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
    restart_svc 2>/dev/null || true
  }

  env_set TUNNEL plain
  env_set PLAIN_REMOTE "$remote"
  if ! gen_client || ! restart_svc; then
    _plain_rollback
    err "switch be halat plain shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
  log "tunnel be halat plain (bedoon TLS) switch shod → ws://$remote"
  warn "rooye server Iran motmaen shv 'ratholectl plain on [port]' zade shode va port TCP baz ast."
}

cmd_plain_off(){
  local env_bak="" cli_bak=""
  if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
  if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi

  _plain_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
    [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
    rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
    restart_svc 2>/dev/null || true
  }

  env_set TUNNEL ws
  if ! gen_client || ! restart_svc; then
    _plain_rollback
    err "bargasht az halat plain shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
  log "tunnel be halat websocket/443 (ba TLS) bargasht."
}

cmd_plain_status(){
