# ---------- noise: tunnel-e ramznegari-shode (rathole Noise) mostaghim be port-e omomi-ye rathole-noise rooye Iran ----------
# bedoon TLS/cert; ramznegari tavassot-e khod-e Noise (X25519+ChaChaPoly). faghat kelid-e omomi-ye server niaz ast.
cmd_noise(){
  need_root
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)   cmd_noise_on "$@" ;;
    off)  cmd_noise_off ;;
    status) cmd_noise_status ;;
    *) die "estefade: ratholenode noise <on <iran_ip:port> <pubkey> [pattern]|off|status>" ;;
  esac
}

cmd_noise_on(){
  local remote="${1:-}" pubkey="${2:-}" pattern="${3:-}"
  [ -n "$remote" ] && [ -n "$pubkey" ] || die "estefade: ratholenode noise on <iran_ip:port> <pubkey> [pattern]  (port-e omomi-ye rathole-noise rooye Iran, masalan 2334)"
  echo "$remote" | grep -qE '^[^:]+:[0-9]+$' || die "adres bayad be shkl IP:PORT bashad (masalan 1.2.3.4:2334)."
  is_valid_port "${remote##*:}" || die "port-e remote namotabar (${remote##*:}). bayad adadi bein-e 1 ta 65535 bashad."
  echo "$pubkey" | grep -qE '^[A-Za-z0-9+/]{40,64}={0,2}$' || die "pubkey bayad base64-e motabar bashad (az 'ratholectl noise show' rooye Iran)."
  # pattern mostaghim dar TOML (pattern = "...") miravad — naqol/ghalvat-e TOML ra rad kon.
  [ -z "$pattern" ] || echo "$pattern" | grep -qE '^[A-Za-z0-9_.-]+$' || die "pattern-e noise namotabar (faghat [A-Za-z0-9_.-])."

  local env_bak="" cli_bak=""
  if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
  if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi

  _noise_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
    [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
    rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
    restart_svc 2>/dev/null || true
  }

  env_set TUNNEL noise
  env_set NOISE_REMOTE "$remote"
  env_set NOISE_PUBKEY "$pubkey"
  [ -n "$pattern" ] && env_set NOISE_PATTERN "$pattern" || env_set NOISE_PATTERN "Noise_NK_25519_ChaChaPoly_BLAKE2s"
  if ! gen_client || ! restart_svc; then
    _noise_rollback
    err "switch be halat noise shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
  log "tunnel be halat noise (ramznegari-shode) switch shod → noise://$remote"
  warn "rooye server Iran motmaen shv 'ratholectl noise on' zade shode va in node ba 'ratholectl noise node <name> on' faal shode va port TCP baz ast."
}

cmd_noise_off(){
  local env_bak="" cli_bak=""
  if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
  if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi

  _noise_rollback(){
    [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
    [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
    rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
    restart_svc 2>/dev/null || true
  }

  env_set TUNNEL ws
  if ! gen_client || ! restart_svc; then
    _noise_rollback
    err "bargasht az halat noise shekast khord؛ amaliat rollback shod."
    return 1
  fi
  rm -f "$env_bak" "$cli_bak" 2>/dev/null || true
  log "tunnel be halat websocket/443 (ba TLS) bargasht."
}

cmd_noise_status(){
  load_env
  local mode="${TUNNEL:-ws}"
  echo "halat tunnel: $(c_y "$mode")"
  if [ "$mode" = "noise" ]; then
    echo "  remote(noise, ramznegari-shode): ${NOISE_REMOTE:-?}"
    echo "  pubkey-e server: ${NOISE_PUBKEY:-?}"
  fi
  systemctl is-active --quiet "$SVC" && echo "  $SVC: $(c_g 'active')" || echo "  $SVC: $(c_r 'inactive')"
}

# ---------- backhaul: core-e joda-ye Go (SMUX). client be domain/443 (nginx → backhaul-server) vasl mishavad ----------
# masirhaye /channel va /tunnel dar backhaul hardcode shodand; nginx anha ra be backhaul-server proxy miknd.
gen_backhaul_client_toml(){
  load_env
  # sazgari: config-e ghadimi BH_REMOTE=domain ra be domain:443 tabdil kon; jadid endpoint-e kamel darad.
  local remote="${BH_REMOTE_ADDR:-${BH_REMOTE:+${BH_REMOTE}:443}}" transport="${BH_TRANSPORT:-wssmux}" token="${BH_TOKEN:-}" profile="${BH_PROFILE:-balanced}"
  [ -n "$remote" ] || die "BH_REMOTE_ADDR set nashode (ratholenode backhaul on <host:port|domain> <token> [transport] [profile])."
  [ -n "$token" ] || die "BH_TOKEN set nashode (az 'ratholectl backhaul show' rooye Iran)."
  # 'mux_con' (field-e aval) faghat samt-e server mani darad — inja dor rikhte mishavad.
  local muxver muxframe muxrecv muxstream pool
  read -r _ muxver muxframe muxrecv muxstream pool <<<"$(backhaul_mux_profile "$profile")"
  {
    echo "# tvlid khodkar tvst ratholenode — dasti virayesh nakon (core=backhaul, transport=${transport})"
    echo "[client]"
    echo "remote_addr = \"${remote}\""
    echo "transport = \"${transport}\""
    echo "token = \"${token}\""
    echo "connection_pool = ${pool:-8}"
    echo "retry_interval = 3"
    echo "dial_timeout = 10"
    echo "nodelay = true"
    echo "keepalive_period = 75"
    echo "mux_version = ${muxver:-1}"
    echo "mux_framesize = ${muxframe:-32768}"
    echo "mux_recievebuffer = ${muxrecv:-4194304}"
    echo "mux_streambuffer = ${muxstream:-65536}"
    echo "log_level = \"info\""
    echo "web_port = 0"
  } > "$BH_TOML.tmp"
  rth_commit_config "$BH_TOML.tmp" "$BH_TOML"
}

gen_backhaul_client_unit(){
  local udir; udir="$(dirname "$BH_CLI_UNIT")"
  mkdir -p "$udir" 2>/dev/null || true
  local tmp; tmp="$(mktemp "$udir/.bh_unit.XXXXXX" 2>/dev/null)" || { err "sakht-e temp file baraye backhaul client unit shekast khord"; return 1; }
  chmod 644 "$tmp" 2>/dev/null || true
  cat > "$tmp" <<UNIT
[Unit]
Description=backhaul client (SMUX core, foreign node)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/backhaul-client -c ${BH_TOML}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT
  mv -f "$tmp" "$BH_CLI_UNIT" || { rm -f "$tmp"; err "jaye gozini-e backhaul client unit shekast khord."; return 1; }
  chmod 644 "$BH_CLI_UNIT" 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
  return 0
}

cmd_backhaul(){
  need_root
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)
      local target="${1:-}" token="${2:-}" transport="${3:-wssmux}" profile="${4:-balanced}" remote
      [ -n "$target" ] && [ -n "$token" ] || die "estefade: ratholenode backhaul on <domain|host:port> <token> [wssmux|wss|wsmux|ws] [profile]"
      echo "$target" | grep -qE '^[A-Za-z0-9_.-]+(:[0-9]{1,5})?$' || die "endpoint namotabar ast."
      echo "$token" | grep -qE '^[A-Za-z0-9._=+/-]+$' || die "token namotabar ast."
      # domain-e bedoon port = masir-e ghadimi TLS/443; endpoint-e port-dar mitavanad direct-IP bashad.
      case "$transport" in
        wss|wssmux) remote="$target"; echo "$target" | grep -q ':' || remote="${target}:443" ;;
        ws|wsmux) echo "$target" | grep -q ':' || die "baraye backhaul direct-IP bedoon TLS endpoint bayad host:port bashad."; remote="$target" ;;
        *) die "transport: wss|wssmux|ws|wsmux (tcpmux mojaz nist)." ;;
      esac
      # profile bayad ba samt-e Iran YEKSAN bashad vagarna parametrhaye SMUX nemikhanand.
      backhaul_mux_profile "$profile" >/dev/null || die "profile namotabar (balanced|lossy|aggressive)."
      install_backhaul client

      local env_bak="" cli_bak="" bh_toml_bak="" bh_unit_bak="" had_bh_unit=0 had_bh_toml=0
      if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
      if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi
      if [ -f "$BH_TOML" ]; then bh_toml_bak="$(rth_mktemp)" || return 1; cp -a "$BH_TOML" "$bh_toml_bak" || return 1; had_bh_toml=1; fi
      if [ -f "$BH_CLI_UNIT" ]; then bh_unit_bak="$(rth_mktemp)" || return 1; cp -a "$BH_CLI_UNIT" "$bh_unit_bak" || return 1; had_bh_unit=1; fi

      _bh_on_rollback(){
        [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
        [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
        if [ "$had_bh_toml" -eq 1 ] && [ -n "$bh_toml_bak" ] && [ -f "$bh_toml_bak" ]; then
          cp -a "$bh_toml_bak" "$BH_TOML" 2>/dev/null || true
        else
          rm -f "$BH_TOML" 2>/dev/null || true
        fi
        if [ "$had_bh_unit" -eq 1 ] && [ -n "$bh_unit_bak" ] && [ -f "$bh_unit_bak" ]; then
          cp -a "$bh_unit_bak" "$BH_CLI_UNIT" 2>/dev/null || true
        else
          systemctl stop "$BH_CLI_SVC" 2>/dev/null || true
          systemctl disable "$BH_CLI_SVC" 2>/dev/null || true
          rm -f "$BH_CLI_UNIT" 2>/dev/null || true
        fi
        systemctl daemon-reload 2>/dev/null || true
        rm -f "$env_bak" "$cli_bak" "$bh_toml_bak" "$bh_unit_bak" 2>/dev/null || true
        systemctl enable "$SVC" 2>/dev/null || true
        restart_svc 2>/dev/null || true
      }

      env_set BH_REMOTE_ADDR "$remote"
      safe_kv_del "$ENV_FILE" BH_REMOTE
      env_set BH_TOKEN "$token"
      env_set BH_TRANSPORT "$transport"
      env_set BH_PROFILE "$profile"
      env_set TUNNEL backhaul
      if ! gen_backhaul_client_toml || ! gen_backhaul_client_unit; then
        _bh_on_rollback
        err "sakht-e config ya unit-e backhaul shekast khord"
        return 1
      fi
      if ! systemctl daemon-reload; then
        _bh_on_rollback
        err "daemon-reload shekast khord"
        return 1
      fi
      if ! systemctl enable "$BH_CLI_SVC" >/dev/null 2>&1; then
        _bh_on_rollback
        err "enable-e $BH_CLI_SVC shekast khord"
        return 1
      fi
      if ! systemctl restart "$BH_CLI_SVC" 2>/dev/null || ! systemctl is-active --quiet "$BH_CLI_SVC"; then
        _bh_on_rollback
        err "start $BH_CLI_SVC shekast khord; log: journalctl -u $BH_CLI_SVC -n 30 --no-pager"
        return 1
      fi
      log "$BH_CLI_SVC start shod (mux → ${remote}, transport=${transport}, profile=${profile})."

      case "$transport" in
        ws|wsmux) warn "in masir TLS nadarad؛ baraye ramznegari/camouflage az wss/wssmux ya Noise estefade kon." ;;
        wss|wssmux)
          echo "$remote" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}:' && \
            warn "TLS be IP-e khali: gvahi verify NEMISHAVAD — ramz dar barabar-e shenod-e ghayr-faal bargharar ast، vali MITM-e faal daf nemishavad." ;;
      esac
      # backhaul JAYGOZIN-e kamel-e tunnel-e rathole baraye in node ast:
      systemctl disable --now "$SVC" 2>/dev/null || true
      log "$SVC khamoosh shod (backhaul jaygozin-e tunnel shod)."
      warn "rooye Iran motmaen shv 'ratholectl backhaul on' zade shode va in node ba 'ratholectl backhaul node <name> on' faal ast."
      rm -f "$env_bak" "$cli_bak" "$bh_toml_bak" "$bh_unit_bak" 2>/dev/null || true
      ;;
    off)
      local env_bak="" cli_bak="" bh_toml_bak="" bh_unit_bak="" had_bh_unit=0 had_bh_toml=0
      if [ -f "$ENV_FILE" ]; then env_bak="$(rth_mktemp)" || return 1; cp -a "$ENV_FILE" "$env_bak" || return 1; fi
      if [ -f "$CLIENT_TOML" ]; then cli_bak="$(rth_mktemp)" || return 1; cp -a "$CLIENT_TOML" "$cli_bak" || return 1; fi
      if [ -f "$BH_TOML" ]; then bh_toml_bak="$(rth_mktemp)" || return 1; cp -a "$BH_TOML" "$bh_toml_bak" || return 1; had_bh_toml=1; fi
      if [ -f "$BH_CLI_UNIT" ]; then bh_unit_bak="$(rth_mktemp)" || return 1; cp -a "$BH_CLI_UNIT" "$bh_unit_bak" || return 1; had_bh_unit=1; fi

      _bh_off_rollback(){
        [ -n "$env_bak" ] && [ -f "$env_bak" ] && cp -a "$env_bak" "$ENV_FILE" 2>/dev/null || true
        [ -n "$cli_bak" ] && [ -f "$cli_bak" ] && cp -a "$cli_bak" "$CLIENT_TOML" 2>/dev/null || true
        if [ "$had_bh_toml" -eq 1 ] && [ -n "$bh_toml_bak" ] && [ -f "$bh_toml_bak" ]; then
          cp -a "$bh_toml_bak" "$BH_TOML" 2>/dev/null || true
        fi
        if [ "$had_bh_unit" -eq 1 ] && [ -n "$bh_unit_bak" ] && [ -f "$bh_unit_bak" ]; then
          cp -a "$bh_unit_bak" "$BH_CLI_UNIT" 2>/dev/null || true
          systemctl daemon-reload 2>/dev/null || true
          systemctl enable "$BH_CLI_SVC" 2>/dev/null || true
          systemctl restart "$BH_CLI_SVC" 2>/dev/null || true
        fi
        rm -f "$env_bak" "$cli_bak" "$bh_toml_bak" "$bh_unit_bak" 2>/dev/null || true
      }

      systemctl stop "$BH_CLI_SVC" 2>/dev/null || true
      systemctl disable "$BH_CLI_SVC" 2>/dev/null || true
      rm -f "$BH_CLI_UNIT" "$BH_TOML"
      if ! systemctl daemon-reload; then
        _bh_off_rollback
        err "daemon-reload shekast khord"
        return 1
      fi
      # pak kardan env-haye backhaul az node.env
      safe_kv_del "$ENV_FILE" BH_REMOTE BH_REMOTE_ADDR BH_TOKEN BH_TRANSPORT BH_PROFILE
      # bargasht be tunnel-e pishfarz (ws/443) va roshan kardan-e dobare-ye rathole-client.
      env_set TUNNEL ws
      if ! gen_client || ! restart_svc; then
        _bh_off_rollback
        err "bargasht be rathole-client shekast khord؛ amaliat rollback shod."
        return 1
      fi
      rm -f "$env_bak" "$cli_bak" "$bh_toml_bak" "$bh_unit_bak" 2>/dev/null || true
      log "backhaul client khamoosh va hazf shod; tunnel be ws/443 bargasht."
      warn "rooye Iran ham 'ratholectl backhaul node <name> off' ra bezan ta service dobare be server.toml bargardad."
      ;;
    status)
      load_env
      if systemctl is-active --quiet "$BH_CLI_SVC"; then
        echo "backhaul client: $(c_g 'active')  → ${BH_REMOTE_ADDR:-${BH_REMOTE:-?}:443} (transport=${BH_TRANSPORT:-wssmux}, profile=${BH_PROFILE:-balanced})"
      else
        echo "backhaul client: $(c_y 'inactive')"
      fi
      ;;
    logs)
      journalctl -u "$BH_CLI_SVC" -n "${1:-40}" --no-pager 2>/dev/null || true
      ;;
    *) die "estefade: ratholenode backhaul <on <domain|host:port> <token> [transport] [profile]|off|status|logs>" ;;
  esac
}

