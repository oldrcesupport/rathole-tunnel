# ---------- control-path: namayesh va rotate-e masir-e makhfi WebSocket ----------
cmd_control_path(){
  local sub="${1:-show}"; shift || true
  need_bin jq; ensure_state
  case "$sub" in
    show)
      local p; p="$(jq -r '.control_path // empty' "$STATE" 2>/dev/null)"
      [ -n "$p" ] && echo "control_path=$p" || echo "control_path=(set nashode — aval init ya regen bezan)"
      ;;
    rotate)
      need_root
      local old new
      old="$(jq -r '.control_path // empty' "$STATE" 2>/dev/null)"
      new="/_rh/$(openssl rand -hex 16)"
      local pre_st_bak=""
      if [ -f "$STATE" ]; then
        pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
        if ! cp -a "$STATE" "$pre_st_bak"; then
          rm -f "$pre_st_bak" 2>/dev/null || true
          die "copy snapshot-e state shekast khord."
        fi
      fi
      # masir-e ghabli ra baraye yek dore-ye gozar zakhire mikonim ta node-haye dar-hal-update ghat nakonand
      state_set '.control_path_previous' "${old:-}" str
      state_set '.control_path' "$new" str
      if ! regenerate "$pre_st_bak"; then
        [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
        die "rotate control-path shekast khord va rollback shod."
      fi
      [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
      log "control-path rotate shod: $old → $new"
      warn "hame-ye node-haye vasl-ra ba dastoor-e zir berooz kon:"
      warn "  ratholenode set SERVER <panel-domain>:443  # ya az hub update bezan"
      echo "new_control_path=$new"
      ;;
    *) die "estefade: ratholectl control-path show|rotate" ;;
  esac
}

main(){
  local cmd="${1:-menu}"; shift || true
  case "$cmd" in
    init)   cmd_init "$@" ;;
    add)
      # aval flg-ha ra jodkon, sps positional-ha (name inbound) — ta `add name --api-port N`
      # eshtebahan inbound='--api-port' nashavad.
      local api="" pos=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --api-port) api="${2:-}"; shift 2 || shift;;
          *) pos+=("$1"); shift;;
        esac
      done
      cmd_add "${pos[0]:-}" "${pos[1]:-}" "$api" ;;
    rm)     cmd_rm "${1:-}" ;;
    ls)     cmd_ls ;;
    set)    cmd_set "${1:-}" "${2:-}" ;;
    info)   cmd_info ;;
    status) cmd_status "${1:-}" ;;
    paths)  cmd_paths ;;
    cert)   cmd_cert "${1:-}" "${2:-}" ;;
    ip-cert) cmd_ip_cert "${1:-}" "${2:-}" ;;
    ip-cert-show) cmd_ip_cert_show "${1:-}" ;;
    ip-cert-off) cmd_ip_cert_off ;;
    certs)  cmd_certs ;;
    domain) cmd_domain "$@" ;;
    recover) cmd_recover ;;
    edit)   cmd_edit "$@" ;;

    rename) cmd_rename "${1:-}" "${2:-}" ;;
    rotate) cmd_rotate "${1:-}" ;;
    show)   cmd_show "${1:-}" ;;
    regen)  regenerate ;;
    backup) cmd_backup "${1:-}" ;;
    restore) cmd_restore "${1:-}" ;;
    token)  print_node_install "${1:-}" ;;
    doctor) cmd_doctor ;;
    logs)   cmd_logs "$@" ;;
    tune)   cmd_tune ;;
    fakeweb) cmd_fakeweb "${1:-}" "${2:-}" ;;
    hub)    cmd_hub "${1:-}" "${2:-}" ;;
    kcp)    cmd_kcp "$@" ;;
    plain)  cmd_plain "${1:-}" "${2:-}" ;;
    direct) cmd_direct "$@" ;;
    noise)  cmd_noise "$@" ;;
    backhaul) cmd_backhaul "$@" ;;
    proxy)  cmd_proxy "$@" ;;

    control-path) cmd_control_path "${1:-show}" "$@" ;;
    game)   cmd_game "$@" ;;
    restart)
      need_root
      if systemctl restart "$RATHOLE_SVC"; then
        if systemctl is-active --quiet "$RATHOLE_SVC"; then
          log "$RATHOLE_SVC restart shod (hame tunnelha lhzhai ghat shdnd)."
        else
          die "$RATHOLE_SVC restart shod ama active nist; log: journalctl -u $RATHOLE_SVC -n 30 --no-pager"
        fi
      else
        die "restart-e $RATHOLE_SVC shekast khord; log: journalctl -u $RATHOLE_SVC -n 30 --no-pager"
      fi
      ;;
    enable)
      need_root
      if systemctl enable --now "$RATHOLE_SVC"; then
        if systemctl is-active --quiet "$RATHOLE_SVC"; then
          log "$RATHOLE_SVC faal shod."
        else
          die "$RATHOLE_SVC enable shod ama active nist; log: journalctl -u $RATHOLE_SVC -n 30 --no-pager"
        fi
      else
        die "enable-e $RATHOLE_SVC shekast khord; log: journalctl -u $RATHOLE_SVC -n 30 --no-pager"
      fi
      ;;
    update) cmd_update "${1:-}" ;;
    version|--version|-V) print_version panel ;;
    menu)   menu ;;
    -h|--help|help) usage ;;
    *) err "dstvr nashenakhte: $cmd"; usage; exit 1 ;;
  esac
}

# ---------- ghofl-e state (jelogiri az lost-update / TOCTOU) ----------
_rth_init_lock_path() {
  local default_lock="$1"
  if [ "${RATHOLE_TEST_MODE:-0}" = "1" ]; then
    if [ -z "${RTH_TEST_DIR:-}" ]; then
      err "RATHOLE_TEST_MODE=1 ast vali RTH_TEST_DIR tanzim nashodeh ast."
      return 1
    fi
    if [ -n "${RTH_LOCK:-}" ]; then
      case "$RTH_LOCK" in
        "${RTH_TEST_DIR}"* )
          if [[ "$RTH_LOCK" == *".."* ]]; then
            err "RTH_LOCK nabayad shamel .. bashad: $RTH_LOCK"
            return 1
          fi
          ;;
        * )
          err "RTH_LOCK dar test mode bayad zir-e RTH_TEST_DIR ($RTH_TEST_DIR) bashad: $RTH_LOCK"
          return 1
          ;;
      esac
    else
      RTH_LOCK="${RTH_TEST_DIR}/$(basename "$default_lock")"
    fi
  else
    if [ -n "${RTH_LOCK:-}" ]; then
      err "RTH_LOCK az mohit dar halat-e production ghabool nist (fail-closed): $RTH_LOCK"
      return 1
    fi
    RTH_LOCK="$default_lock"
  fi
  return 0
}

rth_with_lock(){
  if ! _rth_init_lock_path "/run/ratholectl.lock"; then
    return 1
  fi

  local lockdir; lockdir="$(dirname "$RTH_LOCK")"
  if [ -L "$lockdir" ]; then
    err "directory-e ghofl yek symlink ast: $lockdir (fail-closed)."
    return 1
  fi
  if [ -L "$RTH_LOCK" ]; then
    err "file-e ghofl yek symlink ast: $RTH_LOCK (fail-closed)."
    return 1
  fi
  if [ -d "$RTH_LOCK" ]; then
    err "file-e ghofl yek directory ast: $RTH_LOCK (fail-closed)."
    return 1
  fi
  if [ -e "$RTH_LOCK" ] && [ ! -f "$RTH_LOCK" ]; then
    err "file-e ghofl yek file-e adi nist: $RTH_LOCK (fail-closed)."
    return 1
  fi

  if ! mkdir -p "$lockdir" 2>/dev/null && [ ! -d "$lockdir" ]; then
    local uid; uid="$(id -u 2>/dev/null || echo 0)"
    local udir="${TMPDIR:-/tmp}/rth-run-${uid}"
    if [ -L "$udir" ]; then
      err "directory-e ghofl-e fallback yek symlink ast: $udir (fail-closed)."
      return 1
    fi
    mkdir -m 700 -p "$udir" 2>/dev/null || true
    if [ -d "$udir" ] && [ -O "$udir" ] && [ ! -L "$udir" ]; then
      RTH_LOCK="${udir}/ratholectl.lock"
      lockdir="$udir"
    else
      err "nemitoonam directory-e ghofl ra besazam: $lockdir (fail-closed)."
      return 1
    fi
  fi

  local timeout_sec="${RTH_LOCK_TIMEOUT:-30}"
  case "$timeout_sec" in
    ''|*[!0-9]*) timeout_sec=30 ;;
    *) [ "$timeout_sec" -gt 0 ] 2>/dev/null || timeout_sec=30 ;;
  esac

  if command -v flock >/dev/null 2>&1; then
    # BEHRANI: baz kardan fd 9 ba >> (append) baraye jelogiri az truncate shodan-e file.
    # agar baz kardan fd 9 shekast bokhorad, bayad FAIL-CLOSED konad.
    if ! { exec 9>>"$RTH_LOCK"; } 2>/dev/null; then
      err "baz kardan-e file-e ghofl shekast khord: $RTH_LOCK; amaliat baraye jelogiri az race condition motavaghef shod."
      return 1
    fi
    if [ -L "$RTH_LOCK" ]; then
      err "file-e ghofl pas az baz kardan symlink tashkhis dadeh shod: $RTH_LOCK (fail-closed)."
      exec 9>&-
      return 1
    fi
    if ! flock -w "$timeout_sec" 9; then
      err "ghofl-e state azad nashod (flock timeout ${timeout_sec}s); amaliat baraye jelogiri az race condition motavaghef shod."
      exec 9>&-
      return 1
    fi
    RTH_LOCK_HELD=1
    local rc=0
    "$@" || rc=$?
    RTH_LOCK_HELD=0
    exec 9>&-
    return $rc
  fi

  local d="${RTH_LOCK}.d" i=0 held=0
  local max_tries=$((timeout_sec * 10))
  [ "$max_tries" -ge 1 ] 2>/dev/null || max_tries=1
  while [ "$i" -lt "$max_tries" ]; do
    if mkdir "$d" 2>/dev/null; then held=1; break; fi
    i=$((i+1)); sleep 0.1 2>/dev/null || sleep 1
  done
  if [ "$held" -ne 1 ]; then
    err "ghofl-e state azad nashod (mkdir timeout ${timeout_sec}s); amaliat baraye jelogiri az race condition motavaghef shod."
    return 1
  fi
  RTH_LOCK_HELD=1
  local rc=0
  "$@" || rc=$?
  RTH_LOCK_HELD=0
  rmdir "$d" 2>/dev/null
  return $rc
}

if [ "${RATHOLECTL_LIB_ONLY:-0}" != 1 ]; then rth_with_lock main "$@"; fi
