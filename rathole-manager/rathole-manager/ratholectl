# ---------- dashboard-e kamel-e vaziat (mesl-e panel-e VPN: hameye port-ha/halat-ha/service-ha/node-ha) ----------
# estefade: ratholectl status [--json]
cmd_status(){
  need_bin jq; ensure_state
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1

  # ---- khvandan-e state ----
  local domain ctrl fake sub internal plain_port direct_port direct_header hub_port noise_port bh_port cert_fc cert_key sni_count node_count ip_tls_ip ip_tls_fc
  domain="$(s_get '.domain')"
  ctrl="$(jq -r '.control_port // 2333' "$STATE")"
  fake="$(jq -r '.fake_port // 8080' "$STATE")"
  sub="$(jq -r '.sub_port // 2096' "$STATE")"
  internal="$(jq -r '.internal_port // 8443' "$STATE")"
  plain_port="$(jq -r '.plain_port // empty' "$STATE")"
  direct_port="$(jq -r '.direct_port // empty' "$STATE")"
  direct_header="$(jq -r '.direct_header // "X-Cdn-Id"' "$STATE")"
  hub_port="$(jq -r '.hub_port // empty' "$STATE")"
  noise_port="$(jq -r '.noise_port // empty' "$STATE")"
  bh_port="$(jq -r '.backhaul_port // empty' "$STATE")"
  cert_fc="$(s_get '.cert_fullchain')"; cert_key="$(s_get '.cert_key')"
  ip_tls_ip="$(jq -r '.ip_tls.ip // empty' "$STATE" 2>/dev/null)"
  ip_tls_fc="$(jq -r '.ip_tls.fullchain // empty' "$STATE" 2>/dev/null)"
  sni_count="$(jq '[.nodes[]|select(.sni!=null)]|length' "$STATE" 2>/dev/null)"; sni_count="${sni_count:-0}"
  node_count="$(jq '.nodes|length' "$STATE" 2>/dev/null)"; node_count="${node_count:-0}"

  # ---- cert ----
  local cert_ok="no" cert_exp="-" cert_selfsigned="no"
  if [ -f "$cert_fc" ]; then
    cert_ok="yes"
    if command -v openssl >/dev/null 2>&1; then
      cert_exp="$(openssl x509 -enddate -noout -in "$cert_fc" 2>/dev/null | cut -d= -f2)"; [ -n "$cert_exp" ] || cert_exp="?"
      # self-signed: issuer == subject
      local iss subj; iss="$(openssl x509 -issuer -noout -in "$cert_fc" 2>/dev/null)"; subj="$(openssl x509 -subject -noout -in "$cert_fc" 2>/dev/null)"
      [ -n "$iss" ] && [ "${iss#issuer=}" = "${subj#subject=}" ] && cert_selfsigned="yes"
    fi
  fi

  # ---- service-ha (active/inactive) ----
  _svc_active(){ systemctl is-active --quiet "$1" 2>/dev/null && echo yes || echo no; }
  local svc_server svc_noise svc_bh svc_nginx nginx_ok
  svc_server="$(_svc_active rathole-server)"
  svc_nginx="$(_svc_active nginx)"
  [ -f "/etc/systemd/system/${NOISE_SVC}.service" ] && svc_noise="$(_svc_active "$NOISE_SVC")" || svc_noise="off"
  [ -f "$BH_UNIT" ] && svc_bh="$(_svc_active "$BH_SVC")" || svc_bh="off"
  nginx -t >/dev/null 2>&1 && nginx_ok="yes" || nginx_ok="no"

  # ---- transport-e faal ----
  local mode="websocket+TLS (443)"
  [ "$sni_count" -gt 0 ] && mode="game/SNI (443 L4 → panel:$internal)"

  local ip; ip="$(detect_ip)"

  # ---------- khoruji-ye JSON (baraye hub) ----------
  if [ "$as_json" -eq 1 ]; then
    jq -n \
      --arg domain "$domain" --arg ip "$ip" --arg mode "$mode" \
      --argjson ctrl "${ctrl:-2333}" --argjson fake "${fake:-8080}" --argjson sub "${sub:-2096}" \
      --argjson internal "${internal:-8443}" \
      --arg plain "${plain_port:-}" --arg direct "${direct_port:-}" --arg dhdr "$direct_header" \
      --arg hub "${hub_port:-}" --arg noise "${noise_port:-}" --arg backhaul "${bh_port:-}" \
      --arg sub_path "$(sub_path_seg)" --arg hub_path "$(hub_path_seg)" \
      --arg cert_fc "$cert_fc" --arg cert_key "$cert_key" --arg cert_ok "$cert_ok" \
      --arg cert_exp "$cert_exp" --arg cert_ss "$cert_selfsigned" \
      --arg ip_tls_ip "$ip_tls_ip" --arg ip_tls_fc "$ip_tls_fc" \
      --arg svc_server "$svc_server" --arg svc_nginx "$svc_nginx" --arg svc_noise "$svc_noise" \
      --arg svc_bh "$svc_bh" --arg nginx_ok "$nginx_ok" \
      --arg bh_mode "$(jq -r '.backhaul_exposure // "nginx_tls"' "$STATE" 2>/dev/null)" \
      --arg bh_transport "$(jq -r '.backhaul_transport // "wsmux"' "$STATE" 2>/dev/null)" \
      --argjson sni_count "${sni_count:-0}" --argjson node_count "${node_count:-0}" \
      --argjson nodes "$(jq '[.nodes[]|{name, port, inbound_port, api_local_port, sni, transport}]' "$STATE")" \
      '{domain:$domain, public_ip:$ip, transport:$mode,
        ports:{control:$ctrl, fake:$fake, sub:$sub, internal:$internal,
               plain:(if $plain=="" then null else ($plain|tonumber) end),
               direct:(if $direct=="" then null else ($direct|tonumber) end),
               hub:(if $hub=="" then null else ($hub|tonumber) end),
               noise:(if $noise=="" then null else ($noise|tonumber) end),
               backhaul:(if $backhaul=="" then null else ($backhaul|tonumber) end)},
        paths:{sub:$sub_path, hub:$hub_path},
        direct_header:$dhdr,
        cert:{fullchain:$cert_fc, key:$cert_key, exists:$cert_ok, expiry:$cert_exp, self_signed:$cert_ss},
        ip_tls:{configured:($ip_tls_ip!=""),ip:(if $ip_tls_ip=="" then null else $ip_tls_ip end),fullchain:(if $ip_tls_fc=="" then null else $ip_tls_fc end),self_signed:($ip_tls_ip!="")},
        services:{rathole_server:$svc_server, nginx:$svc_nginx, nginx_config_ok:$nginx_ok, noise:$svc_noise, backhaul:$svc_bh},
        features:{plain:{configured:($plain!=""),active:($plain!="" and $svc_nginx=="yes"),port:(if $plain=="" then null else ($plain|tonumber) end)},
                  direct:{configured:($direct!=""),active:($direct!="" and $svc_nginx=="yes"),port:(if $direct=="" then null else ($direct|tonumber) end)},
                  noise:{configured:($noise!=""),active:($svc_noise=="yes"),port:(if $noise=="" then null else ($noise|tonumber) end),encrypted:true},
                  backhaul:{configured:($backhaul!=""),active:($svc_bh=="yes"),port:(if $backhaul=="" then null else ($backhaul|tonumber) end),mode:$bh_mode,transport:$bh_transport,
                            tls:($bh_mode=="nginx_tls" or ($bh_transport|test("^wss"))),
                            encrypted:($bh_mode=="nginx_tls" or ($bh_transport|test("^wss"))),
                            verified:($bh_mode=="nginx_tls")}},
        sni_count:$sni_count, node_count:$node_count, nodes:$nodes}'
    return
  fi

  # ---------- khoruji-ye adami (mesl-e panel-e sabaskripshn) ----------
  local ok no on off; ok="$(c_g '●')"; no="$(c_r '●')"; on="$(c_g 'roshan')"; off="$(c_y 'khamoosh')"
  _yn(){ [ "$1" = yes ] && echo "$ok" || echo "$no"; }
  echo
  echo "$(c_y '════════════ RATHOLE PANEL — STATUS ════════════')"
  printf '  domain      : %s\n' "${domain:-<tanzim nashode>}"
  printf '  public IP   : %s\n' "${ip:-?}"
  printf '  transport   : %s\n' "$mode"
  [ -n "$ip_tls_ip" ] && printf '  IP TLS      : %s (self-signed, trusted-root lazem)\n' "$ip_tls_ip"
  echo
  echo "$(c_y '──── service-ha ────')"
  printf '  %s rathole-server\n'  "$(_yn "$svc_server")"
  printf '  %s nginx  (config: %s)\n' "$(_yn "$svc_nginx")" "$([ "$nginx_ok" = yes ] && c_g 'salem' || c_r 'khata')"
  [ "$svc_noise" != off ] && printf '  %s rathole-noise\n' "$(_yn "$svc_noise")"
  [ "$svc_bh" != off ] && printf '  %s %s (core-e SMUX)\n' "$(_yn "$svc_bh")" "$BH_SVC"
  echo
  echo "$(c_y '──── port-ha ────')"
  printf '  443       %s  vrvdi-ye asli (nginx TLS ya SNI)\n' "$([ "$svc_nginx" = yes ] && c_g '✓' || c_r '✗')"
  printf '  %-9s     kontrol-e rathole (127.0.0.1)\n' "$ctrl"
  printf '  %-9s     sait-e fik/panel (127.0.0.1)\n' "$fake"
  printf '  %-9s     sabaskripshn (127.0.0.1, zir /%s/)\n' "$sub" "$(sub_path_seg)"
  [ "$sni_count" -gt 0 ] && printf '  %-9s     panel-e dakheli (L7 posht-e SNI)\n' "$internal"
  [ -n "$plain_port" ]  && printf '  %-9s     plain (websocket bedoon TLS)\n' "$plain_port"
  [ -n "$direct_port" ] && printf '  %-9s     direct-IP (header: %s)\n' "$direct_port" "$direct_header"
  [ -n "$hub_port" ]    && printf '  %-9s     hub (127.0.0.1, zir /%s/)\n' "$hub_port" "$(hub_path_seg)"
  [ -n "$noise_port" ]  && printf '  %-9s     noise (TCP-e omomi, ramznegari-shode)\n' "$noise_port"
  [ -n "$bh_port" ]     && printf '  %-9s     backhaul (127.0.0.1, SMUX az nginx/443)\n' "$bh_port"
  echo
  echo "$(c_y '──── gvahi (cert) ────')"
  if [ "$cert_ok" = yes ]; then
    printf '  %s mojood — enghza: %s%s\n' "$ok" "$cert_exp" "$([ "$cert_selfsigned" = yes ] && printf ' %s' "$(c_r '(self-signed! gvahi-ye vagheai begir)')" )"
  else
    printf '  %s peyda nashod: %s\n' "$no" "$cert_fc"
    printf '     %s\n' "$(c_r 'nginx rooye 443/TLS bala nemiaiad. begir: ratholectl cert <domain>')"
  fi
  echo
  echo "$(c_y "──── node-ha ($node_count) ────")"
  if [ "$node_count" -eq 0 ]; then
    printf '  (hich node-i ezafe nashode) — ezafe: ratholectl add <name> <inbound>\n'
  else
    printf '  %-14s %-8s %-10s %-9s %-6s %s\n' "NAME" "PORT" "INBOUND" "TRANSPORT" "SNI" "USER URL"
    jq -r '.nodes[]|[.name,(.port|tostring),(.inbound_port|tostring),(.transport//"ws"),(.sni//"-")]|@tsv' "$STATE" |
    while IFS=$'\t' read -r n p ib tr sn; do
      local url; sn="${sn%$'\r'}"
      if [ "$sn" != "-" ] && [ -n "$sn" ]; then url="SNI:$sn"; else url="https://${domain}/${n}"; fi
      printf '  %-14s %-8s %-10s %-9s %-6s %s\n' "$n" "$p" "$ib" "$tr" "$sn" "$url"
    done
  fi
  echo "$(c_y '════════════════════════════════════════════════')"
}

# ---------- grftn gvahi + tanzim damnh (ghir-taamoli, baraye panel) ----------
# estefade: ratholectl cert <domain> [email]   (email khali = bedoon email sabt mishavad)
cmd_ip_cert(){
  need_root; need_bin jq; ensure_state
  local ip="${1:-}" days="${2:-825}" dir fc key
  echo "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || die "IP v4 namotabar ast. estefade: ratholectl ip-cert <IPv4> [days]"
  command -v python3 >/dev/null 2>&1 || die "python3 lazem ast."
  python3 - "$ip" <<'PY' || die "IP v4 namotabar ast."
import ipaddress, sys
ipaddress.IPv4Address(sys.argv[1])
PY
  echo "$days" | grep -qE '^[0-9]{1,5}$' || die "days bayad adad bashad."
  [ "$days" -ge 1 ] && [ "$days" -le 3650 ] || die "days bayad bein 1 ta 3650 bashad."
  command -v openssl >/dev/null 2>&1 || die "openssl lazem ast."
  dir="/etc/rathole-manager/ip-tls/${ip}"
  fc="$dir/fullchain.pem"; key="$dir/privkey.pem"
  mkdir -p "$dir"; chmod 700 "$dir"
  if [ ! -s "$fc" ] || [ ! -s "$key" ]; then
    openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days "$days" \
      -subj "/CN=$ip" -addext "subjectAltName=IP:$ip" -addext "keyUsage=digitalSignature,keyEncipherment" \
      -addext "extendedKeyUsage=serverAuth" -keyout "$key" -out "$fc" >/dev/null 2>&1 \
      || die "sakht-e gvahi self-signed shekast khord."
    chmod 600 "$key"; chmod 644 "$fc"
  fi
  openssl x509 -in "$fc" -noout -checkip "$ip" >/dev/null 2>&1 || die "gvahi SAN-e IP=$ip nadarad."
  # Bare-IP TLS SNI-e ghabel-eteka nadarad; cert-e IP bayad default_server bashad. agar
  # config-e digari default-e 443 ast, faal-sazi ra rad kon ta nginx crash-loop nasazad.
  local sni_count ext_default=0
  sni_count="$(jq '[.nodes[]|select(.sni!=null)]|length' "$STATE" 2>/dev/null)"; sni_count="${sni_count:-0}"
  if [ "$sni_count" -eq 0 ] && grep -rlsE 'listen[^;]*\bdefault_server\b' /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null \
       | grep -vxF "$NGINX_CONF" | grep -q .; then ext_default=1; fi
  [ "$ext_default" -eq 0 ] || die "yek nginx default_server-e digar rooye 443 faal ast; aval tadakhol ra bartaraf kon."
  local pre_st_bak=""
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi
  if ! rth_state_tx --arg ip "$ip" --arg fc "$fc" --arg key "$key" \
     '.ip_tls = {ip:$ip, fullchain:$fc, key:$key, self_signed:true}'; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "zakhire IP TLS dar state shekast khord."
  fi
  if ! regenerate "$pre_st_bak"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "faalsazi IP TLS shekast khord va rollback shod."
  fi
  [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
  log "WSS-e self-signed baraye IP=$ip faal shod; domain/cert-e asli dast-nakhorde mand."
  echo "public_cert: $fc"
  echo "private_key: $key (faghat rooye Iran; be node copy nakon)"
}

