# ---------- tvlid backhaul-server.toml (core-e joda-ye Go ba SMUX, posht-e nginx/443) ----------
# backhaul rooye 127.0.0.1 gush midahad; nginx masirhaye /channel va /tunnel ra be an proxy mikonad
# (haman masirhaye hardcode-shode-ye client-e backhaul) → tak-port 443 / tak-domain hefz mishavad.
# 'ports' ba format "127.0.0.1:<port_iran>=<inbound_port_node>": backhaul ru-ye port-e mahalli-ye
# Iran listen mikonad (haman porti ke nginx map be an eshare darad) va be inbound-e node forward mikonad.
# in daghighan hamon naghshi ast ke rathole ba bind_addr dasht — pas node-e backhaul az server.toml hazf mishavad.
gen_backhaul_server_toml(){
  local bport transport token profile exposure bind muxcon muxver muxframe muxrecv muxstream
  bport="$(jq -r '.backhaul_port // empty' "$STATE" 2>/dev/null)"
  [ -n "$bport" ] && [ "$bport" != null ] || return 0   # backhaul khamoosh: toml nemisazim
  # TLS faghat ru-ye nginx terminate mishavad — pas server hamishe variant-e bedoon-e TLS ast (ws/wsmux).
  # client (node) variant-e TLS-dar (wss/wssmux) ra be nginx:443 mizanad. bebin: backhaul_client_transport.
  transport="$(jq -r '.backhaul_transport // "wsmux"' "$STATE" 2>/dev/null)"
  exposure="$(jq -r '.backhaul_exposure // "nginx_tls"' "$STATE" 2>/dev/null)"
  bind="127.0.0.1"; [ "$exposure" = "direct_ip" ] && bind="0.0.0.0"
  token="$(jq -r '.backhaul_token // empty' "$STATE" 2>/dev/null)"
  profile="$(jq -r '.backhaul_profile // "balanced"' "$STATE" 2>/dev/null)"
  # 'connection_pool' (field-e akhar) faghat samt-e client mani darad — inja dor rikhte mishavad.
  read -r muxcon muxver muxframe muxrecv muxstream _ <<<"$(backhaul_mux_profile "$profile")"
  # wss/wssmux faghat dar halat-e direct_ip mani darad (nginx dar masir nist، pas KHOD-e backhaul
  # TLS ra terminate mikonad). backhaul in do field ra baraye an transport-ha ELZAMI midanad.
  local tls_fc="" tls_key=""
  case "$transport" in
    wss|wssmux)
      tls_fc="$(jq -r '.ip_tls.fullchain // empty' "$STATE" 2>/dev/null)"
      tls_key="$(jq -r '.ip_tls.key // empty' "$STATE" 2>/dev/null)"
      { [ -n "$tls_fc" ] && [ -n "$tls_key" ] && [ -f "$tls_fc" ] && [ -f "$tls_key" ]; } || \
        die "backhaul ba '${transport}' be gvahi-ye IP niaz darad vali peyda nashod؛ ejra kon: ratholectl ip-cert <IPv4>"
      ;;
  esac
  {
    echo "# tvlid khodkar tvst ratholectl — dasti virayesh nakon (core=backhaul, transport=${transport})"
    echo "[server]"
    echo "bind_addr = \"${bind}:${bport}\""
    echo "transport = \"${transport}\""
    echo "token = \"${token}\""
    if [ -n "$tls_fc" ]; then
      echo "tls_cert = \"${tls_fc}\""
      echo "tls_key = \"${tls_key}\""
    fi
    echo "heartbeat = 40"
    echo "channel_size = 2048"
    echo "mux_con = ${muxcon:-8}"
    echo "mux_version = ${muxver:-1}"
    echo "mux_framesize = ${muxframe:-32768}"
    echo "mux_recievebuffer = ${muxrecv:-4194304}"
    echo "mux_streambuffer = ${muxstream:-65536}"
    echo "nodelay = true"
    echo "log_level = \"info\""
    echo "web_port = 0"
    echo
    echo "ports = ["
    # data-service: Iran ru-ye 127.0.0.1:<port> listen → node ru-ye <inbound_port>.
    # api-service (agar --api-port dashte bashad): 127.0.0.1:<api_local_port> → <api_inbound_port>.
    jq -r '.nodes[] | select((.transport // "") == "backhaul")
           | ("127.0.0.1:" + (.port|tostring) + "=" + (.inbound_port|tostring)),
             (select(.api_local_port != null)
              | "127.0.0.1:" + (.api_local_port|tostring) + "=" + (.api_inbound_port|tostring))' \
       "$STATE" 2>/dev/null | while read -r mapping; do
      # CR-e entehai ra pak kon (jq-e vindozi CRLF midahad) vagarna TOML-e namotabar tolid
      # mishavad va backhaul KOLL-e config ra rad mikonad.
      mapping="${mapping%$'\r'}"
      [ -n "$mapping" ] && printf '  "%s",\n' "$mapping"
    done
    echo "]"
  } > "$BH_TOML.tmp"
  rth_commit_config "$BH_TOML.tmp" "$BH_TOML"
}

# ---------- etminan az vojood map erteghaye websocket dar conf.d ----------
ensure_upgrade_map(){
  local nconf_dir; nconf_dir="$(dirname "$NGINX_CONF")"
  local f="${UPGRADE_MAP_CONF:-$nconf_dir/rathole-upgrade-map.conf}"
  if [ ! -f "$f" ]; then
    mkdir -p "$(dirname "$f")" 2>/dev/null || true
    cat > "$f" <<'MAP'
# lazem baraye WebSocket/HTTPUpgrade
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
MAP
  fi
}

# ---------- tvlid config nginx ----------
gen_nginx_conf(){
  ensure_upgrade_map
  local domain cert_fc cert_key ctrl fake sub sub_seg
  domain="$(s_get '.domain')";       cert_fc="$(s_get '.cert_fullchain')"
  cert_key="$(s_get '.cert_key')";   ctrl="$(s_get '.control_port')"
  fake="$(s_get '.fake_port')";      sub="$(s_get '.sub_port')"
  sub_seg="$(sub_path_seg)"
  # mghavmsazi: agar mghdari khali/null bvd, pishfarz amn bgzar ta map motabar bmand
  case "$ctrl" in ''|null) ctrl=2333 ;; esac
  case "$fake" in ''|null) fake=8080 ;; esac
  case "$sub"  in ''|null) sub=2096 ;; esac
  [ -n "$domain" ] && [ "$domain" != null ] || die "state naghes ast (domain khali). dvbarh init bezan."
  local internal sni_count listen_line
  internal="$(jq -r '.internal_port // 8443' "$STATE" 2>/dev/null)"; case "$internal" in ''|null) internal=8443 ;; esac
  sni_count="$(jq '[.nodes[]|select(.sni!=null)]|length' "$STATE" 2>/dev/null)"; [ -n "$sni_count" ] || sni_count=0
  if [ "$sni_count" -gt 0 ]; then listen_line="listen 127.0.0.1:${internal} ssl http2;"; else listen_line="listen 443 ssl http2;"; fi
  # damnhhaye ezafi bedoon http2 (jelogiri az hoshdar duplicate listen option)
  local listen_line_extra="${listen_line/ http2/}"
  # WSS-e bare-IP SNI-e ghabel-eteka nadarad; pas cert-e IP bayad default-e hamin listener
  # bashad. domain-ha ba SNI server-block-e khod ra migirand va cert-e omoomi hefz mishavad.
  local ip_tls_ip ip_tls_fc ip_tls_key listen_line_ip="" ip_tls_block=""
  ip_tls_ip="$(jq -r '.ip_tls.ip // empty' "$STATE" 2>/dev/null)"
  ip_tls_fc="$(jq -r '.ip_tls.fullchain // empty' "$STATE" 2>/dev/null)"
  ip_tls_key="$(jq -r '.ip_tls.key // empty' "$STATE" 2>/dev/null)"
  if [ -n "$ip_tls_ip" ] && [ -n "$ip_tls_fc" ] && [ -n "$ip_tls_key" ]; then
    [ -f "$ip_tls_fc" ] && [ -f "$ip_tls_key" ] || die "gvahi IP TLS peyda nashod: $ip_tls_fc / $ip_tls_key"
    if [ "$sni_count" -gt 0 ]; then
      listen_line_ip="listen 127.0.0.1:${internal} ssl default_server;"
    else
      listen_line_ip="listen 443 ssl http2 default_server;"
    fi
  fi
  # damnh asli default_server ast magar IP TLS faal bashad. agar default-e khareji vojood
  # darad, be an dast nemizanim; cmd_ip_cert ghabl az faal-sazi in tadakhol ra rad mikonad.
  local listen_line_primary="$listen_line"
  if [ "$sni_count" -eq 0 ] && [ -z "$listen_line_ip" ]; then
    local ext_default=0
    if grep -rlsE 'listen[^;]*\bdefault_server\b' /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null \
         | grep -vxF "$NGINX_CONF" | grep -q .; then ext_default=1; fi
    [ "$ext_default" -eq 0 ] && listen_line_primary="listen 443 ssl http2 default_server;"
  fi

  # location ekhtiari baraye panel web (paidar dar brabr regen)
  local hub_port hub_seg hub_block=""
  hub_port="$(jq -r '.hub_port // empty' "$STATE" 2>/dev/null)"
  hub_seg="$(hub_path_seg)"
  if [ -n "$hub_port" ] && [ "$hub_port" != null ]; then
    hub_block="$(cat <<HB

    location /${hub_seg}/ {
        proxy_pass http://127.0.0.1:${hub_port}/;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_read_timeout 3600s;
    }
HB
)"
  fi
  # blc-e backhaul: masirhaye hardcode-shode-ye client (/channel control, /tunnel data) ra be
  # backhaul-server (127.0.0.1) proxy miknd. fght vqti backhaul roshan ast. WS-upgrade + Authorization pass.
  local bh_port bh_exposure bh_block=""
  bh_port="$(jq -r '.backhaul_port // empty' "$STATE" 2>/dev/null)"
  bh_exposure="$(jq -r '.backhaul_exposure // "nginx_tls"' "$STATE" 2>/dev/null)"
  if [ -n "$bh_port" ] && [ "$bh_port" != null ] && [ "$bh_exposure" = "nginx_tls" ]; then
    bh_block="$(cat <<BHB

    # backhaul core (SMUX): control channel — client /channel ra seda miznad
    location = /channel {
        proxy_pass http://127.0.0.1:${bh_port};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host \$host;
        proxy_buffering off;
        proxy_request_buffering off;
        tcp_nodelay on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # backhaul core (SMUX): data tunnels — client /tunnel/<rand> ra seda miznad (prefix)
    location /tunnel {
        proxy_pass http://127.0.0.1:${bh_port};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host \$host;
        proxy_buffering off;
        proxy_request_buffering off;
        tcp_nodelay on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
BHB
)"
  fi
  # ---- reverse-proxy-haye gheyre-tunnel ----
  # masir-haye /<name>/ ke be yek upstream-e DELKHAH proxy mishavand (na az tarigh-e rathole).
  # baraye tunnel-ha/service-haye kastom ke khodeshan mostaghel balaand.
  # upstream dar cmd_proxy ba regex mahdud shode (faghat scheme://host:port) — inja
  # dobare check nemikonim vali HICH vorodi-ye digari be conf tazrigh nemishavad.
  local proxy_block=""
  if jq -e '(.proxies // []) | length > 0' "$STATE" >/dev/null 2>&1; then
    proxy_block="$(jq -r '.proxies[] | [.name, .upstream] | @tsv' "$STATE" 2>/dev/null |
      while IFS=$'\t' read -r pn pu; do
        pn="${pn%$'\r'}"; pu="${pu%$'\r'}"
        [ -n "$pn" ] && [ -n "$pu" ] || continue
        cat <<PXB

    # reverse-proxy (gheyre-tunnel): /${pn}/ -> ${pu}
    location /${pn}/ {
        proxy_pass ${pu}/;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
PXB
      done)"
  fi
  {
    echo "# tvlid khodkar tvst ratholectl — dasti virayesh nakon"
    echo "# masir(path) dita -> port lvkal rathole"
    echo "map \$uri \$node_raw_port {"
    echo "    default      ${fake};"
    jq -r '.nodes[] | select(.sni == null) | [.name,(.port|tostring)] | @tsv' "$STATE" |
    while IFS=$'\t' read -r n p; do
      n="${n%$'\r'}"; p="${p%$'\r'}"
      printf '    "~^/%s($|/)"   %s;\n' "$n" "$p"
    done
    echo "}"
    echo
    echo "# probe defense: poshtibani az WebSocket (ws) va XHTTP (splithttp) dar kenar-e dafa dar barabar-e probe"
    echo "map \$uri \$is_sub_req {"
    echo "    default      0;"
    echo "    \"~^/${sub_seg}($|/)\"   1;"
    echo "}"
    echo
    echo "# tashkhis-e darkhast-e tunnel (WebSocket ya XHTTP stream)"
    echo "map \"\$http_upgrade:\$request_method:\$content_type\" \$is_tunnel_req {"
    echo "    \"~*^websocket:\"         1;"
    echo "    \"~*:POST:\"              1;"
    echo "    \"~*:.*octet-stream\"     1;"
    echo "    \"~*:.*xhttp\"            1;"
    echo "    default                  0;"
    echo "}"
    echo
    echo "map \"\$is_tunnel_req:\$is_sub_req\" \$backend_port {"
    echo "    \"1:0\"        \$node_raw_port;"
    echo "    \"1:1\"        \$node_raw_port;"
