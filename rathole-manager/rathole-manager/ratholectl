cmd_game_add(){
  local name="${1:-}" inbound="${2:-}" sni="${3:-}"
  [ -n "$name" ] && [ -n "$inbound" ] && [ -n "$sni" ] || die "estefade: ratholectl game add <name> <node_tls_inbound_port> <sni>"
  echo "$name" | grep -qE '^[a-zA-Z0-9_-]+$' || die "name namotabar."
  is_reserved_name "$name" && die "name '$name' rezerv shode; name-e digari entekhab kon."
  echo "$inbound" | grep -qE '^[0-9]+$' || die "inbound bayad adad bashad."
  is_valid_port "$inbound" || die "inbound bayad beyn 1 ta 65535 bashad: $inbound"
  # sni mostaghim daroon-e config-e nginx stream neveshte mishavad (gen_stream_conf);
  # hatman ba regex-e hostname mahdood shavad (ejaze-ye '*.' baraye wildcard) ta tzrigh nashavad.
  echo "$sni" | grep -qE '^(\*\.)?[A-Za-z0-9_.-]+$' || die "sni namotabar (faghat harf/adad/nghth/khttirh, ya '*.' baraye wildcard)."
  jq -e --arg n "$name" '.nodes[]|select(.name==$n)' "$STATE" >/dev/null && die "node '$name' vojood darad."
  local dstart dport token
  dstart="$(s_get '.data_port_start')"; dport="$(next_port port "$dstart")"; token="$(gen_token)"
  local pre_game_state; pre_game_state="$(rth_mktemp)" || die "sakht-e temp file baraye state shekast khord."
  cp -a "$STATE" "$pre_game_state"
  rth_state_tx --arg n "$name" --argjson p "$dport" --argjson ib "$inbound" --arg t "$token" --arg s "$sni" \
    '.nodes += [{name:$n, port:$p, inbound_port:$ib, token:$t, sni:$s}]' || { rm -f "$pre_game_state"; die "afzoodan-e service game be state shekast khord."; }
  log "service game '$name' ezafe shod (SNI=$sni → data 127.0.0.1:$dport , node inbound :$inbound)."
  warn "443 hala stream/SNI shd; L7 fali rooye port dakhli mntghl shod (karbaran path dstnkhvrdh)."
  if ! regenerate "$pre_game_state"; then
    rm -f "$pre_game_state" 2>/dev/null || true
    die "regenerate baraye game '$name' shekast khord; amaliat rollback shod."
  fi
  rm -f "$pre_game_state" 2>/dev/null || true
  print_game_install "$name"
}

cmd_game_rm(){
  local name="${1:-}"
  [ -n "$name" ] || die "estefade: ratholectl game rm <name>"
  jq -e --arg n "$name" '.nodes[]|select(.name==$n and .sni!=null)' "$STATE" >/dev/null || die "service game '$name' peyda nashod."
  local pre_game_state; pre_game_state="$(rth_mktemp)" || die "sakht-e temp file baraye state shekast khord."
  if ! cp -a "$STATE" "$pre_game_state"; then
    rm -f "$pre_game_state" 2>/dev/null || true
    die "copy snapshot-e state shekast khord."
  fi
  if ! rth_state_tx --arg n "$name" '.nodes |= map(select(.name!=$n))'; then
    rm -f "$pre_game_state" 2>/dev/null || true
    die "hazf-e service game az state shekast khord."
  fi
  log "service game '$name' hazf shod."
  if ! regenerate "$pre_game_state"; then
    rm -f "$pre_game_state" 2>/dev/null || true
    die "hazf az state anjam shod ama regenerate ba khata movajeh shod; amaliat rollback shod."
  fi
  rm -f "$pre_game_state" 2>/dev/null || true
}

cmd_game_ls(){
  need_bin jq; ensure_state
  printf '%-14s %-22s %-8s %s\n' "NAME" "SNI" "DATA" "NODE-INBOUND"
  printf '%s\n' "------------------------------------------------------------"
  jq -r '.nodes[] | select(.sni!=null) | [.name,.sni,(.port|tostring),(.inbound_port|tostring)] | @tsv' "$STATE" |
  while IFS=$'\t' read -r n s p ib; do printf '%-14s %-22s %-8s %s\n' "$n" "$s" "$p" "$ib"; done
}

print_game_install(){
  need_bin jq; ensure_state
  local name="$1" node sni token inbound
  node="$(jq -c --arg n "$name" '.nodes[]|select(.name==$n)' "$STATE")"
  [ -n "$node" ] || die "node '$name' peyda nashod."
  sni="$(echo "$node" | jq -r '.sni')"; token="$(echo "$node" | jq -r '.token')"; inbound="$(echo "$node" | jq -r '.inbound_port')"
  echo
  echo "$(c_y '──────── rahandazi service game rooye node ────────')"
  echo "1) gvahi $sni ra rooye node gharar bdh:  ratholectl game cert $sni   (mohtava/dstvr antghal midahad)"
  echo "2) service tunnel ra be haman tunnel ezafe kon:"
  echo "     ratholenode add-svc $name $token $inbound"
  echo "3) web fik sabok baraye fallback:  ratholenode fakeweb start 8081"
  echo "4) inbound Xray node = VLESS+TLS+Vision ba gvahi $sni :"
  echo "     listen=127.0.0.1  port=$inbound  cert=/etc/xray-certs/$sni/{fullchain,privkey}.pem  fallback→8081"
  local d; d="$(s_get '.domain' 2>/dev/null)"; [ -n "$d" ] && [ "$d" != null ] || d="<IRAN_IP>"
  echo "klaint: VLESS  address=${d}  port=443  SNI=${sni}  security=tls  flow=xtls-rprx-vision  fp=chrome"
  echo "$(c_y '────────────────────────────────────────────')"
}

# grftn gvahi baraye SNI rooye in server va amade-sazi antghal be node
cmd_game_cert(){
  need_root
  local sni="${1:-}"
  [ -n "$sni" ] || die "estefade: ratholectl game cert <sni>"
  command -v certbot >/dev/null 2>&1 || die "certbot nasb nist."
  warn "niaz: DNS $sni be hamin server asharh konad va port 80 azad bashad."
  local email; rth_read email "aimil Let's Encrypt (khali=bedoon aimil): "
  local was_active=0
  systemctl is-active --quiet nginx && { was_active=1; systemctl stop nginx; }
  local args=(certonly --standalone --non-interactive --agree-tos -d "$sni")
  if [ -n "$email" ]; then args+=(-m "$email"); else args+=(--register-unsafely-without-email); fi
  local cbt="${RATHOLE_CERTBOT_TIMEOUT:-300}" cb=(certbot)
  command -v timeout >/dev/null 2>&1 && cb=(timeout "$cbt" certbot)
  local ok=0
  if "${cb[@]}" "${args[@]}"; then
    ok=1
  fi
  [ "$was_active" -eq 1 ] && systemctl start nginx || true
  if [ "$ok" -eq 1 ]; then
    local d="/etc/letsencrypt/live/$sni"
    log "gvahi grfth shod: $d"
    echo
    echo "$(c_y '── antghal be node (fght scp amn; hrgz kelid khsvsi ra namayesh ndh) ──')"
    echo "  ssh root@<NODE_IP> 'mkdir -p /etc/xray-certs/$sni'"
    echo "  scp $d/fullchain.pem $d/privkey.pem root@<NODE_IP>:/etc/xray-certs/$sni/"
    echo
    warn "kelid khsvsi dar trminal chap nemishavad (amnit). az scp bala estefade kon."
    warn "baad az antghal, renew ra ba hook tanzim kon ta dvbarh be node copy shavad."
  else
    err "grftn gvahi shekast khord (DNS? port 80?)."
  fi
}

# ---------- namayesh damnh/gvahi (read-only, ghabl parse baraye panel) ----------
cmd_info(){
  need_bin jq; ensure_state
  local domain fc key nconf exp="-" exists="no"
  domain="$(s_get '.domain')"; fc="$(s_get '.cert_fullchain')"
  key="$(s_get '.cert_key')";  nconf="$(s_get '.nginx_conf')"
  if [ -f "$fc" ]; then
    exists="yes"
    if command -v openssl >/dev/null 2>&1; then
      exp="$(openssl x509 -enddate -noout -in "$fc" 2>/dev/null | cut -d= -f2)"
      [ -n "$exp" ] || exp="?"
    fi
  fi
  echo "domain: $domain"
  echo "fullchain: $fc"
  echo "key: $key"
  echo "nginx_conf: $nconf"
  echo "cert_exists: $exists"
  echo "cert_expiry: $exp"
  # damnhhai SNI (game) niz ke rooye hamin 443 stream mishavand
  jq -r '.nodes[] | select(.sni!=null) | "sni: \(.sni)"' "$STATE" 2>/dev/null || true
}

# ---------- list hameye gvahiha (letsencrypt + gvahi asli + extra + SNI) baraye panel ----------
cmd_certs(){
  need_bin jq; ensure_state
  local active mfc le=/etc/letsencrypt/live
  active="$(s_get '.domain')"; mfc="$(s_get '.cert_fullchain')"
  _exp(){ local f="$1" e="-"; command -v openssl >/dev/null 2>&1 && e="$(openssl x509 -enddate -noout -in "$f" 2>/dev/null | cut -d= -f2)"; echo "${e:-?}"; }
  echo "DOMAIN|EXPIRY|ACTIVE|SNI"
  local seen_active=0 d dom fc is_active is_sni
  if [ -d "$le" ]; then
    for d in "$le"/*/; do
      [ -d "$d" ] || continue
      dom="$(basename "$d")"; [ "$dom" = "README" ] && continue
      fc="$d/fullchain.pem"; [ -f "$fc" ] || continue
      if [ "$dom" = "$active" ]; then is_active=yes; seen_active=1
      elif jq -e --arg x "$dom" '(.extra_domains // [])[]|select(.domain==$x)' "$STATE" >/dev/null 2>&1; then is_active=yes
      else is_active=no; fi
      if jq -e --arg sn "$dom" '.nodes[]|select(.sni==$sn)' "$STATE" >/dev/null 2>&1; then is_sni=yes; else is_sni=no; fi
      echo "${dom}|$(_exp "$fc")|${is_active}|${is_sni}"
    done
  fi
  if [ "$seen_active" -eq 0 ] && [ -n "$active" ] && [ "$active" != null ] && [ -f "$mfc" ]; then
    echo "${active}|$(_exp "$mfc")|yes|no"
  fi
}

