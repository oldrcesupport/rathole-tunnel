# taghir tanzimat srasri: ratholectl set <key> <value>
cmd_set(){
  need_root; need_bin jq; ensure_state
  local key="${1:-}" val="${2:-}"
  [ -n "$key" ] && [ -n "$val" ] || die "estefade: ratholectl set <domain|fullchain|key|nginx-conf|fake-port|sub-port|control-port|sub-path|hub-path> <value>"
  local pre_st_bak=""
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi
  case "$key" in
    domain)        state_set '.domain' "$val" str ;;
    fullchain)     state_set '.cert_fullchain' "$val" str ;;
    key)           state_set '.cert_key' "$val" str ;;
    nginx-conf)    state_set '.nginx_conf' "$val" str ;;
    fake-port)     state_set '.fake_port' "$val" num ;;
    sub-port)      state_set '.sub_port' "$val" num ;;
    control-port)  state_set '.control_port' "$val" num ;;
    control-path) state_set '.control_path' "$val" str ;;
    sub-path)      state_set '.sub_path' "$(normalize_path_seg "$val")" str ;;
    hub-path)      state_set '.hub_path' "$(normalize_path_seg "$val")" str ;;
    *) [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true; die "kelid nashenakhte: $key" ;;
  esac
  log "tanzim shod: $key = $val"
  if ! regenerate "$pre_st_bak"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "amaliat-e set shekast khord va rollback shod."
  fi
  [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
}

# virayesh yek node: ratholectl edit <name> [--inbound N] [--api-port N|off]
cmd_edit(){
  need_root; need_bin jq; ensure_state
  local name="${1:-}"; shift || true
  [ -n "$name" ] || die "estefade: ratholectl edit <name> [--inbound N] [--api-port N|off]"
  jq -e --arg n "$name" '.nodes[]|select(.name==$n)' "$STATE" >/dev/null || die "node '$name' peyda nashod."
  local inbound="" api=""
  while [ $# -gt 0 ]; do case "$1" in
    --inbound)  inbound="$2"; shift 2;;
    --api-port) api="$2"; shift 2;;
    *) shift;;
  esac; done

  # etebarsanji avalie-ye hame-ye voroodi-ha (ghabl az har taghiri dar state)
  if [ -n "$inbound" ]; then
    is_valid_port "$inbound" || die "inbound bayad adad beyn 1 ta 65535 bashad: '$inbound'"
  fi
  if [ -n "$api" ] && [ "$api" != "off" ]; then
    is_valid_port "$api" || die "port api bayad adad beyn 1 ta 65535 bashad: '$api'"
  fi

  # sakht-e pipeline-e jq baraye emal-e hamzaman (transaction)
  local jq_filter='(.nodes[] | select(.name==$n)) |= ('
  local jq_args=(--arg n "$name")
  local muts=()

  if [ -n "$inbound" ]; then
    jq_args+=(--argjson ib "$inbound")
    muts+=('.inbound_port = $ib')
  fi

  if [ -n "$api" ]; then
    if [ "$api" = "off" ]; then
      muts+=('del(.api_local_port, .api_inbound_port, .api_token)')
    else
      local has_ap aport atoken astart
      has_ap="$(jq -r --arg n "$name" '.nodes[]|select(.name==$n)|.api_local_port // empty' "$STATE")"
      if [ -z "$has_ap" ]; then
        astart="$(s_get '.api_port_start')"
        aport="$(next_port api_local_port "$astart")"
        atoken="$(gen_token)"
        jq_args+=(--argjson ap "$aport" --argjson aib "$api" --arg at "$atoken")
        muts+=('. + {api_local_port:$ap, api_inbound_port:$aib, api_token:$at}')
      else
        jq_args+=(--argjson aib "$api")
        muts+=('.api_inbound_port = $aib')
      fi
    fi
  fi

  if [ "${#muts[@]}" -eq 0 ]; then
    warn "hich taghiri dade nashod."
    return 0
  fi

  local combined_mut=""
  for m in "${muts[@]}"; do
    if [ -z "$combined_mut" ]; then combined_mut="$m"; else combined_mut="$combined_mut | $m"; fi
  done
  jq_filter="${jq_filter}${combined_mut})"

  local pre_st_bak=""
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi

  # emal-e atomic
  if ! rth_state_tx "${jq_args[@]}" "$jq_filter"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "virayesh-e node shekast khord؛ state dast-nakhorde mand."
  fi
  log "node '$name' virayesh shod."
  if ! regenerate "$pre_st_bak"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "virayesh-e node shekast khord va rollback shod."
  fi
  [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
  print_node_install "$name"
}

