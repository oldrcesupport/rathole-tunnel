    # 4. Restore Main Nginx
    if [ "$had_main" -eq 1 ]; then
      if [ -n "$pre_main_bak" ] && [ -f "$pre_main_bak" ]; then
        cp -a "$pre_main_bak" "$nc" || rb_failed=1
      else
        rb_failed=1
      fi
    fi
    # 5. Restore Server TOML
    if [ "$had_server_toml" -eq 1 ]; then
      if [ -n "$pre_server_toml_bak" ] && [ -f "$pre_server_toml_bak" ]; then
        cp -a "$pre_server_toml_bak" "$SERVER_TOML" || rb_failed=1
      else
        rb_failed=1
      fi
    else
      rm -f "$SERVER_TOML" 2>/dev/null || true
    fi
    # 6. Restore Noise TOML
    if [ "$had_noise_toml" -eq 1 ]; then
      if [ -n "$pre_noise_toml_bak" ] && [ -f "$pre_noise_toml_bak" ]; then
        cp -a "$pre_noise_toml_bak" "$NOISE_TOML" || rb_failed=1
      else
        rb_failed=1
      fi
    else
      rm -f "$NOISE_TOML" 2>/dev/null || true
    fi
    # 7. Restore Noise Unit
    if [ "$had_noise_unit" -eq 1 ]; then
      if [ -n "$pre_noise_unit_bak" ] && [ -f "$pre_noise_unit_bak" ]; then
        cp -a "$pre_noise_unit_bak" "$NOISE_UNIT" || rb_failed=1
      else
        rb_failed=1
      fi
    else
      rm -f "$NOISE_UNIT" 2>/dev/null || true
    fi
    # 8. Restore Backhaul TOML
    if [ "$had_bh_toml" -eq 1 ]; then
      if [ -n "$pre_bh_toml_bak" ] && [ -f "$pre_bh_toml_bak" ]; then
        cp -a "$pre_bh_toml_bak" "$BH_TOML" || rb_failed=1
      else
        rb_failed=1
      fi
    else
      rm -f "$BH_TOML" 2>/dev/null || true
    fi
    # 9. Restore Backhaul Unit
    if [ "$had_bh_unit" -eq 1 ]; then
      if [ -n "$pre_bh_unit_bak" ] && [ -f "$pre_bh_unit_bak" ]; then
        cp -a "$pre_bh_unit_bak" "$BH_UNIT" || rb_failed=1
      else
        rb_failed=1
      fi
    else
      rm -f "$BH_UNIT" 2>/dev/null || true
    fi

    # Daemon-reload if units were touched
    systemctl daemon-reload 2>/dev/null || true

    if [ "$rb_failed" -eq 1 ]; then
      unset RTH_IN_ROLLBACK || true
      err "HOSHDAR-E BOZORG: bazgardandan-e file-haye config/state ba khata movajeh shod!"
      return 1
    fi

    # Try reloading restored config if nginx exists
    if command -v nginx >/dev/null 2>&1; then
      if nginx -t >/dev/null 2>&1; then
        if systemctl reload nginx 2>/dev/null || { systemctl restart nginx 2>/dev/null && systemctl is-active --quiet nginx; }; then
          if ! systemctl is-active --quiet nginx; then
            unset RTH_IN_ROLLBACK || true
            err "HOSHDAR: config ghabli bazgardande shod ama nginx faal nist."
            return 1
          fi
        else
          unset RTH_IN_ROLLBACK || true
          err "HOSHDAR: config ghabli bazgardande shod ama reload-e an shekast khord."
          return 1
        fi
      else
        unset RTH_IN_ROLLBACK || true
        err "HOSHDAR: config-e ghabli ham dar nginx -t khata dad; niaz be barresi-ye dasti darad."
        return 1
      fi
    fi
    unset RTH_IN_ROLLBACK || true
    log "amaliat ba movafaghiat rollback shod (state va config-ha be noskhe-ye ghabli bazgardande shodand)."
    return 0
  }

  if ! gen_server_toml || ! gen_nginx_conf; then
    err "towlid-e config shekast khord; rolling back..."
    _rollback_configs
    _cleanup_snapshots
    return 1
  fi
  log "configha tvlid shdnd ($SERVER_TOML , $out)."

  if command -v nginx >/dev/null 2>&1; then
    local test_log; test_log="$(rth_mktemp)"
    if ! nginx -t 2>"$test_log"; then
      err "nginx -t khata dad; reload nashod:"; cat "$test_log" >&2
      rm -f "$test_log" 2>/dev/null
      err "config ghabli bazgardande mishavad..."
      if _rollback_configs; then
        err "config ghabli ba movafaghiat bazgardande shod (nginx salem mimanad)."
      else
        err "bazgardandan-e config ghabli shekast khord."
      fi
      _cleanup_snapshots
      return 1
    fi
    rm -f "$test_log" 2>/dev/null

    local nginx_reloaded=0
    if systemctl reload nginx 2>/dev/null; then
      if systemctl is-active --quiet nginx; then
        nginx_reloaded=1
      fi
    elif systemctl restart nginx 2>/dev/null; then
      if systemctl is-active --quiet nginx; then
        nginx_reloaded=1
      fi
    fi

    if [ "$nginx_reloaded" -eq 1 ]; then
      log "nginx reload shod va faal ast."
      cp -a "$out" "$out.rathole-good.bak" 2>/dev/null || true
      [ -f "$STREAM_CONF" ] && cp -a "$STREAM_CONF" "$STREAM_CONF.rathole-good.bak" 2>/dev/null || true
      [ -f "$STREAM_CONF" ] || rm -f "$STREAM_CONF.rathole-good.bak" 2>/dev/null
    else
      err "reload va restart-e nginx shekast khord ya service faal nist; rolling back..."
      if _rollback_configs; then
        err "config ghabli ba movafaghiat bazgardande shod."
      else
        err "bazgardandan-e config ghabli shekast khord."
      fi
      _cleanup_snapshots
      return 1
    fi
  fi

  if systemctl is-active --quiet "$RATHOLE_SVC"; then
    log "server.toml berooz shd; rathole khodesh hot-reload mikonad (tunnelhaye faal ghat nmishvnd)."
  else
    if systemctl start "$RATHOLE_SVC" 2>/dev/null && systemctl is-active --quiet "$RATHOLE_SVC"; then
      log "$RATHOLE_SVC start shod."
    else
      err "ntvanstm $RATHOLE_SVC ra start knm ya service faal nashod."
      _rollback_configs
      _cleanup_snapshots
      return 1
    fi
  fi

  # instans-e noise (agar roshan bashad)
  local nport; nport="$(jq -r '.noise_port // empty' "$STATE" 2>/dev/null)"
  if [ -n "$nport" ] && [ "$nport" != null ]; then
    ensure_noise_unit
    gen_noise_server_toml
    log "noise-server.toml berooz shd ($NOISE_TOML)."
    systemctl daemon-reload 2>/dev/null || true
    if ! systemctl enable "$NOISE_SVC" >/dev/null 2>&1; then
      err "enable kardan-e $NOISE_SVC shekast khord."
      _rollback_configs
      _cleanup_snapshots
      return 1
    fi
    if ! systemctl restart "$NOISE_SVC" 2>/dev/null || ! systemctl is-active --quiet "$NOISE_SVC"; then
      err "ntvanstm $NOISE_SVC ra restart knm ya service faal nashod."
      _rollback_configs
      _cleanup_snapshots
      return 1
    fi
    log "$NOISE_SVC restart shod."
  fi

  # instans-e backhaul (agar roshan bashad)
  local bhp; bhp="$(jq -r '.backhaul_port // empty' "$STATE" 2>/dev/null)"
  if [ -n "$bhp" ] && [ "$bhp" != null ]; then
    ensure_backhaul_unit
    gen_backhaul_server_toml
    systemctl daemon-reload 2>/dev/null || true
    if ! systemctl enable "$BH_SVC" >/dev/null 2>&1; then
      err "enable kardan-e $BH_SVC shekast khord."
      _rollback_configs
      _cleanup_snapshots
      return 1
    fi
    if ! systemctl restart "$BH_SVC" 2>/dev/null || ! systemctl is-active --quiet "$BH_SVC"; then
      err "ntvanstm $BH_SVC ra restart knm ya service faal nashod."
      _rollback_configs
      _cleanup_snapshots
      return 1
    fi
    log "$BH_SVC restart shod."
  fi

  _cleanup_snapshots
  return 0
}

