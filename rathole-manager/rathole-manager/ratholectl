# ---------- L4 tst (stream+SNI) mvazi rooye port jda ----------
ensure_stream_include(){
  local nc="${NGINX_MAIN_CONF:-/etc/nginx/nginx.conf}"
  local sdir; sdir="$(dirname "$STREAM_CONF")"
  mkdir -p "$sdir" || { err "sakht-e directory-e stream conf ($sdir) shekast khord."; return 1; }
  [ -f "$nc" ] || return 0
  if command -v dpkg >/dev/null 2>&1 && ! dpkg -s libnginx-mod-stream >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      log "nasb-e libnginx-mod-stream..."
      if ! apt-get update -qq || ! apt-get install -y -qq libnginx-mod-stream; then
        err "nasb-e libnginx-mod-stream shekast khord."
        return 1
      fi
    fi
  fi
  # Idempotent: already includes stream.d/*.conf
  grep -qE 'include[[:space:]]+.+stream\.d/\*\.conf;' "$nc" 2>/dev/null && return 0
  grep -qE 'include[[:space:]]+.+stream\.d/\*\.conf' "$nc" 2>/dev/null && return 0

  local bak="$nc.l4.bak"
  cp -a "$nc" "$bak" || { err "sakht-e backup az $nc shekast khord."; return 1; }
  chmod 600 "$bak" 2>/dev/null || true

  local tmp; tmp="$(rth_mktemp "$(dirname "$nc")")" || { err "sakht-e file-e movaghat baraye $nc shekast khord."; return 1; }

  if grep -qE '^[[:space:]]*stream[[:space:]]*\{' "$nc"; then
    # Inject include inside existing stream { ... } block right after the opening brace
    awk -v sdir="$sdir" '
      /^[[:space:]]*stream[[:space:]]*\{/ {
        print
        print "    include " sdir "/*.conf;"
        next
      }
      { print }
    ' "$nc" > "$tmp" || { rm -f "$tmp"; err "ezafe kardan-e stream include be stream-e mojood shekast khord."; return 1; }
  else
    # Append stream { include ...; } block
    cat "$nc" > "$tmp" || { rm -f "$tmp"; return 1; }
    printf '\nstream {\n    include %s/*.conf;\n}\n' "$sdir" >> "$tmp" || { rm -f "$tmp"; return 1; }
  fi

  if ! mv -f "$tmp" "$nc"; then
    rm -f "$tmp"
    err "jaigozini-e $nc shekast khord."
    return 1
  fi
  log "include-e stream be $nc ezafe shod (backup: $bak)."
  return 0
}

