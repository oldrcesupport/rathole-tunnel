# ---------- kcp/FEC tunnel (mkhfiknndh loss msir; mvazi ba websocket/443) ----------

# kcptun rooye UDP mishnvd va be port kontroli rathole (127.0.0.1:control_port) fvrvard mikonad.
# hich tghiiri dar rathole-server/nginx/443 nmidhd; yek masir vrvdi dovom ezafe mikonad.
KCP_SRV_BIN=/usr/local/bin/kcptun-server
KCP_SRV_UNIT=/etc/systemd/system/rathole-kcp-server.service
# mkhzn asli xtaci/kcptun arshiv shode va bainrihaish hazf shdh; az mirvr ossfork estefade mikonim.
KCPTUN_VER_DEF="v20260129"
KCPTUN_BASE_DEF="https://github.com/ossfork/kcptun/releases/download"

install_kcptun(){ # $1=server|client  → nasb bainri dar /usr/local/bin/kcptun-$1
  local role="$1" bin="/usr/local/bin/kcptun-$1" ver="${KCPTUN_VER:-$KCPTUN_VER_DEF}" base="${KCPTUN_BASE:-$KCPTUN_BASE_DEF}" arch tmp url
  [ -x "$bin" ] && return 0
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; armv7l) arch=armv7 ;; *) die "memari poshtibani nemishavad." ;; esac
  command -v curl >/dev/null 2>&1 || die "curl lazem ast."
  log "download kcptun ${ver} ($role)..."
  tmp="$(rth_mktempd)"
  url="${base}/${ver}/kcptun_linux_${arch}.tar.gz"
  curl -fsSL "$url" -o "$tmp/k.tgz" || { rm -rf "$tmp"; die "download kcptun shekast khord (nskhh/shbkh?)."; }
  tar -xzf "$tmp/k.tgz" -C "$tmp" || { rm -rf "$tmp"; die "baz kardan arshiv kcptun shekast khord."; }
  install -m755 "$tmp/${role}_linux_${arch}" "$bin" || { rm -rf "$tmp"; die "nasb bainri kcptun shekast khord."; }
  rm -rf "$tmp"
  log "kcptun-$role nasb shod: $bin"
}

# profile FEC ("datashard parityshard mode sndwnd rcvwnd") dar common.sh:kcp_profile ast —
# amdan inja copy NEMISHAVAD: parametr-haye FEC bayad DAR DO TARAF (Iran va node) daghighan
# yeksan bashand، pas bayad yek manba dashte bashand.

cmd_kcp(){
  need_root; need_bin jq; ensure_state
  local sub="${1:-status}"; shift || true
  case "$sub" in
    on)   cmd_kcp_on "$@" ;;
    off)  cmd_kcp_off ;;
    status) cmd_kcp_status ;;
    show) print_kcp_connect ;;
    *) die "estefade: ratholectl kcp <on [port] [profile]|off|status|show>  (profile: balanced|lossy|aggressive)" ;;
  esac
}

cmd_kcp_on(){
  local port="${1:-443}" profile="${2:-balanced}" ctrl key params ds ps mode sw rw
  echo "$port" | grep -qE '^[0-9]+$' || die "port bayad adad bashad."
  params="$(kcp_profile "$profile")" || die "profile namotabar: $profile (balanced|lossy|aggressive)"
  read -r ds ps mode sw rw <<<"$params"
  ctrl="$(s_get '.control_port')"; case "$ctrl" in ''|null) ctrl=2333 ;; esac
  # kelid mojood ra ngh dar, dar ghir ainsvrt bsaz
  key="$(jq -r '.kcp.key // empty' "$STATE" 2>/dev/null)"
  [ -n "$key" ] || key="$(gen_token)"
  install_kcptun server

  # Pre-snapshot state & unit for atomic transaction
  local pre_st_bak="" pre_unit_bak="" had_unit=0
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi
  if [ -f "$KCP_SRV_UNIT" ]; then
    had_unit=1
    pre_unit_bak="$(rth_mktemp)" || { [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak"; die "sakht snapshot-e unit shekast khord."; }
    if ! cp -a "$KCP_SRV_UNIT" "$pre_unit_bak"; then
      [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak"
      rm -f "$pre_unit_bak" 2>/dev/null || true
      die "copy snapshot-e unit shekast khord."
    fi
  fi

  _rollback_kcp_on(){
    local rb_failed=0
    if [ -n "$pre_st_bak" ] && [ -f "$pre_st_bak" ]; then
      cp -a "$pre_st_bak" "$STATE" || rb_failed=1
    fi
    if [ "$had_unit" -eq 1 ]; then
      if [ -n "$pre_unit_bak" ] && [ -f "$pre_unit_bak" ]; then
        cp -a "$pre_unit_bak" "$KCP_SRV_UNIT" || rb_failed=1
      else
        rb_failed=1
      fi
    else
      rm -f "$KCP_SRV_UNIT" 2>/dev/null || true
    fi
    systemctl daemon-reload 2>/dev/null || true
    rm -f "$pre_st_bak" "$pre_unit_bak" 2>/dev/null || true
    if [ "$rb_failed" -eq 1 ]; then
      err "HOSHDAR: rollback-e kcp ba khata movajeh shod."
      return 1
    fi
    log "kcp rollback shod (state va unit bazgardande shodand)."
    return 0
  }

  # zkhirh dar state
  if ! rth_state_tx --argjson p "$port" --arg k "$key" --argjson c "$ctrl" --arg prof "$profile" \
     --argjson ds "$ds" --argjson ps "$ps" --arg mode "$mode" --argjson sw "$sw" --argjson rw "$rw" \
     '.kcp = {enabled:true, port:$p, key:$k, target:("127.0.0.1:"+($c|tostring)),
              profile:$prof, mtu:1350, sndwnd:$sw, rcvwnd:$rw, datashard:$ds, parityshard:$ps, mode:$mode, crypt:"aes-128"}'; then
    _rollback_kcp_on
    die "sabt-e kcp dar state shekast khord."
  fi

  if ! gen_kcp_server_unit; then
    _rollback_kcp_on
    die "sakht-e unit-e kcp-server shekast khord."
  fi

  if ! systemctl daemon-reload 2>/dev/null; then
    _rollback_kcp_on
    die "daemon-reload baraye kcp-server shekast khord."
  fi

  if ! systemctl enable rathole-kcp-server >/dev/null 2>&1; then
    _rollback_kcp_on
    die "enable kardan-e rathole-kcp-server shekast khord."
  fi

  if ! systemctl restart rathole-kcp-server 2>/dev/null || ! systemctl is-active --quiet rathole-kcp-server; then
    _rollback_kcp_on
    die "rathole-kcp-server bala niamd ya restart shekast khord; amaliat rollback shod."
  fi

  rm -f "$pre_st_bak" "$pre_unit_bak" 2>/dev/null || true
  log "kcp-server rooye UDP :$port faal shod → 127.0.0.1:$ctrl (profile: $profile)."
  if [ "$port" = 443 ]; then
    log "estetar: UDP/443 baraye DPI shbih QUIC/HTTP3 didh mishavad (tdakhli ba nginx rooye TCP/443 nadarad)."
  fi
  warn "firewall: port UDP $port ra baz kon (masalan: ufw allow $port/udp , ya Security Group abri)."
  print_kcp_connect
}

gen_kcp_server_unit(){
  local k; k="$(jq -r '.kcp' "$STATE" 2>/dev/null)"
  local port target key mtu sw rw ds ps mode crypt
  port="$(echo "$k" | jq -r '.port // empty')";     target="$(echo "$k" | jq -r '.target // empty')"
  key="$(echo "$k" | jq -r '.key // empty')";       mtu="$(echo "$k" | jq -r '.mtu // empty')"
  sw="$(echo "$k" | jq -r '.sndwnd // empty')";     rw="$(echo "$k" | jq -r '.rcvwnd // empty')"
  ds="$(echo "$k" | jq -r '.datashard // empty')";  ps="$(echo "$k" | jq -r '.parityshard // empty')"
  mode="$(echo "$k" | jq -r '.mode // empty')";     crypt="$(echo "$k" | jq -r '.crypt // empty')"
  case "$key" in
    *$'\n'*|*$'\r'*|*[\;\|\&\`\$\<\>\(\)\'\"\\]*) err "kcp key namotabar ast"; return 1 ;;
  esac
  case "$target" in
    *$'\n'*|*$'\r'*|*[[:space:]]*|*[\;\|\&\`\$\<\>\(\)\'\"\\]*) err "kcp target namotabar ast"; return 1 ;;
  esac
  is_valid_port "$port" || { err "kcp port namotabar ast"; return 1; }
  local udir; udir="$(dirname "$KCP_SRV_UNIT")"
  mkdir -p "$udir" 2>/dev/null || true
  local tmp; tmp="$(rth_mktemp "$udir")" || { err "sakht-e file-e movaghat baraye unit shekast khord"; return 1; }
  chmod 0644 "$tmp" 2>/dev/null || true
  cat > "$tmp" <<UNIT
[Unit]
Description=rathole kcp-server (UDP+FEC entry -> rathole control)
After=network.target

[Service]
Type=simple
ExecStart=${KCP_SRV_BIN} -t ${target} -l :${port} -key ${key} -crypt ${crypt} -mode ${mode} -mtu ${mtu} -sndwnd ${sw} -rcvwnd ${rw} -datashard ${ds} -parityshard ${ps} -dscp 46 -nocomp
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
UNIT
  mv -f "$tmp" "$KCP_SRV_UNIT" || { rm -f "$tmp"; err "jaigozini-ye unit shekast khord"; return 1; }
  return 0
}

cmd_kcp_off(){
  # Pre-snapshot state & unit for atomic rollback
  local pre_st_bak="" pre_unit_bak="" had_unit=0
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi
  if [ -f "$KCP_SRV_UNIT" ]; then
    had_unit=1
    pre_unit_bak="$(rth_mktemp)" || { [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak"; die "sakht snapshot-e unit shekast khord."; }
    if ! cp -a "$KCP_SRV_UNIT" "$pre_unit_bak"; then
      [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak"
      rm -f "$pre_unit_bak" 2>/dev/null || true
      die "copy snapshot-e unit shekast khord."
    fi
  fi

  _rollback_kcp_off(){
    local rb_failed=0
    if [ -n "$pre_st_bak" ] && [ -f "$pre_st_bak" ]; then
      cp -a "$pre_st_bak" "$STATE" || rb_failed=1
    fi
    if [ "$had_unit" -eq 1 ]; then
      if [ -n "$pre_unit_bak" ] && [ -f "$pre_unit_bak" ]; then
        cp -a "$pre_unit_bak" "$KCP_SRV_UNIT" || rb_failed=1
      else
        rb_failed=1
      fi
      systemctl daemon-reload 2>/dev/null || true
      systemctl enable rathole-kcp-server 2>/dev/null || true
      systemctl restart rathole-kcp-server 2>/dev/null || true
    fi
    rm -f "$pre_st_bak" "$pre_unit_bak" 2>/dev/null || true
    if [ "$rb_failed" -eq 1 ]; then
      err "HOSHDAR: rollback-e kcp off ba khata movajeh shod."
      return 1
    fi
    log "kcp off rollback shod (state va unit bazgardande shodand)."
    return 0
  }

  if ! systemctl disable --now rathole-kcp-server 2>/dev/null; then
    _rollback_kcp_off
    die "disable kardan-e rathole-kcp-server shekast khord."
  fi
  if systemctl is-active --quiet rathole-kcp-server; then
    _rollback_kcp_off
    die "rathole-kcp-server pas az disable --now hamchenan active ast؛ amaliat rollback shod."
  fi
  rm -f "$KCP_SRV_UNIT"
  if ! systemctl daemon-reload 2>/dev/null; then
    _rollback_kcp_off
    die "daemon-reload pas az hazf unit shekast khord."
  fi
  if ! rth_state_tx '(.kcp.enabled) = false'; then
    _rollback_kcp_off
    die "khamoosh kardan-e kcp dar state shekast khord."
  fi
  rm -f "$pre_st_bak" "$pre_unit_bak" 2>/dev/null || true
  log "kcp-server khamoosh shod. tunnelha az haman masir websocket/443 kar mikonand."
}

cmd_kcp_status(){
  local en; en="$(jq -r '.kcp.enabled // false' "$STATE" 2>/dev/null)"
  if [ "$en" != true ]; then echo "kcp: $(c_y 'khamoosh') (tunnel fali rooye websocket/443)"; return; fi
  local port prof; port="$(jq -r '.kcp.port' "$STATE")"; prof="$(jq -r '.kcp.profile // "balanced"' "$STATE")"
  echo "kcp: $(c_g 'roshan')  UDP :$port → 127.0.0.1:$(s_get '.control_port')  (profile: $prof)"
  [ "$port" = 443 ] && echo "  estetar: UDP/443 ~ QUIC/HTTP3"
  systemctl is-active --quiet rathole-kcp-server && echo "  service: $(c_g 'active')" || echo "  service: $(c_r 'inactive')"
  command -v ss >/dev/null 2>&1 && { ss -lunH "sport = :$port" 2>/dev/null | grep -q . && echo "  gvshdadn UDP:$port: $(c_g 'blh')" || echo "  gvshdadn UDP:$port: $(c_r 'khir')"; }
}

print_kcp_connect(){
  local en; en="$(jq -r '.kcp.enabled // false' "$STATE" 2>/dev/null)"
  [ "$en" = true ] || { warn "kcp khamoosh ast; aval: ratholectl kcp on [port] [profile]"; return; }
  local ip port key prof
  ip="$(detect_ip)"
  port="$(jq -r '.kcp.port' "$STATE")"; key="$(jq -r '.kcp.key' "$STATE")"; prof="$(jq -r '.kcp.profile // "balanced"' "$STATE")"
  echo
  echo "$(c_y '──────── faalsazi kcp rooye node kharej ────────')"
  echo "rooye node in ra bezan (masir tunnel az 443 be UDP+FEC switch mishavad):"
  echo "  ratholenode kcp on ${ip:-<IRAN_IP>}:${port} ${key} ${prof}"
  echo
  echo "bazgsht be halat ghabli (websocket/443):  ratholenode kcp off"
  echo "$(c_y '────────────────────────────────────────────')"
  echo "nokte: serviceha/tokenha/path karbaran tghiiri nmiknnd; fght masir hml tunnel avz mishavad."
}

