#!/usr/bin/env bash
# ratholectl — mdirit nvdhai tunnel rathole + tvlid khodkar server.toml va config nginx
# rooye server Iran ejra mishavad.
# nokte: amdan az `set -e` estefade nmiknim chvn algvi `jq | while read` ba pipefail kd
# khorooji ghirsfr midahad va ba -e askript ra vst tvlid config mibndd. khtaha sarih ba die mdirit mishavand.
set -uo pipefail

# common.sh agar knar file bashd, tavabe eshteraki ra lvd kon
# baad az nasb: script dar /usr/local/bin vali common.sh dar /usr/local/share/rathole ast
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || echo "$PWD")"
if [ "$SCRIPT_DIR" != "/usr/local/bin" ] && [ -f "$SCRIPT_DIR/common.sh" ]; then
  source "$SCRIPT_DIR/common.sh"
elif [ -f /usr/local/share/rathole/common.sh ]; then
  source /usr/local/share/rathole/common.sh
elif [ -f "$SCRIPT_DIR/common.sh" ]; then
  source "$SCRIPT_DIR/common.sh"
fi

# amniat-e sarasari: umask 077
umask 077

STATE="/etc/rathole-manager/state.json"
SERVER_TOML="/etc/rathole/server.toml"
NOISE_TOML="/etc/rathole/noise-server.toml"
NGINX_MAIN_CONF="${NGINX_MAIN_CONF:-/etc/nginx/nginx.conf}"
NGINX_CONF="/etc/nginx/conf.d/rathole.conf"
STREAM_CONF="/etc/nginx/stream.d/rathole-stream.conf"
RATHOLE_SVC="rathole-server"
NOISE_SVC="rathole-noise"
NOISE_PATTERN_DEFAULT="Noise_NK_25519_ChaChaPoly_BLAKE2s"
BH_TOML="/etc/rathole/backhaul-server.toml"
BH_SVC="rathole-backhaul-server"
BH_UNIT="/etc/systemd/system/${BH_SVC}.service"

# Temp-ha ba permission 0600 dar haman filesystem-e maghsad sakhte mishavand
rth_mktemp(){
  local dir="${1:-}"
  if [ -n "$dir" ]; then
    [ -d "$dir" ] || return 1
  else
    dir="$(dirname "$STATE" 2>/dev/null || echo "")"
    [ -n "$dir" ] && [ -d "$dir" ] || dir="/tmp"
  fi
  local tmp
  tmp="$(mktemp "$dir/rth.tmp.XXXXXX")" || return 1
  chmod 600 "$tmp" 2>/dev/null || true
  printf '%s\n' "$tmp"
}
rth_mktempd(){
  local dir="${1:-}"
  if [ -n "$dir" ]; then
    [ -d "$dir" ] || return 1
  else
    dir="/tmp"
  fi
  local tmpd
  tmpd="$(mktemp -d "$dir/rthd.tmp.XXXXXX")" || return 1
  chmod 700 "$tmpd" 2>/dev/null || true
  printf '%s\n' "$tmpd"
}

# Transactional state mutator (jelogiri az corruption / partial write / lost update)
rth_state_tx(){
  local sdir; sdir="$(dirname "$STATE")"
  if [ -L "$sdir" ]; then
    err "directory-e state yek symlink ast: $sdir (fail-closed)."
    return 1
  fi
  if ! mkdir -p "$sdir" 2>/dev/null && [ ! -d "$sdir" ]; then
    err "nemitoonam directory-e state ra besazam: $sdir (fail-closed)."
    return 1
  fi
  chmod 700 "$sdir" 2>/dev/null || true
  if [ -L "$STATE" ]; then
    err "file-e state yek symlink ast: $STATE (fail-closed)."
    return 1
  fi
  local tmp; tmp="$(rth_mktemp "$sdir")" || { err "sakht-e file-e movaghat baraye state shekast khord."; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true
  if ! jq "$@" "$STATE" > "$tmp"; then
    rm -f "$tmp"
    err "amaliat-e jq rooye state shekast khord؛ state dast-nakhorde mand."
    return 1
  fi
  if [ ! -s "$tmp" ] || ! jq empty "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    err "khorooji-e jq JSON-e motabar nist؛ state dast-nakhorde mand."
    return 1
  fi
  if ! jq -e '
    type == "object"
    and (.nodes | type == "array")
    and all(.nodes[]; type == "object" and (.name | type == "string" and length > 0) and (.token | type == "string" and length > 0))
    and ((.domain == null) or (.domain | type == "string"))
    and ((.domains == null) or (.domains | type == "array"))
    and ((.extra_domains == null) or (.extra_domains | type == "array"))
    and ((.control_port == null) or (.control_port | type == "number"))
  ' "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    err "khorooji-e jq schema-ye motabar-e state ra nadarad؛ state dast-nakhorde mand."
    return 1
  fi
  if ! mv -f "$tmp" "$STATE"; then
    rm -f "$tmp"
    err "jaigozini-ye state shekast khord."
    return 1
  fi
  chmod 600 "$STATE" 2>/dev/null || true
  return 0
}

# TAVAJOH: c_g/c_r/c_y/log/warn/err/die/need_root/kcp_profile inja DOBARE tarif NEMISHAVAND —
# tanha manba-eshan common.sh ast (bala source shod). ghablan har se file copy-e yeksan dashtand
# va chon source ghabl az tarif bood, copy-e CLI barande mishod: yani virayesh-e common.sh
# BI-ASAR bood. baraye kcp_profile in fajee ast — profile bayad DO taraf yeksan bashad.
# common.sh EJBARI ast (rth_commit_config / install_backhaul / backhaul_mux_profile / ... faghat
# anja hastand), pas agar load nashode bashad hamin ja ba payam-e roshan mimirim.
if ! declare -F rth_commit_config >/dev/null 2>&1 || ! declare -F rth_read >/dev/null 2>&1; then
  printf '[!] common.sh load nashod ya ghadimi ast (/usr/local/share/rathole/common.sh). nasb ra tekrar kon.\n' >&2
  exit 1
fi
# rth_read / has_tty / ask_yn dar common.sh hastand (inja copy NEMISHAVAND).
# noskhe-ye ghadimi-ye inja ba `[ -r /dev/tty ]` tashkhis midad ke DOROGH ast va baes-e
# hang-e bi-payam-e nasb mishod — bebin tozih-e kamel dar common.sh.

# need_root dar common.sh ast (inja copy nemishavad — bebin tozih-e bala).
need_bin(){ command -v "$1" >/dev/null 2>&1 || die "niaz be '$1' ast; aval install-panel.sh ra ejra kon."; }

# ---------- tashkhis-e IP-e omomi-ye server (ba timeout-e kootah) ----------
# MOHEM: rooye Iran api.ipify aksaran filter ast; bedoon --max-time curl ~2 daghighe hang
# mishavad va SSH-e hub (masalan "plain show"/"direct show") timeout midahad. hamishe local-IP
# fallback darim ta print_*_connect faran bargardad. RATHOLE_PUBLIC_IP override-e dasti ast.
detect_ip(){
  if [ -n "${RATHOLE_PUBLIC_IP:-}" ]; then printf '%s' "$RATHOLE_PUBLIC_IP"; return; fi
  local ip=""
  if command -v curl >/dev/null 2>&1; then
    ip="$(curl -fsS4 --connect-timeout 2 --max-time 3 https://api.ipify.org 2>/dev/null)"
  fi
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  printf '%s' "$ip"
}

ensure_state(){
  [ -f "$STATE" ] || die "hnvz init nashode. aval ejra kon: ratholectl init"
}

gen_token(){ openssl rand -hex 16; }

# masir-e makhfi WebSocket baraye kontroli — ba /_rh/<32 hex> tashkil mishavad.
# ba source-e hash az state; agar vojood nadarad yek noskhe jadid miavrad va save mikonad.
ensure_control_path(){
  local p
  p="$(jq -r '.control_path // empty' "$STATE" 2>/dev/null)"
  if [ -z "$p" ]; then
    p="/_rh/$(openssl rand -hex 16)"
    state_set '.control_path' "$p" str
  fi
  printf '%s\n' "$p"
}

# ---------- masir-haye qabl-e tanzim (sub / hub) ----------
# elaghi: 'sub' ya '/sub' ya '/sub/' → tkrar-shavande 'sub' (bedoon slash). pishfarz: moge'e pishvand.
normalize_path_seg(){
  local seg="${1#/}"; seg="${seg%/}"
  echo "$seg" | grep -qE '^[A-Za-z0-9_-]{1,40}$' || die "masir '$1' namotabar ast (faghat harf/adad/_/-, bedoon slash)."
  printf '%s\n' "$seg"
}
# sub_path/hub_path ra az state mikhanad; pishfarz 'sub'/'hub'
sub_path_seg(){  local p; p="$(jq -r '.sub_path // "sub"'  "$STATE" 2>/dev/null)"; case "$p" in ''|null) p=sub ;; esac; printf '%s\n' "$p"; }
hub_path_seg(){  local p; p="$(jq -r '.hub_path // "hub"'  "$STATE" 2>/dev/null)"; case "$p" in ''|null) p=hub ;; esac; printf '%s\n' "$p"; }

# ---------- tvlid keypair-e noise (X25519) baraye transport-e ramznegari-shode ----------
# rathole --genkey do khat mide: "Private Key:" va "Public Key:" (base64). faghat agar hanooz set nashode.
# NOTE: format-e daghigh-e khoruji-ye 'rathole --genkey' bayad ba binary-ye vaghei tayid shavad;
#       parse be sorat-e defensive: aval do khat-e base64-e pas az barchasb, dar ghir-e-in-surat har do khat-e base64.
noise_genkey(){
  local have_priv have_pub
  have_priv="$(jq -r '.noise_privkey // empty' "$STATE" 2>/dev/null)"
  have_pub="$(jq -r '.noise_pubkey // empty' "$STATE" 2>/dev/null)"
  [ -n "$have_priv" ] && [ -n "$have_pub" ] && return 0   # az ghabl vojood darad
  command -v rathole >/dev/null 2>&1 || die "binary-e 'rathole' peyda nashod; nemitavan keypair-e noise sakht."
  local out priv pub
  out="$(rathole --genkey 2>/dev/null)" || die "'rathole --genkey' shekast khord."
  # tarjih: khatt-e baʔd az 'Private Key'/'Public Key'; fallback: avval/dovom khatt-e base64-mannad.
  priv="$(echo "$out" | grep -iA1 'private' | grep -vi 'private' | tr -d '[:space:]' | head -n1)"
  pub="$(echo "$out"  | grep -iA1 'public'  | grep -vi 'public'  | tr -d '[:space:]' | head -n1)"
  if [ -z "$priv" ] || [ -z "$pub" ]; then
    # fallback: hame khatt-haye base64-mannad ra bardar (avval=priv, dovom=pub)
    local lines; lines="$(echo "$out" | grep -oE '[A-Za-z0-9+/]{40,}={0,2}')"
    priv="$(echo "$lines" | sed -n '1p')"; pub="$(echo "$lines" | sed -n '2p')"
  fi
  [ -n "$priv" ] && [ -n "$pub" ] || die "natvanestam keypair-e noise ra az khoruji-ye rathole --genkey parse konam."
  state_set '.noise_privkey' "$priv"
  state_set '.noise_pubkey'  "$pub"
  log "keypair-e noise tvlid shod (kelid-e omomi montasher mishavad, khsvsi rooye Iran mimanad)."
}

# ---------- grftn gvahi Let's Encrypt (standalone) ----------
obtain_cert(){ # $1=domain ; khorooji: masir gvahi dar /etc/letsencrypt
  local domain="$1" email
  command -v certbot >/dev/null 2>&1 || { err "certbot nasb nist."; return 1; }
  rth_read email "aimil baraye Let's Encrypt (khali = bedoon aimil): "
  warn "baraye grftn gvahi, nginx mvghtaan motevaghef mishavad (niaz be port 80 azad va DNS dorost $domain)."
  local was_active=0
  systemctl is-active --quiet nginx && { was_active=1; systemctl stop nginx; }
  local cargs=(certonly --standalone --non-interactive --agree-tos -d "$domain")
  if [ -n "$email" ]; then cargs+=(-m "$email"); else cargs+=(--register-unsafely-without-email); fi
  # MOHEM: certbot mahdudiat-e zamani-ye motmaen nadarad va az dakhel-e Iran (ACME-e
  # Let's Encrypt aksaran filtr/kond ast) mitavanad SAAT-HA bemanad — an ham daghighan vaghti
  # nginx ra khamoosh karde-im. pas hatman bounded ejrash mikonim.
  local cbt="${RATHOLE_CERTBOT_TIMEOUT:-300}" cb=(certbot)
  command -v timeout >/dev/null 2>&1 && cb=(timeout "$cbt" certbot)
  if "${cb[@]}" "${cargs[@]}"; then
    log "gvahi grfth shod: /etc/letsencrypt/live/$domain/"
    [ "$was_active" -eq 1 ] && systemctl start nginx || true
    return 0
  else
    err "grftn gvahi shekast khord (DNS? port 80 bsth? filtr?)."
    [ "$was_active" -eq 1 ] && systemctl start nginx || true
    return 1
  fi
}

# ---------- khvandn tanzimat az state ----------
s_get(){ jq -r "$1" "$STATE"; }

# ---------- backup va restore ----------
cmd_backup(){
  need_root; ensure_state
  local out="${1:-/root/rathole-panel-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
  tar -czf "$out" -C / "${STATE#/}" 2>/dev/null || die "sakht backup shekast khord."
  log "backup sakhte shod: $out"
  echo "shaml state.json (damnh, pvrtha, nvdha, tvknha, SNI). az rooye an hmhchiz baztolid mishavad."
  warn "gvahiha va filehaye nginx dar in backup nistnd (jda mdirit mishavand)."
}

cmd_restore(){
  need_root; need_bin jq
  local f="${1:-}"
  [ -n "$f" ] && [ -f "$f" ] || die "file backup peyda nashod: $f"
  local tmp; tmp="$(rth_mktempd)"
  tar -xzf "$f" -C "$tmp" 2>/dev/null || die "baz kardan backup shekast khord (frmt?)."
  local st; st="$(find "$tmp" -name state.json -print -quit 2>/dev/null)"
  [ -n "$st" ] || die "state.json dar backup nist."
  jq -e . "$st" >/dev/null 2>&1 || die "state.json namotabar ast."
  local pre_st_bak=""
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi
  mkdir -p "$(dirname "$STATE")"
  cp -f "$st" "$STATE"
  rm -rf "$tmp"
  log "state restore shod az: $f (damnh: $(s_get '.domain') , nodeha: $(jq '.nodes|length' "$STATE"))"
  if ! regenerate "$pre_st_bak"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "restore shekast khord va be state/config-e ghabli rollback shod."
  fi
  [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
  systemctl enable --now "$RATHOLE_SVC" 2>/dev/null || true
  log "restore kamel shod. nodeha ba haman tokenha bedoon taghir dvbarh vsl mishavand."
  warn "motmaen shv gvahiha dar masir dakhl state mvjvdnd (dar ghir ainsvrt dvbarh begir)."
}

# ---------- dstvr init ----------
cmd_init(){
  need_root; need_bin jq
  local domain="" cert_fc="" cert_key="" ctrl="" fake="" sub="" dstart="" astart="" nconf="" interactive=1 use_certbot=0 restore_file="" force_init=0
  # halat flgmhvr (non-interactive) — agar har flgi dade shvd, taamoli nist
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain)        domain="$2"; interactive=0; shift 2;;
      --fullchain)     cert_fc="$2"; shift 2;;
      --key)           cert_key="$2"; shift 2;;
      --control-port)  ctrl="$2"; shift 2;;
      --fake-port)     fake="$2"; shift 2;;
      --sub-port)      sub="$2"; shift 2;;
      --data-start)    dstart="$2"; shift 2;;
      --api-start)     astart="$2"; shift 2;;
      --nginx-conf)    nconf="$2"; shift 2;;
      --restore)       restore_file="$2"; shift 2;;
      --certbot)       use_certbot=1; shift;;
      --fresh|--force) force_init=1; shift;;
      *) shift;;
    esac
  done

  # jologiri az hazf ya truncate-e bi-sedaye state-e mojood
  if [ -s "$STATE" ] && [ "$force_init" -ne 1 ]; then
    die "state az ghabl vojood darad ($STATE). baraye bazneveshtan az --fresh ya --force estefade konid."
  fi

  # halat restore: agar file backup dade shode ya (taamoli) karbar masir dad
  if [ "$interactive" -eq 1 ] && [ -z "$restore_file" ]; then
    rth_read restore_file "adres file backup baraye restore (khali = nasb tazh): "
  fi
  if [ -n "$restore_file" ]; then
    cmd_restore "$restore_file"
    return
  fi

  # agar taamoli ast vali hich tty nist (curl|bash bedoon-e --domain), natavan porsid → rahnama
  if [ "$interactive" -eq 1 ] && ! has_tty; then
    err "domain dade nashode va terminal baraye porsesh dar dastres nist."
    err "ba flag ejra kon, masalan:"
    err "   sudo ratholectl init --domain <d> --fullchain <fc> --key <key>"
    err "ya nasb ra ba install-panel.sh hamrah-e hamin flag-ha bede."
    die "init bedoon-e domain momken nist."
  fi

  if [ "$interactive" -eq 1 ]; then
    rth_read domain "damnh (masalan btli.ir): "
    [ -n "$domain" ] || die "damnh alzami ast."
    rth_read cert_fc "masir fullchain.pem [/root/cert/${domain}/fullchain.pem]: "
    rth_read cert_key "masir privkey.pem [/root/cert/${domain}/privkey.pem]: "
    rth_read nconf "file config nginx baraye tvlid/riplis [/etc/nginx/conf.d/rathole.conf]: "
    rth_read ctrl "port kontroli lvkal rathole [2333]: "
    rth_read fake "port sait fik/panel (default) [8080]: "
    rth_read sub "port sabaskripshn [2096]: "
    rth_read dstart "shrva shmarh port dita [1001]: "
    rth_read astart "shrva shmarh port mdirit(api) [7001]: "
  fi

  # pishfrzha
  [ -n "$domain" ] || die "damnh lazem ast (--domain ...)."
  cert_fc="${cert_fc:-/root/cert/${domain}/fullchain.pem}"
  cert_key="${cert_key:-/root/cert/${domain}/privkey.pem}"
  nconf="${nconf:-$NGINX_CONF}"
  ctrl="${ctrl:-2333}"; fake="${fake:-8080}"; sub="${sub:-2096}"
  dstart="${dstart:-1001}"; astart="${astart:-7001}"

  # etebarsanji port-ha
  is_valid_port "$ctrl"   || die "control-port bayad adad beyn 1 ta 65535 bashad: '$ctrl'"
  is_valid_port "$fake"   || die "fake-port bayad adad beyn 1 ta 65535 bashad: '$fake'"
  is_valid_port "$sub"    || die "sub-port bayad adad beyn 1 ta 65535 bashad: '$sub'"
  is_valid_port "$dstart" || die "data-start bayad adad beyn 1 ta 65535 bashad: '$dstart'"
  is_valid_port "$astart" || die "api-start bayad adad beyn 1 ta 65535 bashad: '$astart'"

  # gvahi: chvn maamoolan az ghabl dari, certbot fght dar soorat drkhvast sarih ya entekhab dar halat taamoli
  if [ ! -f "$cert_fc" ] || [ ! -f "$cert_key" ]; then
    warn "gvahi dar masir dadhshdh peyda nashod: $cert_fc"
    if [ "$use_certbot" -eq 1 ] || { [ "$interactive" -eq 1 ] && ask_yn "ba certbot grfth shvd?"; }; then
      if obtain_cert "$domain"; then
        cert_fc="/etc/letsencrypt/live/${domain}/fullchain.pem"
        cert_key="/etc/letsencrypt/live/${domain}/privkey.pem"
      else
        warn "bedoon gvahi adamh midhim; ta ghabl az vojood gvahi nginx bala nmiaid."
      fi
    else
      warn "az gvahi mojood estefade mishvd; motmaen shv masir dorost ast."
    fi
  else
    log "gvahi mojood estefade mishavad: $cert_fc"
  fi

  local sdir stmp
  sdir="$(dirname "$STATE")"
  mkdir -p "$sdir"
  chmod 700 "$sdir" 2>/dev/null || true
  stmp="$(rth_mktemp "$sdir")" || die "sakht-e file-e movaghat baraye state shekast khord."
  chmod 600 "$stmp" 2>/dev/null || true

  # agar state mojood bood va force bood, backup begir
  if [ -s "$STATE" ]; then
    cp -f "$STATE" "$sdir/state.json.bak.$$" 2>/dev/null || true
    chmod 600 "$sdir/state.json.bak.$$" 2>/dev/null || true
  fi

  if ! jq -n \
    --arg d "$domain" --arg fc "$cert_fc" --arg key "$cert_key" --arg nc "$nconf" \
    --argjson ctrl "$ctrl" --argjson fake "$fake" --argjson sub "$sub" \
    --argjson ds "$dstart" --argjson apst "$astart" \
    '{domain:$d, cert_fullchain:$fc, cert_key:$key, nginx_conf:$nc, control_port:$ctrl,
      fake_port:$fake, sub_port:$sub, data_port_start:$ds, api_port_start:$apst, nodes:[]}' \
    > "$stmp"; then
    rm -f "$stmp"
    die "sakht-e state ba jq shekast khord؛ state-e ghabli dast-nakhorde mand."
  fi

  if [ ! -s "$stmp" ] || ! jq empty "$stmp" 2>/dev/null; then
    rm -f "$stmp"
    die "state-e sakhte-shode JSON-e motabar nist؛ state-e ghabli dast-nakhorde mand."
  fi

  mv -f "$stmp" "$STATE" || { rm -f "$stmp"; die "jaigozini-ye state shekast khord."; }
  chmod 600 "$STATE" 2>/dev/null || true

  # masir-e makhfi control WebSocket ra dar state bayaz mikonim (state_set zir set -uo darad)
  ensure_control_path > /dev/null
  log "state sakhte shod: $STATE (nginx → $nconf)"
  regenerate
  log "init kamel shod."
}

# ---------- tkhsis port azad ----------
next_port(){ # $1=field (port|api_local_port) $2=start
  local field="$1" start="$2" used p
  # HAME-ye port-haye rezerv ra dar nazar begir (na faghat yek field) ta do bind_addr-e
  # yeksan (mesl data-port == api-port ya == control/fake/sub/...) sakhte nashavad.
  used="$(jq -r '
    ([.nodes[].port // empty]
     + [.nodes[].api_local_port // empty]
     + [.control_port, .fake_port, .sub_port, .internal_port, .plain_port, .hub_port, .noise_port, .direct_port, .backhaul_port]
    ) | map(select(. != null)) | @tsv' "$STATE")"
  p="$start"
  while echo "$used" | tr '\t' '\n' | grep -qx "$p"; do p=$((p+1)); done
  echo "$p"
}

# ---------- dstvr add ----------
# nam-haye rezerv-shode ke ba entry-haye sabet-e map-e nginx tadakhol darand
# (masalan 'sub' ke '~^/<sub_path>/' ra shadow mikonad). in-ha nabayad name-e node bashand.
# hub/channel/tunnel ham rezerv hastand: hub masir-e panel (pishfarz hub amma qabl-e taghir
# ba `set hub-path`) va channel/tunnel masir-haye sabet-e backhaul ke mitoavan shadow shavand.
is_reserved_name(){
  local n="$1" sp hp
  sp="$(sub_path_seg)"; hp="$(hub_path_seg)"
  case "$n" in default|hub|channel|tunnel|"$sp"|"$hp") return 0 ;; *) return 1 ;; esac
}

cmd_add(){
  need_root; need_bin jq; ensure_state
  local name="" inbound="" api_port=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --api-port|-a)
        shift
        api_port="${1:-}"
        ;;
      --api-port=*)
        api_port="${1#*=}"
        ;;
      *)
        if [ -z "$name" ]; then
          name="$1"
        elif [ -z "$inbound" ]; then
          inbound="$1"
        elif [ -z "$api_port" ]; then
          api_port="$1"
        fi
        ;;
    esac
    shift || true
  done
  [ -n "$name" ] && [ -n "$inbound" ] || die "estefade: ratholectl add <name> <inbound_port> [--api-port <port>]"
  echo "$name" | grep -qE '^[a-zA-Z0-9_-]+$' || die "name fght hrvf/adad/khttirh mjaz ast."
  is_reserved_name "$name" && die "name '$name' rezerv shode (ba masir-e sabet-e nginx tadakhol darad); name-e digari entekhab kon."
  is_valid_port "$inbound" || die "inbound bayad adad beyn 1 ta 65535 bashad: '$inbound'"
  [ -n "$api_port" ] && { is_valid_port "$api_port" || die "port api bayad adad beyn 1 ta 65535 bashad: '$api_port'"; }
  if jq -e --arg n "$name" '.nodes[]|select(.name==$n)' "$STATE" >/dev/null; then
    die "node '$name' az ghabl vojood darad."
  fi
  # node va reverse-proxy HAR DO dar map-e /<name> mineshinand — esm-e tekrari yani
  # do location-e mote'arez dar nginx. pas har do jahat check mishavad.
  if jq -e --arg n "$name" '(.proxies // [])[]|select(.name==$n)' "$STATE" >/dev/null 2>&1; then
    die "esm '$name' baraye yek reverse-proxy estefade shode ast (ratholectl proxy ls)."
  fi

  local dstart astart dport aport token atoken
  dstart="$(s_get '.data_port_start')"
  astart="$(s_get '.api_port_start')"
  dport="$(next_port port "$dstart")"
  token="$(gen_token)"

  local node_json
  node_json="$(jq -n --arg n "$name" --argjson p "$dport" \
                     --argjson ib "$inbound" --arg t "$token" \
                     '{name:$n, port:$p, inbound_port:$ib, token:$t}')"

  # port mdirit ekhtiari
  if [ -n "$api_port" ]; then
    aport="$(next_port api_local_port "$astart")"
    atoken="$(gen_token)"
    node_json="$(echo "$node_json" | jq --argjson ap "$aport" --argjson aib "$api_port" --arg at "$atoken" \
                  '. + {api_local_port:$ap, api_inbound_port:$aib, api_token:$at}')"
  fi

  # faghat agar neveshtan-e state movafagh bood, success log/regenerate anjam shavad.
  local pre_st_bak=""
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi

  if ! rth_state_tx --argjson node "$node_json" '.nodes += [$node]'; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "sabt-e node dar state shekast khord."
  fi
  if ! regenerate "$pre_st_bak"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "afzoodan-e node shekast khord va rollback shod."
  fi
  [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
  log "node '$name' ezafe shod (path=/$name → 127.0.0.1:$dport)."
  print_node_install "$name"
}

# ---------- dstvr rm ----------
cmd_rm(){
  need_root; need_bin jq; ensure_state
  local name="${1:-}"
  [ -n "$name" ] || die "estefade: ratholectl rm <name>"
  jq -e --arg n "$name" '.nodes[]|select(.name==$n)' "$STATE" >/dev/null || die "node '$name' peyda nashod."
  local pre_st_bak=""
  if [ -f "$STATE" ]; then
    pre_st_bak="$(rth_mktemp)" || die "sakht snapshot-e state shekast khord."
    if ! cp -a "$STATE" "$pre_st_bak"; then
      rm -f "$pre_st_bak" 2>/dev/null || true
      die "copy snapshot-e state shekast khord."
    fi
  fi

  if ! rth_state_tx --arg n "$name" '.nodes |= map(select(.name!=$n))'; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "hazf-e node az state shekast khord."
  fi
  if ! regenerate "$pre_st_bak"; then
    [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
    die "hazf-e node shekast khord va rollback shod."
  fi
  [ -n "$pre_st_bak" ] && rm -f "$pre_st_bak" 2>/dev/null || true
  log "node '$name' hazf shod."
}

# ---------- dstvr ls ----------
cmd_ls(){
  need_bin jq; ensure_state
  local domain; domain="$(s_get '.domain')"
  # TRANSPORT/SNI-e har node ra ham chap mikonim ta hub betavanad mode-e daghigh-e har
  # node ra neshan dahad (transport-e khali = ws-e pishfarz). ja-negahdar '-' ta split-e
  # movghiati (parse_iran_ls) salem bemanad — USER PATH akhar ast va space nadarad.
  printf '%-14s %-8s %-12s %-10s %-10s %-16s %s\n' "NAME" "PORT" "INBOUND" "API" "TRANSPORT" "SNI" "USER PATH"
  printf '%s\n' "--------------------------------------------------------------------------------"
  jq -r '.nodes[] | [.name, (.port|tostring), (.inbound_port|tostring),
          ((.api_local_port // "-")|tostring),
          ((.transport // "ws")|tostring),
          ((.sni // "-")|tostring)] | @tsv' "$STATE" |
  while IFS=$'\t' read -r n p ib ap tr sni; do
    printf '%-14s %-8s %-12s %-10s %-10s %-16s %s\n' "$n" "$p" "$ib" "$ap" "$tr" "$sni" "https://$domain/$n"
  done
}

# ---------- tvlid server.toml ----------
gen_server_toml(){
  local ctrl; ctrl="$(s_get '.control_port')"
  case "$ctrl" in ''|null) ctrl=2333 ;; esac
  {
    echo "# tvlid khodkar tvst ratholectl — dasti virayesh nakon"
    echo "[server]"
    echo "bind_addr = \"127.0.0.1:${ctrl}\""
    echo "heartbeat_interval = 30"
    echo
    echo "[server.transport]"
    echo "type = \"websocket\""
    echo "[server.transport.websocket]"
    echo "tls = false"
    echo
    # rathole v0.5.0 field-e 'services' ra ALZAMI midanad; agar hich node/service nabashad,
    # bayad yek table-e khali [server.services] bedahim vagarna: "missing field services".
    local svc_count
    svc_count="$(jq '[.nodes[] | select((.transport // "") != "noise" and (.transport // "") != "backhaul")] | length' "$STATE" 2>/dev/null)"
    if [ "${svc_count:-0}" -eq 0 ]; then
      echo "[server.services]"
      echo
    fi
    jq -r '.nodes[] | @base64' "$STATE" | while read -r row; do
      row="${row%$'\r'}"
      [ -n "$row" ] || continue
      _j(){ echo "$row" | base64 -d | jq -r "$1"; }
      local name port token aport atoken
      name="$(_j '.name')"; port="$(_j '.port')"; token="$(_j '.token')"
      # node-haye noise/backhaul service-eshan tooye toml-e khodeshan mirvad (na inja) —
      # vagarna do prose yek bind_addr (127.0.0.1:port) ra bind mikonand va dovomi bala nemiayad.
      case "$(_j '.transport // empty')" in noise|backhaul) continue ;; esac
      echo "[server.services.${name}]"
      echo "token = \"${token}\""
      echo "bind_addr = \"127.0.0.1:${port}\""
      echo "type = \"tcp\""
      echo
      aport="$(_j '.api_local_port // empty')"
      if [ -n "$aport" ]; then
        atoken="$(_j '.api_token')"
        echo "[server.services.${name}_api]"
        echo "token = \"${atoken}\""
        echo "bind_addr = \"127.0.0.1:${aport}\""
        echo "type = \"tcp\""
        echo
      fi
    done
  } > "$SERVER_TOML.tmp"
  rth_commit_config "$SERVER_TOML.tmp" "$SERVER_TOML"
}

