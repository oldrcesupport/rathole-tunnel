    echo "}"
    echo "server {"
    echo "    listen 443;"
    echo "    ssl_preread on;"
    echo "    proxy_pass \$rh_stream_backend;"
    echo "    proxy_timeout 1h;"
    echo "    proxy_connect_timeout 3s;"
    echo "    tcp_nodelay on;"
    echo "    proxy_socket_keepalive on;"
    echo "}"
